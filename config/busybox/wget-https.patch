+#if SSL_SUPPORTED
+static int host_has_port(const char *host)
+{
+	if (host[0] == '[') {
+		host = strchr(host, ']');
+		return host && host[1] == ':';
+	}
+	return strchr(host, ':') != NULL;
+}
+
+static char *bare_hostname(const char *host)
+{
+	char *name = xstrdup(host);
+	char *p;
+
+	if (host_has_port(host))
+		strrchr(name, ':')[0] = '\0';
+	if (name[0] == '[') {
+		p = strchr(name, ']');
+		if (p)
+			*p = '\0';
+		memmove(name, name + 1, strlen(name));
+	}
+	return name;
+}
+#endif
