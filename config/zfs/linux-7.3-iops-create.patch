+	],[])
 ])

 AC_DEFUN([ZFS_AC_KERNEL_CREATE], [
+	AC_MSG_CHECKING([whether iops->create() drops the flag arg])
+	ZFS_LINUX_TEST_RESULT([create_mnt_idmap_no_flag], [
+		AC_MSG_RESULT(yes)
+		AC_DEFINE(HAVE_IOPS_CREATE_IDMAP, 1,
