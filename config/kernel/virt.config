# "virt" flavor: monolithic, module-free kernel for VMs, microVMs
# (Firecracker / cloud-hypervisor / QEMU microvm), cloud and CI sandboxes.
# No modules => no initramfs needed, no modprobe at boot, smaller attack
# surface. Root is mounted directly by the kernel.
CONFIG_MODULES=n
CONFIG_VT=n
CONFIG_INPUT=n
CONFIG_SERIO=n
CONFIG_SOUND=n
CONFIG_USB_SUPPORT=n
CONFIG_WLAN=n
CONFIG_WIRELESS=n
CONFIG_DRM=n
CONFIG_FB=n
CONFIG_AGP=n
CONFIG_MEDIA_SUPPORT=n
CONFIG_HID=n
CONFIG_DEBUG_INFO_NONE=y
CONFIG_DEBUG_KERNEL=n
CONFIG_FTRACE=n
CONFIG_PROFILING=n
CONFIG_KPROBES=n
CONFIG_SUSPEND=n
CONFIG_HIBERNATION=n
CONFIG_PM=y
CONFIG_INPUT_EVDEV=n
# Common cloud NICs/storage so the same kernel boots on major clouds too.
CONFIG_E1000=y
CONFIG_E1000E=y
CONFIG_NET_VENDOR_AMAZON=y
CONFIG_ENA_ETHERNET=y
CONFIG_GVE=y
CONFIG_NET_VENDOR_GOOGLE=y
CONFIG_SCSI_LOWLEVEL=y
# No legacy ATA/SATA in the virt flavor: probing six AHCI ports on q35 costs
# ~300 ms of boot. VMs use virtio-blk/virtio-scsi/NVMe; the ISO uses generic.
CONFIG_ATA=n
CONFIG_SATA_AHCI=n
CONFIG_ATA_PIIX=n
