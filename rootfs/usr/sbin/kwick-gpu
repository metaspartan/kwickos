#!/bin/sh
set -u
PROG=kwick-gpu
usage() {
  cat <<EOF
usage: $PROG [command] [options]
  status [--json]        show detected GPUs, kernel drivers and what is installed (default)
  detect                 print one detected vendor per line: amd intel nvidia apple rpi vm
  install [options]      install drivers and firmware for the detected hardware
      --list             only print the packages that would be installed
      --i386 | --no-i386 force or skip the 32-bit (i386) Mesa/Vulkan set (default: on for amd64 desktops)
      --rocm             also install the ROCm compute stack (AMD)
  rocm [--list]          install the ROCm compute stack (AMD)
  steam [--list]         prepare the machine for Steam: udev rules, uinput, GameMode, MangoHud, 32-bit GL/Vulkan
environment: KWICK_GPU_VENDOR=amd,intel,nvidia,apple,rpi,vm overrides detection
EOF
}

pci_vendor_to_name() {
  case "$1:$2" in
    0x1002:*) echo amd ;;
    0x10de:*) echo nvidia ;;
    0x8086:*) echo intel ;;
    0x1af4:*|0x15ad:*|0x1234:*|0x1414:*|0x1b36:*|0x1ab8:*|0x80ee:*) echo vm ;;
  esac
}

detect_vendors() {
  if [ -n "${KWICK_GPU_VENDOR:-}" ]; then
    printf '%s\n' $(printf '%s' "$KWICK_GPU_VENDOR" | tr 'A-Z,' 'a-z ') | sed 's/^virtio$/vm/;s/^vmware$/vm/;s/^qxl$/vm/' | sort -u
    return
  fi
  found=""
  for d in /sys/bus/pci/devices/*; do
    [ -r "$d/class" ] || continue
    case $(cat "$d/class") in 0x03*) ;; *) continue ;; esac
    n=$(pci_vendor_to_name "$(cat "$d/vendor")" "$(cat "$d/device" 2>/dev/null)")
    [ -n "$n" ] && found="$found $n"
  done
  if [ -z "$found" ] && command -v lspci >/dev/null 2>&1; then
    for line in $(lspci -nn 2>/dev/null | grep -E 'VGA|3D controller|Display controller' | grep -oE '\[[0-9a-f]{4}:[0-9a-f]{4}\]' | tr -d '[]' | cut -d: -f1); do
      n=$(pci_vendor_to_name "0x$line" "")
      [ -n "$n" ] && found="$found $n"
    done
  fi
  if [ -r /proc/device-tree/compatible ] && tr '\0' ' ' < /proc/device-tree/compatible | grep -q 'apple,'; then found="$found apple"; fi
  if [ -r /proc/device-tree/compatible ] && tr '\0' ' ' < /proc/device-tree/compatible | grep -qE 'brcm,bcm271[12]'; then found="$found rpi"; fi
  printf '%s\n' $found | sort -u
}

is_desktop() { [ -e /etc/kwick-edition ] || [ -n "${KWICK_GPU_DESKTOP:-}" ]; }

jstr() { printf '%s' "$1" | tr -d '"\\' | tr -c '[:print:]' ' '; }

pci_name() {
  for f in /usr/share/misc/pci.ids /usr/share/hwdata/pci.ids; do
    [ -r "$f" ] || continue
    awk -v v="${1#0x}" -v d="${2#0x}" '
      /^#/ || /^$/ { next }
      /^[0-9a-f]/ { inv = (substr($0, 1, 4) == v); next }
      inv && /^\t[0-9a-f]/ && substr($0, 2, 4) == d { print substr($0, 8); exit }' "$f"
    return
  done
}

ram_mb() { awk '/^MemTotal:/ { print int($2 / 1024) }' /proc/meminfo 2>/dev/null; }

gpu_devices() {
  idx=0
  nvsmi=""
  if command -v nvidia-smi >/dev/null 2>&1; then
    nvsmi=$(nvidia-smi --query-gpu=pci.bus_id,name,memory.total,compute_cap,driver_version --format=csv,noheader,nounits 2>/dev/null | tr 'A-F' 'a-f')
  fi
  for c in /sys/class/drm/card[0-9]*; do
    case ${c##*/} in *-*) continue ;; esac
    d=$c/device
    drv=$(basename "$(readlink "$d/driver" 2>/dev/null)" 2>/dev/null)
    vid=$(cat "$d/vendor" 2>/dev/null)
    v=$(pci_vendor_to_name "$vid" "")
    if [ -z "$v" ]; then
      case $drv in
        asahi) v=apple ;;
        v3d) v=rpi ;;
        "") continue ;;
        vc4) continue ;;
        *) v=$drv ;;
      esac
    fi
    pci=$(basename "$(readlink -f "$d" 2>/dev/null)")
    case $pci in *:*) ;; *) pci="" ;; esac
    name=$(pci_name "$vid" "$(cat "$d/device" 2>/dev/null)")
    vram=0; gtt=0; cc=""; dver=""; uni=false; disp=false
    for s in "$c"-*/status; do [ "$(cat "$s" 2>/dev/null)" = connected ] && disp=true; done
    case $v in
      amd)
        vram=$(( $(cat "$d/mem_info_vram_total" 2>/dev/null || echo 0) / 1048576 ))
        gtt=$(( $(cat "$d/mem_info_gtt_total" 2>/dev/null || echo 0) / 1048576 ))
        [ -r "$d/product_name" ] && name=$(cat "$d/product_name")
        dver=$(cat /sys/module/amdgpu/version 2>/dev/null)
        if [ "$vram" -gt 0 ] && { [ ! -e "$d/mem_info_vram_vendor" ] || { [ "$vram" -lt 4096 ] && [ "$gtt" -gt "$vram" ]; }; }; then uni=true; fi
        maj=$(cat "$d/ip_discovery/die/0/GC/0/major" 2>/dev/null)
        [ -n "$maj" ] && cc="gfx$maj$(cat "$d/ip_discovery/die/0/GC/0/minor" 2>/dev/null)$(cat "$d/ip_discovery/die/0/GC/0/revision" 2>/dev/null)" ;;
      intel)
        uni=true
        case $(cat "$d/device" 2>/dev/null) in 0x56*|0xe2*) uni=false ;; esac
        for p in tile0/vram0/size lmem_total_bytes; do [ -r "$d/$p" ] && vram=$(( $(cat "$d/$p") / 1048576 )); done ;;
      apple|rpi) uni=true ;;
      nvidia)
        if [ -n "$nvsmi" ] && [ -n "$pci" ]; then
          row=$(printf '%s\n' "$nvsmi" | grep -i "${pci#????:}" | head -1)
          if [ -n "$row" ]; then
            name=$(printf '%s' "$row" | cut -d, -f2 | sed 's/^ *//')
            m=$(printf '%s' "$row" | cut -d, -f3 | tr -d ' ')
            case $m in ''|*[!0-9]*) uni=true ;; *) vram=$m ;; esac
            cc=$(printf '%s' "$row" | cut -d, -f4 | tr -d ' ')
            dver=$(printf '%s' "$row" | cut -d, -f5 | tr -d ' ')
          fi
        fi
        [ -z "$dver" ] && [ "$drv" = nvidia ] && dver=$(cat /sys/module/nvidia/version 2>/dev/null) ;;
    esac
    printf '%s %s %s %s %s %s\n' "$idx" "$v" "$vram" "$gtt" "$uni" "$disp" >> "$GPU_TMP"
    [ "$idx" -gt 0 ] && printf ','
    printf '{"index":%d,"vendor":"%s","name":"%s","pci":"%s","card":"%s","vram_mb":%d,"gtt_mb":%d,"compute_cap":"%s","driver":"%s","driver_version":"%s","unified":%s,"display":%s}' \
      "$idx" "$v" "$(jstr "$name")" "$pci" "${c##*/}" "$vram" "$gtt" "$(jstr "$cc")" "$drv" "$(jstr "$dver")" "$uni" "$disp"
    idx=$((idx + 1))
  done
}

memory_budget() {
  ram=$1
  awk -v ram="$ram" '
    { vendor[NR] = $2; vram[NR] = $3; gtt[NR] = $4; uni[NR] = $5; disp[NR] = $6
      if ($2 == "nvidia" || $2 == "amd" || $2 == "intel" || $2 == "apple") { tot[$2] += $3 + 1; if (!($2 in seen)) { seen[$2] = 1; order[++n] = $2 } } }
    END {
      reserve = int(ram / 8); if (reserve < 2048) reserve = 2048
      ramb = ram - reserve; if (ramb < 0) ramb = 0
      best = ""; for (i = 1; i <= n; i++) if (best == "" || tot[order[i]] > tot[best]) best = order[i]
      budget = 0; pool = 0; u = 0
      for (i = 1; i <= NR; i++) {
        if (vendor[i] != best) continue
        if (uni[i] == "true") { u = 1; p = vram[i] + gtt[i]; if (best == "apple" || best == "nvidia" || p == 0) p = ram; if (p > pool) pool = p; continue }
        if (vram[i] <= 0) continue
        b = vram[i] - (disp[i] == "true" ? 1536 : 512); if (b > 0) budget += b
      }
      if (budget > 0) { print budget; exit }
      if (u) { lim = ram - reserve; if (pool > 0 && pool < lim) lim = pool; if (lim < 0) lim = 0; print lim; exit }
      print ramb
    }' "$GPU_TMP"
}

arch=$(dpkg --print-architecture 2>/dev/null || echo amd64)
want_i386=""
want_rocm=""
list_only=""

build_pkgs() {
  vendors=$(detect_vendors | tr '\n' ' ')
  pkgs="mesa-vulkan-drivers libgl1-mesa-dri libegl1 libgbm1 vulkan-tools"
  for v in $vendors; do
    case $v in
      amd) pkgs="$pkgs firmware-amd-graphics libdrm-amdgpu1 mesa-va-drivers mesa-vdpau-drivers radeontop mesa-opencl-icd" ;;
      intel) pkgs="$pkgs firmware-intel-graphics firmware-intel-misc mesa-va-drivers vainfo intel-gpu-tools"
             [ "$arch" = amd64 ] && pkgs="$pkgs intel-media-va-driver-non-free" ;;
      nvidia) pkgs="$pkgs firmware-nvidia-graphics libdrm-nouveau2 mesa-va-drivers mesa-vdpau-drivers mesa-opencl-icd nvtop" ;;
      apple) pkgs="$pkgs mesa-libgallium"; ;;
      rpi) pkgs="$pkgs mesa-libgallium libgles2 firmware-brcm80211" ;;
      vm) ;;
    esac
  done
  if is_desktop; then
    pkgs="$pkgs firmware-iwlwifi firmware-realtek firmware-mediatek firmware-atheros firmware-brcm80211 firmware-sof-signed firmware-misc-nonfree firmware-linux-free"
    [ "$arch" = amd64 ] && pkgs="$pkgs intel-microcode amd64-microcode"
  fi
  [ -n "$want_rocm" ] && pkgs="$pkgs $(rocm_pkgs)"
  if [ "$arch" = amd64 ] && [ "$want_i386" != no ] && { [ "$want_i386" = yes ] || is_desktop; }; then
    pkgs="$pkgs $(i386_pkgs "$vendors")"
  fi
}

rocm_pkgs() { echo "rocm-opencl-icd rocminfo rocm-smi libamdhip64-5 hipcc"; }

i386_pkgs() {
  out="libgl1:i386 libglx-mesa0:i386 libgl1-mesa-dri:i386 libegl1:i386 libgbm1:i386 libvulkan1:i386 mesa-vulkan-drivers:i386"
  for v in $1; do case $v in amd) out="$out libdrm-amdgpu1:i386" ;; esac; done
  echo "$out"
}

steam_pkgs() {
  echo "steam-installer steam-devices gamemode libgamemode0:i386 libgamemodeauto0:i386 mangohud mangohud:i386 vkbasalt libpipewire-0.3-0t64:i386 $(i386_pkgs "$(detect_vendors | tr '\n' ' ')")"
}

steam_pkgs_native() { echo "steam-devices gamemode mangohud vkbasalt"; }

enable_components() {
  sed -i 's/^Components: main$/Components: main contrib non-free non-free-firmware/' /etc/apt/sources.list.d/debian.sources 2>/dev/null
}

multiarch_i386() {
  dpkg --print-foreign-architectures 2>/dev/null | grep -qx i386 && return 0
  dpkg --add-architecture i386 >/dev/null 2>&1 && dpkg --print-foreign-architectures 2>/dev/null | grep -qx i386
}

apt_install() {
  apt install -y "$@" && return 0
  rc=0
  for p in "$@"; do apt install -y "$p" >/dev/null 2>&1 || { echo "$PROG: skipped $p (not installable here)"; rc=1; }; done
  return $rc
}

split_i386() {
  native=""; foreign=""
  for p in "$@"; do case $p in *:i386) foreign="$foreign $p" ;; *) native="$native $p" ;; esac; done
}

install_set() {
  split_i386 "$@"
  if [ -n "$foreign" ]; then
    if [ "$arch" = amd64 ] && multiarch_i386; then
      apt update >/dev/null 2>&1
    else
      echo "$PROG: could not enable the i386 architecture (dpkg --add-architecture i386 failed); 32-bit libraries are skipped"
      foreign=""
    fi
  fi
  apt_install $native $foreign
}

prepare_steam_host() {
  mkdir -p /etc/modules-load.d
  printf 'uinput\nntsync\n' > /etc/modules-load.d/kwick-gaming.conf
  modprobe uinput 2>/dev/null
  modprobe ntsync 2>/dev/null
  [ -c /dev/uinput ] || echo "$PROG: /dev/uinput missing (Steam Input needs the uinput module of the generic kernel)"
  return 0
}

cmd=${1:-status}
[ $# -gt 0 ] && shift
json=""
[ "$cmd" = --json ] && { cmd=status; json=1; }
for a in "$@"; do
  case $a in
    --json) json=1 ;;
    --i386) want_i386=yes ;;
    --no-i386) want_i386=no ;;
    --rocm) want_rocm=1 ;;
    --list) list_only=1 ;;
  esac
done

case $cmd in
  detect) detect_vendors ;;
  install)
    build_pkgs
    if [ -n "$list_only" ]; then echo $pkgs; exit 0; fi
    [ "$(id -u)" -eq 0 ] || exec sudo -E "$0" install "$@"
    enable_components
    apt update >/dev/null 2>&1
    install_set $pkgs
    rc=$?
    case " $vendors " in *" nvidia "*) [ -x /usr/lib/kwick/gpu-nvidia ] && /usr/lib/kwick/gpu-nvidia install ;; esac
    case " $vendors " in *" apple "*) [ -x /usr/lib/kwick/gpu-apple ] && /usr/lib/kwick/gpu-apple install ;; esac
    is_desktop && [ "$arch" = amd64 ] && prepare_steam_host
    exit $rc ;;
  rocm)
    [ -n "$list_only" ] && { rocm_pkgs; exit 0; }
    [ "$(id -u)" -eq 0 ] || exec sudo -E "$0" rocm "$@"
    enable_components
    apt update >/dev/null 2>&1
    apt_install $(rocm_pkgs) ;;
  steam)
    if [ "$arch" != amd64 ]; then
      echo "Steam is x86 only and Debian 13 has no x86 emulator package (no fex-emu, no box64) for $arch: unsupported here."
      exit 3
    fi
    vendors=$(detect_vendors | tr '\n' ' ')
    if [ -n "$list_only" ]; then steam_pkgs; exit 0; fi
    [ "$(id -u)" -eq 0 ] || exec sudo -E "$0" steam "$@"
    enable_components
    prepare_steam_host
    have_i386=""
    multiarch_i386 && have_i386=1
    apt update >/dev/null 2>&1
    apt_install $(steam_pkgs_native)
    if [ -n "$have_i386" ]; then
      echo steam steam/question select "I AGREE" | debconf-set-selections 2>/dev/null
      echo steam steam/license note '' | debconf-set-selections 2>/dev/null
      DEBIAN_FRONTEND=noninteractive apt_install $(steam_pkgs) || true
    else
      echo "$PROG: could not enable the i386 architecture; native Steam needs it, the Flatpak is the fallback"
    fi
    [ -x /usr/games/steam ] && echo "native" || echo "flatpak" ;;
  status|"")
    vendors=$(detect_vendors | tr '\n' ' ')
    if [ -n "$json" ]; then
      build_pkgs
      i386=null
      [ "$arch" = amd64 ] && { dpkg --print-foreign-architectures 2>/dev/null | grep -qx i386 && i386=true || i386=false; }
      [ -c /dev/uinput ] && uinput=true || uinput=false
      printf '{"vendors":['
      sep=""
      for v in $vendors; do printf '%s"%s"' "$sep" "$v"; sep=,; done
      printf '],"cards":['
      sep=""
      for c in /sys/class/drm/card[0-9]*; do
        [ -e "$c/device/vendor" ] || continue
        drv=$(basename "$(readlink "$c/device/driver" 2>/dev/null)" 2>/dev/null)
        printf '%s{"card":"%s","vendor":"%s","driver":"%s"}' "$sep" "$(basename "$c")" "$(cat "$c/device/vendor")" "$drv"
        sep=,
      done
      GPU_TMP=$(mktemp)
      printf '],"devices":['
      gpu_devices
      ram=$(ram_mb); ram=${ram:-0}
      printf '],"ram_mb":%d,"memory_budget_mb":%d' "$ram" "$(memory_budget "$ram")"
      rm -f "$GPU_TMP"
      printf ',"arch":"%s","packages":"%s","i386":%s,"uinput":%s}\n' "$arch" "$(echo $pkgs)" "$i386" "$uinput"
      exit 0
    fi
    echo "Detected: ${vendors:-none (headless VM or no GPU)}"
    for c in /sys/class/drm/card[0-9]*; do
      [ -e "$c/device/vendor" ] || continue
      drv=$(basename "$(readlink "$c/device/driver" 2>/dev/null)" 2>/dev/null)
      echo "  $(basename "$c"): vendor $(cat "$c/device/vendor"), kernel driver: ${drv:-none}"
    done
    for v in $vendors; do
      case $v in
        nvidia) if [ -x /usr/lib/kwick/gpu-nvidia ]; then /usr/lib/kwick/gpu-nvidia status; else echo "  NVIDIA: nouveau + NVK (Mesa Vulkan). Install kwick-gpu-nvidia for the NVIDIA open kernel modules and driver."; fi ;;
        apple) if [ -x /usr/lib/kwick/gpu-apple ]; then /usr/lib/kwick/gpu-apple status; else echo "  Apple Silicon: install the kwick-apple variant (Asahi kernel) for GPU, audio and display support."; fi ;;
        amd) echo "  AMD: amdgpu + RADV/radeonsi; 'kwick-gpu rocm' adds the compute stack." ;;
        intel) echo "  Intel: i915/xe + ANV/iris; media-va-driver-non-free for hardware video." ;;
        rpi) echo "  Raspberry Pi 4/5: vc4 KMS display + v3d render (Mesa v3d/vc4 OpenGL ES 3.1, v3dv Vulkan); needs dtoverlay=vc4-kms-v3d in /boot/firmware/config.txt." ;;
        vm) echo "  Virtual GPU: virtio-gpu/vmware/qxl via Mesa llvmpipe/virgl." ;;
      esac
    done
    build_pkgs
    echo "Would install: $pkgs"
    [ "$arch" = amd64 ] && echo "i386 multiarch: $(dpkg --print-foreign-architectures 2>/dev/null | grep -qx i386 && echo enabled || echo 'not enabled (run: dpkg --add-architecture i386, or kwick-gpu steam)')"
    [ -c /dev/uinput ] && echo "uinput: present" || echo "uinput: missing"
    command -v vulkaninfo >/dev/null && vulkaninfo --summary 2>/dev/null | grep -E 'deviceName|driverName' ;;
  help|-h|--help) usage ;;
  *) usage; exit 2 ;;
esac
