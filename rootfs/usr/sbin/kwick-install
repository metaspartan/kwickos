#!/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH

W=/run/kwick-install
T=$W/target
LOCKF=/run/kwick-install.lock
LOGF=/var/log/kwick-install.log
MEDIA=/run/media
LOWER=/run/lower
CONF=/etc/kwick/install.conf
KDIR=/usr/lib/kwick/kernels
CRYPT_NAME=kwick-root
ESP_MIB=512
BOOT_MIB=1024

CMD=""
JSON=0
DISK=""
MODE=erase
FS=ext4
ENCRYPT=0
PASSPHRASE_FILE=""
BL=""
HNAME=kwick
USERN=""
FULLNAME=""
PASSWORD_FILE=""
ROOT_PASSWORD_FILE=""
AUTOLOGIN=no
TZONE=UTC
LOCALE=en_US.UTF-8
KEYMAP=us
EDITION=""
LAYOUT=macos
SWAP=none
DRYRUN=0
YES=0
ROOT_PART=""
EFI_PART=""
HOME_PART=""
BOOT_PART=""
KEEP_HOME=0
BGPID=""
CURSTEP=""

jstr() { printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' | tr '\n\r\t' '   '; }
jbool() { if [ "$1" = 1 ]; then echo true; else echo false; fi; }

bad() {
	case $CMD in
	run) printf 'ERROR %s\n' "$*" ;;
	*) printf '{"ok":false,"error":"%s"}\n' "$(jstr "$*")" ;;
	esac
	exit 1
}

log() {
	printf 'LOG %s\n' "$*"
	printf '%s\n' "$*" >>"$LOGF" 2>/dev/null
}
progress() { printf 'PROGRESS %s %s\n' "$1" "$2"; }
step() {
	CURSTEP=$1
	printf 'STEP %s %s\n' "$1" "$2"
	printf '== %s\n' "$2" >>"$LOGF" 2>/dev/null
}

xrun() { "$@" >>"$LOGF" 2>&1; }

need() {
	if ! xrun "$@"; then
		tail -n 6 "$LOGF" 2>/dev/null | while IFS= read -r l; do printf 'LOG %s\n' "$l"; done
		printf 'ERROR command failed: %s\n' "$*"
		exit 1
	fi
}

have() { command -v "$1" >/dev/null 2>&1; }

fwmode() { if [ -d /sys/firmware/efi ]; then echo uefi; else echo bios; fi; }

archname() {
	case $(uname -m) in
	x86_64) echo amd64 ;;
	aarch64 | arm64) echo arm64 ;;
	riscv64) echo riscv64 ;;
	*) uname -m ;;
	esac
}

efi_suffix() {
	case $ARCHN in
	amd64) echo x64 ;;
	arm64) echo aa64 ;;
	riscv64) echo riscv64 ;;
	esac
}

efi_boot_name() {
	case $ARCHN in
	amd64) echo BOOTX64.EFI ;;
	arm64) echo BOOTAA64.EFI ;;
	riscv64) echo BOOTRISCV64.EFI ;;
	esac
}

root_type_guid() {
	case $ARCHN in
	amd64) echo 4F68BCE3-E8CD-4DB1-96E7-FBCAF984B709 ;;
	arm64) echo B921B045-1DF0-41C3-AF44-4C6F280D3FAE ;;
	riscv64) echo 72EC70A6-CF74-40E6-BD49-4BDA08E8F224 ;;
	esac
}

grub_target() {
	if [ "$1" = uefi ]; then
		case $ARCHN in
		amd64) echo x86_64-efi ;;
		arm64) echo arm64-efi ;;
		riscv64) echo riscv64-efi ;;
		esac
	else
		echo i386-pc
	fi
}

detect_edition() {
	if grep -qi desktop /etc/kwick-edition 2>/dev/null; then echo desktop; else echo headless; fi
}

human() {
	awk -v b="$1" 'BEGIN { if (b >= 1099511627776) printf "%.1f TiB", b / 1099511627776; else if (b >= 1073741824) printf "%.1f GiB", b / 1073741824; else printf "%d MiB", b / 1048576 }'
}

part_dev() {
	case $1 in
	*[0-9]) echo "${1}p$2" ;;
	*) echo "${1}$2" ;;
	esac
}

parent_disk() {
	n=${1#/dev/}
	if [ -e "/sys/class/block/$n/partition" ]; then
		p=$(readlink -f "/sys/class/block/$n")
		basename "$(dirname "$p")"
	else
		echo "$n"
	fi
}

sectors_of() {
	n=${1#/dev/}
	cat "/sys/class/block/$n/size" 2>/dev/null || echo 0
}

list_disk_names() {
	for s in /sys/block/*; do
		n=${s##*/}
		case $n in
		loop* | ram* | zram* | dm-* | md* | nbd* | sr* | fd* | mtd* | *boot[0-9] | *rpmb) continue ;;
		esac
		[ -r "$s/size" ] || continue
		sz=$(cat "$s/size")
		[ "$sz" -gt 0 ] 2>/dev/null || continue
		echo "$n"
	done
}

live_disk_names() {
	for mp in "$MEDIA" "$LOWER" /; do
		d=$(awk -v m="$mp" '$2 == m && $1 ~ /^\/dev\// { print $1 }' /proc/mounts | tail -n 1)
		[ -n "$d" ] || continue
		case $d in /dev/loop*) continue ;; esac
		parent_disk "$d"
	done
	blkid 2>/dev/null | grep -i 'LABEL="KWICKOS"' | sed 's/:.*//' | while read -r d; do parent_disk "$d"; done
}

disk_is_live() {
	live_disk_names | sort -u | grep -qx "$1"
}

disk_model() {
	s=/sys/block/$1/device
	m=""
	for f in vendor model; do
		if [ -r "$s/$f" ]; then
			v=$(cat "$s/$f" 2>/dev/null)
			case $v in 0x*) ;; *) m="$m $v" ;; esac
		fi
	done
	m=$(echo $m)
	[ -n "$m" ] || m=$(cat "$s/name" 2>/dev/null)
	if [ -z "$m" ] && [ "$(disk_transport "$1")" = virtio ]; then m="Virtio disk"; fi
	echo "$m"
}

disk_transport() {
	case $1 in
	nvme*) echo nvme; return ;;
	mmcblk*) echo mmc; return ;;
	esac
	p=$(readlink -f "/sys/block/$1" 2>/dev/null)
	case $p in
	*usb*) echo usb ;;
	*virtio*) echo virtio ;;
	*/ata*) echo sata ;;
	*xen*) echo xen ;;
	*scsi* | *host*) echo scsi ;;
	*) echo unknown ;;
	esac
}

disk_busy() {
	grep -q "^/dev/$1" /proc/mounts 2>/dev/null && return 0
	grep -q "^/dev/$1" /proc/swaps 2>/dev/null && return 0
	return 1
}

cmd_disks() {
	live=$(live_disk_names | sort -u)
	first=1
	printf '[\n'
	for n in $(list_disk_names); do
		bytes=$(($(cat "/sys/block/$n/size") * 512))
		model=$(disk_model "$n")
		tr_=$(disk_transport "$n")
		[ -n "$model" ] || model=Unknown
		rem=0
		[ "$(cat "/sys/block/$n/removable" 2>/dev/null)" = 1 ] && rem=1
		isl=0
		echo "$live" | grep -qx "$n" && isl=1
		[ $first = 1 ] || printf ',\n'
		first=0
		printf '  {"path":"/dev/%s","size_bytes":%s,"size_human":"%s","model":"%s","transport":"%s","removable":%s,"is_live_medium":%s}' \
			"$n" "$bytes" "$(human "$bytes")" "$(jstr "$model")" "$tr_" "$(jbool $rem)" "$(jbool $isl)"
	done
	printf '\n]\n'
}

bl_name() {
	case $1 in
	efistub) echo "EFI stub (direct kernel boot)" ;;
	grub) echo "GRUB" ;;
	systemd-boot) echo "systemd-boot" ;;
	limine) echo "Limine" ;;
	esac
}

bl_desc() {
	case $1 in
	efistub) echo "The firmware starts the kernel directly. Fastest, nothing to configure, ext4 without encryption." ;;
	grub) echo "Boot menu for BIOS and UEFI, reads every filesystem and encrypted setups." ;;
	systemd-boot) echo "Minimal UEFI boot menu." ;;
	limine) echo "Not packaged in Debian 13." ;;
	esac
}

bl_pkgs() {
	case $1 in
	grub)
		p="grub-common grub2-common"
		if [ "$2" = uefi ]; then
			case $ARCHN in
			amd64) p="$p grub-efi-amd64-bin" ;;
			arm64) p="$p grub-efi-arm64-bin" ;;
			riscv64) p="$p grub-efi-riscv64-bin" ;;
			esac
		else
			p="$p grub-pc-bin"
		fi
		echo "$p"
		;;
	systemd-boot) echo systemd-boot-efi ;;
	esac
}

bl_unavailable() {
	case $1 in
	efistub)
		[ "$2" = uefi ] || { echo "needs UEFI firmware"; return 0; }
		[ "$3" = ext4 ] || { echo "needs an ext4 root filesystem"; return 0; }
		[ "$4" = 1 ] && { echo "cannot unlock an encrypted root"; return 0; }
		;;
	grub)
		if [ "$2" = bios ] && [ "$ARCHN" != amd64 ]; then
			echo "BIOS boot is only available on amd64"
			return 0
		fi
		;;
	systemd-boot)
		[ "$2" = uefi ] || { echo "needs UEFI firmware"; return 0; }
		;;
	limine)
		echo "not packaged in Debian 13"
		return 0
		;;
	*)
		echo "unknown bootloader"
		return 0
		;;
	esac
	return 1
}

bl_installed() {
	case $1 in
	efistub) return 0 ;;
	grub) have grub-install && [ -d "/usr/lib/grub/$(grub_target "$2")" ] ;;
	systemd-boot) [ -f "/usr/lib/systemd/boot/efi/systemd-boot$(efi_suffix).efi" ] ;;
	*) return 1 ;;
	esac
}

bl_default() {
	if [ "$1" = uefi ]; then
		if bl_unavailable efistub "$1" "$2" "$3" >/dev/null; then echo grub; else echo efistub; fi
	else
		echo grub
	fi
}

cmd_bootloaders() {
	FW=$(fwmode)
	ARCHN=$(archname)
	def=$(bl_default "$FW" "$FS" "$ENCRYPT")
	first=1
	avail=""
	unav=""
	for id in efistub grub systemd-boot limine; do
		if r=$(bl_unavailable "$id" "$FW" "$FS" "$ENCRYPT"); then
			[ -n "$unav" ] && unav="$unav,"
			unav="$unav{\"id\":\"$id\",\"name\":\"$(bl_name "$id")\",\"reason\":\"$(jstr "$r")\"}"
			continue
		fi
		pk=""
		for p in $(bl_pkgs "$id" "$FW"); do
			[ -n "$pk" ] && pk="$pk,"
			pk="$pk\"$p\""
		done
		inst=0
		bl_installed "$id" "$FW" && inst=1
		[ -n "$avail" ] && avail="$avail,"
		avail="$avail{\"id\":\"$id\",\"name\":\"$(jstr "$(bl_name "$id")")\",\"description\":\"$(jstr "$(bl_desc "$id")")\",\"installed\":$(jbool $inst),\"packages\":[$pk]}"
	done
	printf '{"firmware":"%s","arch":"%s","default":"%s","bootloaders":[%s],"unavailable":[%s]}\n' "$FW" "$ARCHN" "$def" "$avail" "$unav"
}

builtin_timezones() {
	cat <<'EOF'
Africa/Cairo
Africa/Johannesburg
Africa/Lagos
Africa/Nairobi
America/Anchorage
America/Argentina/Buenos_Aires
America/Bogota
America/Chicago
America/Denver
America/Halifax
America/Los_Angeles
America/Mexico_City
America/New_York
America/Phoenix
America/Santiago
America/Sao_Paulo
America/Toronto
America/Vancouver
Asia/Bangkok
Asia/Dhaka
Asia/Dubai
Asia/Hong_Kong
Asia/Jakarta
Asia/Karachi
Asia/Kolkata
Asia/Manila
Asia/Seoul
Asia/Shanghai
Asia/Singapore
Asia/Taipei
Asia/Tehran
Asia/Tokyo
Atlantic/Reykjavik
Australia/Adelaide
Australia/Brisbane
Australia/Melbourne
Australia/Perth
