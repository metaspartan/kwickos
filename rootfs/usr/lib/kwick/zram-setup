#!/bin/sh
modprobe -q zram 2>/dev/null
[ -e /sys/block/zram0 ] || exit 0
kb=$(awk '/MemTotal/ { print $2 }' /proc/meminfo)
size=$((kb * 1024 / 2))
echo zstd >/sys/block/zram0/comp_algorithm 2>/dev/null
echo "$size" >/sys/block/zram0/disksize || exit 0
mkswap /dev/zram0 >/dev/null 2>&1 || exit 0
swapon -p 100 /dev/zram0
