#!/bin/sh
# udhcpc event script (KwickOS)
RESOLV_CONF=/etc/resolv.conf
[ -n "$interface" ] || exit 1

case "$1" in
	deconfig)
		ip -4 addr flush dev "$interface" 2>/dev/null
		ip link set "$interface" up
		;;
	bound|renew)
		cur=$(ip -4 -o addr show dev "$interface" | awk '{print $4}')
		if [ "$cur" != "$ip/${mask:-24}" ]; then
			ip -4 addr flush dev "$interface"
			ip addr add "$ip/${mask:-24}" ${broadcast:+broadcast "$broadcast"} dev "$interface"
		fi
		if [ -n "$router" ]; then
			while ip route del default dev "$interface" 2>/dev/null; do :; done
			for r in $router; do
				ip route add default via "$r" dev "$interface" && break
			done
		fi
		if [ -n "$dns" ] && [ ! -L "$RESOLV_CONF" ]; then
			{
				[ -n "$domain" ] && echo "search $domain"
				for d in $dns; do echo "nameserver $d"; done
			} > "$RESOLV_CONF.$$" && mv "$RESOLV_CONF.$$" "$RESOLV_CONF"
		fi
		[ -n "$hostname" ] && [ "$(hostname)" = kwick ] && hostname "$hostname"
		;;
esac
exit 0
