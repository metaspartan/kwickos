#!/bin/sh
PREFIX=/home/linuxbrew/.linuxbrew
INSTALL_URL=https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh
UNINSTALL_URL=https://raw.githubusercontent.com/Homebrew/install/HEAD/uninstall.sh
DEPS="build-essential procps curl file git ca-certificates"

say() { printf 'kwick-brew: %s\n' "$*"; }
die() { printf 'kwick-brew: %s\n' "$*" >&2; exit 1; }

usage() {
	cat <<EOF
usage: kwick-brew <command>

  install     install Homebrew to $PREFIX
  status      show whether Homebrew is installed and how big it is
  uninstall   remove Homebrew with the official uninstall script
  shellenv    print the shell snippet that puts brew on PATH (after system dirs)
EOF
}

check_arch() {
	case "$(uname -m)" in
	x86_64 | amd64 | aarch64 | arm64) return 0 ;;
	esac
	printf 'kwick-brew: Homebrew on Linux supports only x86_64 and arm64; this machine is %s.\n' "$(uname -m)" >&2
	exit 3
}

setup_priv() {
	if [ "$(id -u)" -eq 0 ]; then
		SUDO=
	elif command -v sudo >/dev/null 2>&1; then
		SUDO=sudo
	else
		die "sudo is required (as root: apt install sudo)"
	fi
}

target_user() {
	if [ "$(id -u)" -ne 0 ]; then
		id -un
	elif [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != root ]; then
		printf '%s\n' "$SUDO_USER"
	else
		printf 'linuxbrew\n'
	fi
}

missing_deps() {
	for p in $DEPS; do
		dpkg -s "$p" >/dev/null 2>&1 || printf '%s ' "$p"
	done
}

ensure_pkgs() {
	need=$*
	[ -n "$need" ] || return 0
	say "installing Debian packages: $need"
	$SUDO env DEBIAN_FRONTEND=noninteractive apt-get install -y $need 2>/dev/null ||
		{ $SUDO apt-get update && $SUDO env DEBIAN_FRONTEND=noninteractive apt-get install -y $need; } ||
		die "apt could not install: $need"
}

real_bash() {
	[ -x /usr/bin/bash ] && ! grep -q 'KwickOS on-demand bash' /usr/bin/bash 2>/dev/null
}

run_as() {
	u=$1
	shift
	if [ "$u" = "$(id -un)" ]; then
		"$@"
	elif [ "$(id -u)" -eq 0 ]; then
		su -s /bin/sh -c 'exec "$@"' -- "$u" sh "$@"
	else
		sudo -u "$u" "$@"
	fi
}

fetch() {
	curl -fsSL --retry 3 -o "$2" "$1" || die "could not download $1"
}

cmd_install() {
	check_arch
	setup_priv
	if [ -x "$PREFIX/bin/brew" ]; then
		say "Homebrew is already installed at $PREFIX"
		cmd_next
		return 0
	fi
	ensure_pkgs $(missing_deps)
	if ! real_bash; then
		ensure_pkgs bash
	fi
	u=$(target_user)
	if ! id "$u" >/dev/null 2>&1; then
		say "creating user $u"
		$SUDO adduser --disabled-password --gecos "Homebrew" "$u" >/dev/null 2>&1 ||
			$SUDO useradd -m -s /bin/bash "$u" || die "could not create user $u"
	fi
	g=$(id -gn "$u")
	$SUDO mkdir -p "$PREFIX"
	$SUDO chown "$u:$g" /home/linuxbrew "$PREFIX"
	$SUDO chmod 755 /home/linuxbrew
	tmp=$(mktemp -d)
	trap 'rm -rf "$tmp"' EXIT INT TERM
	chmod 755 "$tmp"
	fetch "$INSTALL_URL" "$tmp/install.sh"
	chmod 644 "$tmp/install.sh"
	say "running the official Homebrew installer as $u"
	run_as "$u" env NONINTERACTIVE=1 HOME="$(getent passwd "$u" | cut -d: -f6)" /usr/bin/bash "$tmp/install.sh" ||
		die "the Homebrew installer failed"
	[ -x "$PREFIX/bin/brew" ] || die "brew not found at $PREFIX/bin/brew after install"
	cmd_next
}

cmd_next() {
	cat <<EOF

Homebrew is installed at $PREFIX.
Next steps:
  1. Open a new login shell, or run:  eval "\$(kwick-brew shellenv)"
  2. Try it:                          brew install hello && hello
  3. Check health:                    brew doctor
brew is placed after /usr/bin in PATH, so it cannot shadow system tools.
Remove it again with:                 kwick-brew uninstall
EOF
}

cmd_status() {
	arch=$(uname -m)
	case "$arch" in
	x86_64 | amd64 | aarch64 | arm64) sup=yes ;;
	*) sup=no ;;
	esac
	echo "architecture: $arch (supported: $sup)"
	if [ -x "$PREFIX/bin/brew" ]; then
		echo "installed:    yes"
		echo "prefix:       $PREFIX"
		echo "owner:        $(stat -c %U "$PREFIX" 2>/dev/null)"
		echo "version:      $("$PREFIX/bin/brew" --version 2>/dev/null | head -n1)"
		echo "size:         $(du -sh "$PREFIX" 2>/dev/null | cut -f1)"
		return 0
	fi
	echo "installed:    no"
	echo "install with: kwick-brew install"
	return 1
}

cmd_uninstall() {
	setup_priv
	[ -x "$PREFIX/bin/brew" ] || die "Homebrew is not installed at $PREFIX"
	u=$(stat -c %U "$PREFIX")
	tmp=$(mktemp -d)
	grant=
	trap 'rm -rf "$tmp"; [ -z "$grant" ] || rm -f "$grant"' EXIT INT TERM
	if [ "$(id -u)" -eq 0 ] && [ "$u" != root ]; then
		command -v sudo >/dev/null 2>&1 || ensure_pkgs sudo
		grant=/etc/sudoers.d/zz-kwick-brew
		mkdir -p /etc/sudoers.d
		printf '%s ALL=(ALL) NOPASSWD: ALL\n' "$u" >"$grant"
		chmod 440 "$grant"
	fi
	chmod 755 "$tmp"
	fetch "$UNINSTALL_URL" "$tmp/uninstall.sh"
	chmod 644 "$tmp/uninstall.sh"
	say "running the official Homebrew uninstaller as $u"
	run_as "$u" env NONINTERACTIVE=1 HOME="$(getent passwd "$u" | cut -d: -f6)" /usr/bin/bash "$tmp/uninstall.sh" --force --path="$PREFIX" ||
		die "the Homebrew uninstaller failed"
	$SUDO rm -f "$PREFIX/lib/ld.so"
	$SUDO rmdir "$PREFIX/lib" "$PREFIX" /home/linuxbrew 2>/dev/null || true
	say "Homebrew removed"
}

cmd_shellenv() {
	cat <<'EOF'
if [ -x /home/linuxbrew/.linuxbrew/bin/brew ]; then
	eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv sh)"
	__kb_path=
	__kb_ifs=$IFS
	IFS=:
	for __kb_d in $PATH; do
		case $__kb_d in
		/home/linuxbrew/.linuxbrew/bin | /home/linuxbrew/.linuxbrew/sbin) ;;
		*) __kb_path=${__kb_path:+$__kb_path:}$__kb_d ;;
		esac
	done
	IFS=$__kb_ifs
	PATH=$__kb_path:/home/linuxbrew/.linuxbrew/bin:/home/linuxbrew/.linuxbrew/sbin
	export PATH
	unset __kb_path __kb_ifs __kb_d
fi
EOF
}

case "${1:-}" in
install) cmd_install ;;
status) cmd_status ;;
uninstall) cmd_uninstall ;;
shellenv) cmd_shellenv ;;
-h | --help | help | "") usage ;;
*)
	usage >&2
	exit 2
	;;
esac
