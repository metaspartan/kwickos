#!/bin/sh
set -u

WGDIR=/etc/wireguard
OVDIR=/etc/openvpn/client
PIDDIR=/run/kwick-vpn
INDEX=/var/lib/kwick-vpn/profiles
NMVPN=/usr/lib/NetworkManager/VPN
TAB=$(printf '\t')
ESC_COLON=$(printf '\001')
ESC_BS=$(printf '\002')
WAYBAR_SIGNAL=10

die() { printf 'kwick-vpn: %s\n' "$*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }
has_systemd() { have systemctl && [ -d /run/systemd/system ]; }

usage() {
  cat <<'EOF'
usage: kwick-vpn <command> [args]

  import <file.conf|file.ovpn>   check and import a WireGuard or OpenVPN profile
  list [--json]                  list VPN profiles (name, type, state, address)
  up <name>                      connect
  down <name>                    disconnect
  toggle <name>                  connect or disconnect
  status [--json]                show active VPN connections
  menu                           pick a profile to toggle from a fuzzel menu
  providers                      list optional providers and their state
  install [--progress] <what>    install base, plugins, tailscale, mullvad,
                                 protonvpn, protonvpn-cli, zerotier, netbird
                                 (--progress adds apt status lines)
  waybar                         JSON status for a waybar custom module
EOF
}

as_root() {
  if [ "$(id -u)" -eq 0 ]; then "$@"
  elif have sudo && sudo -n true 2>/dev/null; then sudo "$@"
  elif have pkexec; then pkexec "$@"
  elif have sudo; then sudo "$@"
  else die "root privileges required"
  fi
}

nm_ok() {
  have nmcli || return 1
  [ "$(nmcli -t -f RUNNING general status 2>/dev/null)" = running ]
}

nm_fields() {
  fields=$1; shift
  nmcli -t -f "$fields" "$@" 2>/dev/null | sed 's/\\\\/'"$ESC_BS"'/g; s/\\:/'"$ESC_COLON"'/g' | tr ':' '\t' | tr "$ESC_COLON$ESC_BS" ':\\'
}

nmc() {
  out=$(nmcli "$@" 2>&1) && return 0
  case $out in
    *"Insufficient privileges"*|*"not authorized"*|*"Not authorized"*) out=$(as_root nmcli "$@" 2>&1) ;;
    *) return 1 ;;
  esac
}

nm_state() {
  case $1 in
    activated) echo connected ;;
    activating) echo connecting ;;
    deactivating) echo disconnecting ;;
    *) echo disconnected ;;
  esac
}

info_field() { printf '%s\n' "$1" | awk -F: -v k="$2" '$1==k{sub(/^[^:]*:/, ""); print; exit}'; }

nm_list() {
  nm_fields NAME,UUID,TYPE,STATE connection show | while IFS="$TAB" read -r name uuid type state; do
    case $type in vpn|wireguard) ;; *) continue ;; esac
    st=$(nm_state "$state")
    info=
    if [ "$type" = vpn ] || [ "$st" = connected ]; then info=$(nmcli -t connection show uuid "$uuid" 2>/dev/null); fi
    if [ "$type" = vpn ]; then
      type=$(info_field "$info" vpn.service-type)
      type=${type##*.}
    fi
    ip=$(info_field "$info" 'IP4.ADDRESS[1]')
    printf '%s\t%s\t%s\t%s\n' "$name" "${type:-vpn}" "$st" "${ip%/*}"
  done
}

index_add() {
  tmp=$(mktemp) || die "mktemp failed"
  { [ -f "$INDEX" ] && awk -F'\t' -v n="$1" '$1!=n' "$INDEX"; printf '%s\t%s\n' "$1" "$2"; } > "$tmp"
  as_root install -D -m 644 "$tmp" "$INDEX"
  rm -f "$tmp"
}

dir_names() {
  [ -r "$1" ] || return 0
  for conf in "$1"/*.conf; do
    [ -e "$conf" ] || continue
    n=${conf##*/}
    printf '%s\t%s\n' "${n%.conf}" "$2"
  done
}

direct_names() {
  { dir_names "$WGDIR" wireguard; dir_names "$OVDIR" openvpn; [ -f "$INDEX" ] && cat "$INDEX"; } | awk -F'\t' '!seen[$1]++'
}

is_wg_iface() { grep -qx 'DEVTYPE=wireguard' "/sys/class/net/$1/uevent" 2>/dev/null; }

iface_ip() { ip -4 -o addr show dev "$1" 2>/dev/null | awk '{sub(/\/.*/, "", $4); print $4; exit}'; }

ov_pid() {
  [ -f "$PIDDIR/$1.pid" ] || return 1
  p=$(cat "$PIDDIR/$1.pid" 2>/dev/null) || return 1
  [ -n "$p" ] && kill -0 "$p" 2>/dev/null
}

ov_up() {
  if has_systemd && systemctl is-active --quiet "openvpn-client@$1" 2>/dev/null; then return 0; fi
  ov_pid "$1"
}

direct_list() {
  direct_names | while IFS="$TAB" read -r name type; do
    st=disconnected ip=
    case $type in
      wireguard) is_wg_iface "$name" && st=connected && ip=$(iface_ip "$name") ;;
      openvpn) ov_up "$name" && st=connected ;;
    esac
    printf '%s\t%s\t%s\t%s\n' "$name" "$type" "$st" "$ip"
  done
}

profiles() { if nm_ok; then nm_list; else direct_list; fi | sort -f -t "$TAB" -k1,1; }

cmd_list() {
  rows=$(profiles)
  [ -n "$rows" ] || return 0
  if [ -t 1 ]; then
    printf '%s\n' "$rows" | awk -F'\t' 'BEGIN{printf "%-24s %-10s %-14s %s\n","NAME","TYPE","STATE","ADDRESS"} {printf "%-24s %-10s %-14s %s\n",$1,$2,$3,$4}'
  else
    printf '%s\n' "$rows"
  fi
}

sanitize_name() {
  b=${1##*/}; b=${b%.*}
  printf '%s' "$b" | tr -c 'A-Za-z0-9_=+.-' '-' | cut -c1-15
}

profile_kind() {
  if grep -qiE '^[[:space:]]*\[Interface\]' "$1"; then echo wireguard
  elif grep -qE '^[[:space:]]*(remote|client|dev|<connection>)([[:space:]]|$)' "$1"; then echo openvpn
  fi
}

check_wireguard() {
  awk '
    { sub(/#.*/, ""); gsub(/^[ \t]+|[ \t]+$/, "") }
    /^\[/ { sec = tolower($0); next }
    sec == "[interface]" && tolower($0) ~ /^privatekey[ \t]*=/ { key = 1 }
    sec == "[interface]" && tolower($0) ~ /^address[ \t]*=/ { addr = 1 }
    sec == "[peer]" { peer = 1 }
    sec == "[peer]" && tolower($0) ~ /^publickey[ \t]*=/ { pub = 1 }
    sec == "[peer]" && tolower($0) ~ /^allowedips[ \t]*=/ { allowed = 1 }
    END {
      if (!key) print "the [Interface] section has no PrivateKey"
      else if (!addr) print "the [Interface] section has no Address"
      else if (!peer) print "there is no [Peer] section"
      else if (!pub) print "the [Peer] section has no PublicKey"
      else if (!allowed) print "the [Peer] section has no AllowedIPs"
    }' "$1"
}

check_openvpn() {
  grep -qE '^[[:space:]]*(remote[[:space:]]|<connection>)' "$1" || echo "there is no remote server line"
}

profile_exists() {
  if nm_ok; then nm_fields NAME connection show | grep -qxF "$1"
  else direct_names | cut -f1 | grep -qxF "$1"
  fi
}

nm_import() {
  [ "$kind" = wireguard ] || [ -f "$NMVPN/nm-openvpn-service.name" ] ||
    die "OpenVPN support for NetworkManager is missing: run kwick-vpn install plugins"
  tmp=$(mktemp -d) || die "mktemp failed"
  cp "$f" "$tmp/$name.$([ "$kind" = wireguard ] && echo conf || echo ovpn)"
  nmc connection import type "$kind" file "$tmp"/*
  rc=$?
  rm -rf "$tmp"
  [ $rc -eq 0 ] || die "$(nm_error "$out")"
  nmc connection modify id "$name" connection.autoconnect no
  nmc connection down id "$name"
}

direct_import() {
  if [ "$kind" = wireguard ]; then
    have wg-quick || die "wg-quick missing: run kwick-vpn install base"
    as_root install -d -m 700 "$WGDIR"
    as_root install -m 600 "$f" "$WGDIR/$name.conf"
  else
    have openvpn || die "openvpn missing: run kwick-vpn install base"
    as_root install -d -m 755 "$OVDIR"
    as_root install -m 600 "$f" "$OVDIR/$name.conf"
  fi
  index_add "$name" "$kind"
}

cmd_import() {
  [ $# -eq 1 ] || die "usage: kwick-vpn import <file.conf|file.ovpn>"
  f=$1
  [ -f "$f" ] || die "no such file: $f"
  [ -r "$f" ] || die "cannot read $f"
  case $f in
    *.ovpn|*.conf) ;;
    *) die "unsupported file type: ${f##*/} (expected .conf or .ovpn)" ;;
  esac
  kind=$(profile_kind "$f")
  [ -n "$kind" ] || die "${f##*/} is neither a WireGuard nor an OpenVPN profile"
  label=$([ "$kind" = wireguard ] && echo WireGuard || echo OpenVPN)
  problem=$(check_$kind "$f")
  [ -z "$problem" ] || die "${f##*/} is not a valid $label profile: $problem"
  name=$(sanitize_name "$f")
  if nm_ok && [ "$kind" = openvpn ]; then name=${f##*/}; name=${name%.*}; fi
  profile_exists "$name" && die "a VPN named $name already exists"
  if nm_ok; then nm_import; else direct_import; fi
  printf 'imported %s as %s (%s)\n' "${f##*/}" "$name" "$label"
  refresh_bar
}

direct_type() {
  direct_names | awk -F'\t' -v n="$1" '$1==n{print $2; exit}'
}

nm_reason() {
  case $1 in
    *"timed out"*|*"Timeout expired"*) echo "Timed out" ;;
    *"did not start in time"*|*"failed to start"*) echo "The VPN service did not start" ;;
    *"Invalid secrets"*|*"ogin failed"*) echo "Login failed" ;;
    *"ecrets"*) echo "Secrets were required" ;;
    *"invalid configuration"*) echo "The VPN server sent an invalid configuration" ;;
    *"stopped unexpectedly"*) echo "The VPN service stopped unexpectedly" ;;
    *"base network connection was interrupted"*) echo "The network connection was interrupted" ;;
    *"Unknown reason"*) echo "Could not connect" ;;
    *) printf '%s\n' "$1" ;;
  esac
}

nm_error() {
  e=$(printf '%s\n' "$1" | sed -n 's/^Error: //p' | head -n 1)
  nm_reason "$(printf '%s' "${e:-$(printf '%s\n' "$1" | tail -n 1)}" | sed 's/^Connection activation failed: //; s/\.$//')"
}

refresh_bar() { pkill -RTMIN+$WAYBAR_SIGNAL -x waybar 2>/dev/null; true; }

nm_switch() {
  nmc connection "$1" "$2"
  rc=$?
  refresh_bar
  [ $rc -eq 0 ] || die "$(nm_error "$out")"
}

direct_up() {
  case $2 in
    wireguard) as_root wg-quick up "$1" ;;
    openvpn)
      if has_systemd; then
        as_root systemctl start "openvpn-client@$1"
      else
        as_root install -d -m 755 "$PIDDIR" &&
          as_root openvpn --config "$OVDIR/$1.conf" --cd "$OVDIR" --daemon "kwick-vpn-$1" --writepid "$PIDDIR/$1.pid"
      fi ;;
  esac
}

direct_down() {
  case $2 in
    wireguard) as_root wg-quick down "$1" ;;
    openvpn)
      if has_systemd; then as_root systemctl stop "openvpn-client@$1"
      elif ov_pid "$1"; then as_root kill "$(cat "$PIDDIR/$1.pid")"
      else echo "$1 is not running"; false
      fi ;;
  esac
}

switch() {
  [ $# -eq 2 ] || die "usage: kwick-vpn $1 <name>"
  if nm_ok; then nm_switch "$1" "$2"; return; fi
  vtype=$(direct_type "$2")
  [ -n "$vtype" ] || die "no such profile: $2"
  out=$(direct_$1 "$2" "$vtype" 2>&1)
  rc=$?
  refresh_bar
  [ $rc -eq 0 ] || die "$(printf '%s\n' "$out" | grep -v '^\[#\]' | tail -n 1)"
}

cmd_up() { switch up "$@"; }

cmd_down() { switch down "$@"; }

profile_state() { profiles | awk -F'\t' -v n="$1" '$1==n{print $3; f=1; exit} END{if(!f) exit 1}'; }

cmd_toggle() {
  [ $# -eq 1 ] || die "usage: kwick-vpn toggle <name>"
  st=$(profile_state "$1") || die "no such profile: $1"
  case $st in disconnected) cmd_up "$1" ;; *) cmd_down "$1" ;; esac
}

tunnel_ifaces() {
  for d in /sys/class/net/*; do
    [ -e "$d" ] || continue
    n=${d##*/}
    if is_wg_iface "$n"; then
      printf '%s\n' "$n"
      continue
    fi
    case $n in
      tun[0-9]*|tailscale[0-9]*|zt*|wt[0-9]*|nordlynx|pvpn*|proton[0-9]*|ipv6leakintrf*|mullvad*) printf '%s\n' "$n" ;;
    esac
  done
}

extra_tunnels() {
  names=$(printf '%s\n' "$1" | cut -f1)
  busy=$(printf '%s\n' "$1" | awk -F'\t' '$3=="connected" && $2!="wireguard"{print 1; exit}')
  tunnel_ifaces | awk -v names="$names" -v busy="$busy" '
    BEGIN { n = split(names, a, "\n"); for (i = 1; i <= n; i++) k[a[i]] = 1 }
    k[$0] { next }
    busy && /^tun[0-9]/ { next }
    { print }'
}

connected_lines() {
  printf '%s\n' "$1" | awk -F'\t' '$3=="connected"{print $1 ($4 != "" ? "  " $4 : "")}'
  extra_tunnels "$1"
}

cmd_status() {
  act=$(connected_lines "$(profiles)")
  if [ -z "$act" ]; then
    echo "no VPN connected"
    return 1
  fi
  printf '%s\n' "$act" | sed 's/^/up  /'
  if have tailscale; then
    tailscale status --peers=false 2>/dev/null | head -1 | sed 's/^/tailscale: /'
  fi
}

json_str() {
  printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g; s/	/ /g' | awk 'BEGIN{ORS=""} {print (NR > 1 ? "\\n" : "") $0}'
}

rows_json() {
  printf '%s\n' "$1" | awk -F'\t' -v only="$2" '
    function e(s,  o, i, c) { o = ""; for (i = 1; i <= length(s); i++) { c = substr(s, i, 1); if (c == "\\" || c == "\"") o = o "\\"; o = o c }; return o }
    NF >= 3 && (only == "" || $3 == only) {
      printf "%s{\"name\":\"%s\",\"type\":\"%s\",\"state\":\"%s\",\"address\":\"%s\"}", (n++ ? "," : ""), e($1), e($2), e($3), e($4)
    }'
}

cmd_list_json() {
  printf '{"profiles":[%s]}\n' "$(rows_json "$(profiles)" "")"
}

cmd_status_json() {
  rows=$(profiles)
  others=$(extra_tunnels "$rows" | awk 'NF { printf "%s\"%s\"", (n++ ? "," : ""), $1 }')
  printf '{"connected":[%s],"other_tunnels":[%s]}\n' "$(rows_json "$rows" connected)" "$others"
}

cmd_waybar() {
  rows=$(profiles)
  conn=$(connected_lines "$rows")
  if [ -z "$rows" ] && [ -z "$conn" ]; then
    printf '{"text":"","alt":"none","class":"none","tooltip":""}\n'
    return 0
  fi
  wait=$(printf '%s\n' "$rows" | awk -F'\t' '$3=="connecting"||$3=="disconnecting"{print $1; exit}')
  if [ -n "$wait" ]; then st=connecting tip="VPN: Connecting to $wait…"
  elif [ -n "$conn" ]; then st=connected tip="VPN: Connected
$conn"
  else st=disconnected tip="VPN: Not Connected"
  fi
  printf '{"text":"VPN","alt":"%s","class":"%s","tooltip":"%s"}\n' "$st" "$st" "$(json_str "$tip
Click to connect or disconnect, right-click for VPN Settings")"
}

notify() { have notify-send && notify-send -a VPN -i network-vpn-symbolic ${3:+-u "$3"} "$1" "$2"; true; }

cmd_menu() {
  have fuzzel || die "fuzzel is not installed"
  settings="VPN Settings…"
  list=$(profiles | awk -F'\t' 'NF {
    s = $3 == "connected" ? "Connected" ($4 != "" ? " · " $4 : "") : $3 == "connecting" ? "Connecting…" : $3 == "disconnecting" ? "Disconnecting…" : "Not Connected"
    printf "%s %s\t%s\n", ($3 == "disconnected" ? "○" : "●"), $1, s
  }')
  n=$(printf '%s' "$list" | grep -c '')
  pick=$(printf '%s%s\n' "${list:+$list
}" "$settings" | fuzzel --dmenu --prompt "VPN  " --lines "$((n + 1))" --width 40 --tabs 4 2>/dev/null) || return 0
  [ -n "$pick" ] || return 0
  if [ "$pick" = "$settings" ]; then exec kwick-settings vpn; fi
  name=${pick#* }
  name=${name%%"$TAB"*}
  if out=$(cmd_toggle "$name" 2>&1); then
    case $(profile_state "$name") in
      connected) notify "Connected to $name" "" ;;
      connecting) notify "Connecting to $name…" "" ;;
      *) notify "Disconnected from $name" "" ;;
    esac
  else
    notify "Could not change $name" "${out#kwick-vpn: }" critical
    return 1
  fi
}

APT_PROGRESS=

apt_install() {
  as_root env DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends $APT_PROGRESS "$@"
}

host_arch() { dpkg --print-architecture 2>/dev/null || uname -m; }

codename() {
  c=$(sed -n 's/^VERSION_CODENAME=//p' /etc/os-release 2>/dev/null | tr -d '"')
  printf '%s' "${c:-trixie}"
}

require_arch() {
  a=$(host_arch)
  for ok in "$@"; do [ "$a" = "$ok" ] && return 0; done
  die "not available for $a (supported: $*)"
}

fetch() {
  have curl || apt_install curl ca-certificates
  curl -fsSL "$1" -o "$2"
}

primary_fprs() {
  gpg --show-keys --with-colons "$1" 2>/dev/null |
    awk -F: '$1=="pub"{p=1;next} $1=="fpr"&&p{print $10;p=0}'
}

add_repo() {
  name=$1; keyurl=$2; fpr=$3; line=$4
  have gpg || apt_install gpg
  tmp=$(mktemp -d) || die "mktemp failed"
  fetch "$keyurl" "$tmp/key" || { rm -rf "$tmp"; die "could not download $keyurl"; }
  got=$(primary_fprs "$tmp/key")
  if [ "$got" != "$fpr" ]; then
    rm -rf "$tmp"
    die "signing key fingerprint mismatch for $name (expected $fpr, got ${got:-none})"
  fi
  if grep -q 'PGP PUBLIC KEY' "$tmp/key"; then
    gpg --dearmor < "$tmp/key" > "$tmp/key.gpg" || { rm -rf "$tmp"; die "dearmor failed"; }
  else
    cp "$tmp/key" "$tmp/key.gpg"
  fi
  as_root install -d -m 755 /usr/share/keyrings
  as_root install -m 644 "$tmp/key.gpg" "/usr/share/keyrings/$name-archive-keyring.gpg"
  rm -rf "$tmp"
  printf 'deb [signed-by=/usr/share/keyrings/%s-archive-keyring.gpg] %s\n' "$name" "$line" |
    as_root tee "/etc/apt/sources.list.d/$name.list" >/dev/null
  as_root apt-get update
}

pkg_installed() { dpkg-query -W -f='${Status}' "$1" 2>/dev/null | grep -q 'install ok installed'; }

provider_state() {
  case $1 in
    tailscale) pkg_installed tailscale ;;
    mullvad) pkg_installed mullvad-vpn ;;
    protonvpn) pkg_installed proton-vpn-gnome-desktop || pkg_installed proton-vpn-gtk-app ;;
    protonvpn-cli) pkg_installed proton-vpn-cli ;;
    zerotier) pkg_installed zerotier-one ;;
    netbird) pkg_installed netbird ;;
    base) pkg_installed wireguard-tools && pkg_installed openvpn ;;
    plugins) pkg_installed network-manager-openvpn ;;
  esac
}

provider_arches() {
  case $1 in
    mullvad|protonvpn|protonvpn-cli|zerotier|netbird) echo "amd64 arm64" ;;
    *) echo "amd64 arm64 riscv64" ;;
  esac
}

cmd_providers() {
  a=$(host_arch)
  for p in plugins tailscale mullvad protonvpn zerotier netbird; do
    if provider_state "$p"; then st=installed
    elif provider_arches "$p" | tr ' ' '\n' | grep -qx "$a"; then st=available
    else st=unavailable
    fi
    printf '%s\t%s\n' "$p" "$st"
  done
}

cmd_install() {
  if [ "${1:-}" = --progress ]; then APT_PROGRESS="-o APT::Status-Fd=1"; shift; fi
  [ $# -ge 1 ] || { cmd_providers; return 0; }
  what=$1
  have apt-get || die "apt-get not found"
  case $what in
    base)
      as_root apt-get update
      if have resolvconf || have resolvectl; then
        apt_install wireguard-tools openvpn
      else
        apt_install wireguard-tools openvpn openresolv
      fi ;;
    plugins)
      as_root apt-get update
      apt_install network-manager-openvpn network-manager-openconnect network-manager-vpnc \
        network-manager-l2tp network-manager-strongswan network-manager-sstp \
        wireguard-tools openvpn openconnect ;;
    tailscale)
      require_arch amd64 arm64 riscv64
      c=$(codename)
      add_repo tailscale "https://pkgs.tailscale.com/stable/debian/$c.noarmor.gpg" \
        2596A99EAAB33821893C0A79458CA832957F5868 "https://pkgs.tailscale.com/stable/debian $c main"
      apt_install tailscale
      echo "run: sudo tailscale up" ;;
    mullvad)
      require_arch amd64 arm64
      add_repo mullvad "https://repository.mullvad.net/deb/mullvad-keyring.asc" \
        A1198702FC3E0A09A9AE5B75D5A1D4F266DE8DDF "https://repository.mullvad.net/deb/stable stable main"
      apt_install mullvad-vpn ;;
    protonvpn|protonvpn-cli)
      require_arch amd64 arm64
      add_repo protonvpn "https://repo.protonvpn.com/debian/public_key.asc" \
        84B0D3492C76C9C6F5873C18EDA3E22630349F1C "https://repo.protonvpn.com/debian stable main"
      if [ "$what" = protonvpn ]; then apt_install proton-vpn-gnome-desktop; else apt_install proton-vpn-cli; fi ;;
    zerotier)
      require_arch amd64 arm64
      c=$(codename)
      add_repo zerotier "https://download.zerotier.com/contact%40zerotier.com.gpg" \
        74A5E9C458E1A431F1DA57A71657198823E52A61 "https://download.zerotier.com/debian/$c $c main"
      apt_install zerotier-one
      echo "run: sudo zerotier-cli join <network-id>" ;;
    netbird)
      require_arch amd64 arm64
      add_repo netbird "https://pkgs.netbird.io/debian/public.key" \
        EFE37DF047DF7CCDF1FC54FA83F79AD029778355 "https://pkgs.netbird.io/debian stable main"
      apt_install netbird
      echo "run: sudo netbird up" ;;
    *) die "unknown provider: $what" ;;
  esac
}

cmd=${1:-}
[ $# -gt 0 ] && shift
case $cmd in
  import) cmd_import "$@" ;;
  list|ls) if [ "${1:-}" = --json ]; then cmd_list_json; else cmd_list; fi ;;
  up) cmd_up "$@" ;;
  down) cmd_down "$@" ;;
  toggle) cmd_toggle "$@" ;;
  status) if [ "${1:-}" = --json ]; then cmd_status_json; else cmd_status; fi ;;
  menu) cmd_menu ;;
  providers) cmd_providers ;;
  install) cmd_install "$@" ;;
  waybar) cmd_waybar ;;
  ""|-h|--help|help) usage ;;
  *) usage >&2; exit 2 ;;
esac
