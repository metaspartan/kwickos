#!/bin/sh
J= S= NL=
for a in "$@"; do
	case $a in
	--json|-j) J=1 ;;
	--small|-s) S=1 ;;
	--no-logo) NL=1 ;;
	-h|--help) echo "usage: kfetch [--json] [--small] [--no-logo]"; exit 0 ;;
	*) echo "kfetch: unknown option $a" >&2; exit 2 ;;
	esac
done

C=1
{ [ -n "${NO_COLOR:-}" ] || [ "${TERM:-}" = dumb ]; } && C=
[ -t 1 ] || { C=; NL=1; }

L=
f() {
	[ -n "$3" ] || return 0
	L="$L$1|$2|$3
"
}

rel=; [ -r /etc/kwick-release ] && read -r rel < /etc/kwick-release
ed=headless
[ -e /etc/kwick-edition ] && ed=desktop
read -r kr < /proc/sys/kernel/osrelease
arch=$(uname -m)
read -r up _ < /proc/uptime
up=${up%.*}
case $up in ''|*[!0-9]*) up=0 ;; esac
d=$((up / 86400)) h=$((up % 86400 / 3600)) m=$((up % 3600 / 60))
ut=
[ $d -gt 0 ] && ut="${d}d "
[ $((d + h)) -gt 0 ] && ut="$ut${h}h "
ut="$ut${m}m"

mt=0 ma=0
while read -r k v _; do
	case $k in
	MemTotal:) mt=$v ;;
	MemAvailable:) ma=$v; break ;;
	esac
done < /proc/meminfo
mem="$(((mt - ma) / 1024)) MiB / $((mt / 1024)) MiB"

os="${rel:-KwickOS} ($ed) $arch"

if [ -n "$S" ]; then
	f os OS "$os"
	f kernel Kernel "$kr"
	f uptime Uptime "$ut"
	f memory Memory "$mem"
else
	host=
	if [ -r /sys/class/dmi/id/product_name ]; then
		read -r pn < /sys/class/dmi/id/product_name
		sv=; [ -r /sys/class/dmi/id/sys_vendor ] && read -r sv < /sys/class/dmi/id/sys_vendor
		case $pn in "$sv"*) host=$pn ;; *) host="$sv $pn" ;; esac
	elif [ -r /proc/device-tree/model ]; then
		host=$(tr -d '\000' < /proc/device-tree/model)
	fi

	pk=
	set -- /var/lib/dpkg/info/*.list
	[ -e "$1" ] && pk="$# (dpkg)"
	if [ -r /usr/lib/apk/db/installed ]; then
		n=0
		while read -r l; do
			case $l in P:*) n=$((n + 1)) ;; esac
		done < /usr/lib/apk/db/installed
		n=$((n - 1))
		[ $n -gt 0 ] && pk="${pk:+$pk, }$n (apk)"
	fi

	sh=
	[ -r /proc/$PPID/comm ] && read -r sh < /proc/$PPID/comm
	[ -n "$sh" ] || sh=${SHELL##*/}
	case $sh in busybox|sh) sh=ash ;; esac

	init=
	[ -r /proc/1/comm ] && read -r init < /proc/1/comm
	case $init in
	busybox|sh|ash|bash) init="none (container)" ;;
	init) [ -e /run/kinit.ready ] && init=kinit ;;
	esac

	term=${TERM_PROGRAM:-${TERM:-}}

	cm=
	while IFS=: read -r k v; do
		[ -n "$k" ] || { [ -n "$cm" ] && break; continue; }
		case $k in
		"model name"*|Model*|Hardware*|uarch*|Processor*|"cpu model"*) [ -n "$cm" ] || cm=${v# } ;;
		esac
	done < /proc/cpuinfo
	cn=0
	if [ -r /sys/devices/system/cpu/online ]; then
		read -r on < /sys/devices/system/cpu/online
		oldifs=$IFS IFS=,
		for r in $on; do
			case $r in
			*-*) cn=$((cn + ${r#*-} - ${r%-*} + 1)) ;;
			*) cn=$((cn + 1)) ;;
			esac
		done
		IFS=$oldifs
	fi
	[ -n "$cm" ] || cm=$arch
	[ "$cn" = 1 ] && cs=core || cs=cores
	cpu="$cm ($cn $cs)"

	gpu=
	for g in /sys/class/drm/card*; do
		[ -r "$g/device/vendor" ] || continue
		read -r v < "$g/device/vendor"
		drv=
		while IFS== read -r k val; do
			[ "$k" = DRIVER ] && drv=$val
		done < "$g/device/uevent"
		case $v in
		0x1002) gn=AMD ;;
		0x10de) gn=NVIDIA ;;
		0x8086) gn=Intel ;;
		0x1af4) gn=virtio ;;
		0x1234) gn="QEMU Bochs" ;;
		0x15ad) gn=VMware ;;
		0x1b36) gn=QXL ;;
		0x1414) gn=Hyper-V ;;
		0x106b) gn=Apple ;;
		*) gn=$v ;;
		esac
		gpu="${gpu:+$gpu, }$gn${drv:+ ($drv)}"
	done
	if [ -z "$gpu" ] && [ "$ed" = desktop ] && command -v kwick-gpu > /dev/null 2>&1; then
		for t in $(kwick-gpu detect 2>/dev/null); do
			case $t in amd|intel|nvidia|apple|vm) gpu="${gpu:+$gpu, }$t" ;; esac
		done
	fi

	disk=
	set -- $(stat -f -c '%S %b %f %a' / 2>/dev/null)
	if [ $# -eq 4 ] && [ "$2" -gt 0 ]; then
		u=$(($2 - $3))
		um=$((u * $1 / 1048576)) tm=$(($2 * $1 / 1048576))
		pc=$((u * 100 / (u + $4 + 1)))
		if [ $tm -ge 1024 ]; then
			disk="$((um / 1024)).$((um % 1024 * 10 / 1024)) GiB / $((tm / 1024)).$((tm % 1024 * 10 / 1024)) GiB ($pc%)"
		else
			disk="$um MiB / $tm MiB ($pc%)"
		fi
	fi

	set -- $(ip -4 -o addr show scope global 2>/dev/null)
	ip=${4:-}

	f os OS "$os"
	f host Host "$host"
	f kernel Kernel "$kr"
	f uptime Uptime "$ut"
	f packages Packages "$pk"
	f shell Shell "$sh"
	f init Init "$init"
	f terminal Terminal "$term"
	f cpu CPU "$cpu"
	f gpu GPU "$gpu"
	f memory Memory "$mem"
	f disk "Disk (/)" "$disk"
	f ip "Local IP" "$ip"

	if [ "$ed" = desktop ] || [ -n "${XDG_CURRENT_DESKTOP:-}" ]; then
		cfg=${XDG_CONFIG_HOME:-${HOME:-/root}/.config}
		lay=macos
		[ -r "$cfg/kwick/layout" ] && read -r lay < "$cfg/kwick/layout"
		ses=${XDG_CURRENT_DESKTOP:-${DESKTOP_SESSION:-}}
		ses="$ses${XDG_SESSION_TYPE:+ ($XDG_SESSION_TYPE)}"
		cs= ic=
		if [ -r "$cfg/kdeglobals" ]; then
			while IFS== read -r k v; do
				case $k in
				ColorScheme) [ -n "$cs" ] || cs=$v ;;
				Theme) [ -n "$ic" ] || ic=$v ;;
				esac
			done < "$cfg/kdeglobals"
		fi
		if [ -z "$ic" ]; then
			case $lay in windows) ic=KwickOS-Fluent ;; linux) ic=KwickOS-Linux ;; *) ic=KwickOS ;; esac
		fi
		f desktop Desktop "$ses"
		f layout Layout "$lay"
		f theme Theme "${cs:+$cs, }$ic"
	fi
fi

if [ -n "$J" ]; then
	sep=
	printf '{'
	while IFS='|' read -r k _ v; do
		[ -n "$k" ] || continue
		case $v in
		*[\"\\]*) v=$(printf %s "$v" | sed 's/\\/\\\\/g; s/"/\\"/g') ;;
		esac
		printf '%s"%s":"%s"' "$sep" "$k" "$v"
		sep=,
	done <<EOF
$L
EOF
	printf '}\n'
	exit 0
fi

if [ -n "$S" ]; then
	w=7 nr=4
	p1='██ ▄██▀'
	p2='█████  '
	p3='██▀██▄ '
	p4='██  ██▄'
	x1='\033[38;5;50m\033[48;5;44m▀▀\033[49m \033[38;5;44m▄\033[38;5;50m\033[48;5;44m▀▀\033[49m▀\033[0m'
	x2='\033[38;5;44m\033[48;5;80m▀▀▀▀▀\033[49m  \033[0m'
	x3='\033[38;5;74m\033[48;5;69m▀▀\033[49m▀\033[48;5;69m▀▀\033[38;5;69m\033[49m▄ \033[0m'
	x4='\033[38;5;99m██  ██▄\033[0m'
	t1='\033[38;2;16;248;216m\033[48;2;32;232;224m▀▀\033[49m \033[38;2;32;232;224m▄\033[38;2;16;248;216m\033[48;2;32;232;224m▀▀\033[49m▀\033[0m'
	t2='\033[38;2;48;216;224m\033[48;2;56;208;232m▀▀▀▀▀\033[49m  \033[0m'
	t3='\033[38;2;80;176;232m\033[48;2;104;144;240m▀▀\033[49m▀\033[48;2;104;144;240m▀▀\033[38;2;104;144;240m\033[49m▄ \033[0m'
	t4='\033[38;2;128;112;240m\033[48;2;152;72;248m▀▀\033[49m  \033[48;2;152;72;248m▀▀\033[38;2;152;72;248m\033[49m▄\033[0m'
else
	w=17 nr=11
	p1='█████     ▄█████▀'
	p2='█████    ▄█████  '
	p3='█████   ▄████▀   '
	p4='█████  █████▀    '
	p5='█████▄█████      '
	p6='███████████      '
	p7='█████ ▀█████     '
	p8='█████  ▀█████    '
	p9='█████    █████▄  '
	p10='█████     █████▄ '
	p11='█████      █████▄'
	x1='\033[38;5;50m█████     ▄█████▀\033[0m'
	x2='\033[38;5;50m\033[48;5;44m▀▀▀▀▀\033[49m    \033[38;5;44m▄\033[38;5;50m\033[48;5;44m▀▀▀▀▀\033[49m  \033[0m'
	x3='\033[38;5;44m█████   ▄████▀   \033[0m'
	x4='\033[38;5;44m\033[48;5;80m▀▀▀▀▀\033[49m  \033[48;5;80m▀▀▀▀▀\033[49m▀    \033[0m'
	x5='\033[38;5;80m█████▄█████      \033[0m'
	x6='\033[38;5;80m\033[48;5;74m▀▀▀▀▀▀▀▀▀▀▀\033[49m      \033[0m'
	x7='\033[38;5;74m\033[48;5;75m▀▀▀▀▀\033[49m ▀\033[48;5;75m▀▀▀▀▀\033[49m     \033[0m'
	x8='\033[38;5;75m\033[48;5;69m▀▀▀▀▀\033[49m  ▀\033[48;5;69m▀▀▀▀▀\033[49m    \033[0m'
	x9='\033[38;5;69m\033[48;5;105m▀▀▀▀▀\033[49m    \033[48;5;105m▀▀▀▀▀\033[38;5;105m\033[49m▄  \033[0m'
	x10='\033[38;5;99m█████     █████▄ \033[0m'
	x11='\033[38;5;99m█████      █████▄\033[0m'
	t1='\033[38;2;16;248;216m\033[48;2;16;240;216m▀▀▀▀▀\033[49m     \033[38;2;16;240;216m▄\033[38;2;16;248;216m\033[48;2;16;240;216m▀▀▀▀▀\033[49m▀\033[0m'
	t2='\033[38;2;24;240;216m\033[48;2;32;232;224m▀▀▀▀▀\033[49m    \033[38;2;32;232;224m▄\033[38;2;24;240;216m\033[48;2;32;232;224m▀▀▀▀▀\033[49m  \033[0m'
	t3='\033[38;2;32;232;224m\033[48;2;40;224;224m▀▀▀▀▀\033[49m   \033[38;2;40;224;224m▄\033[38;2;32;232;224m\033[48;2;40;224;224m▀▀▀▀\033[49m▀   \033[0m'
	t4='\033[38;2;48;216;224m█████  █████▀    \033[0m'
	t5='\033[38;2;56;208;224m\033[48;2;56;208;232m▀▀▀▀▀\033[38;2;56;208;232m\033[49m▄\033[38;2;56;208;224m\033[48;2;56;208;232m▀▀▀▀▀\033[49m      \033[0m'
	t6='\033[38;2;64;200;232m\033[48;2;72;192;232m▀▀▀▀▀▀▀▀▀▀▀\033[49m      \033[0m'
	t7='\033[38;2;80;176;232m\033[48;2;88;168;240m▀▀▀▀▀\033[49m ▀\033[48;2;88;168;240m▀▀▀▀▀\033[49m     \033[0m'
	t8='\033[38;2;96;160;240m\033[48;2;104;144;240m▀▀▀▀▀\033[49m  ▀\033[48;2;104;144;240m▀▀▀▀▀\033[49m    \033[0m'
	t9='\033[38;2;112;128;240m\033[48;2;120;120;240m▀▀▀▀▀\033[49m    \033[48;2;120;120;240m▀▀▀▀▀\033[38;2;120;120;240m\033[49m▄  \033[0m'
	t10='\033[38;2;128;112;240m\033[48;2;136;96;248m▀▀▀▀▀\033[49m     \033[48;2;136;96;248m▀▀▀▀▀\033[38;2;136;96;248m\033[49m▄ \033[0m'
	t11='\033[38;2;144;80;248m\033[48;2;152;72;248m▀▀▀▀▀\033[49m      \033[48;2;152;72;248m▀▀▀▀▀\033[38;2;152;72;248m\033[49m▄\033[0m'
fi

M=p
if [ -n "$C" ]; then
	M=x LC='\033[1;38;5;80m'
	if [ "${COLORTERM:-}" = truecolor ] || [ "${COLORTERM:-}" = 24bit ]; then
		M=t LC='\033[1;38;2;66;198;232m'
	fi
fi

pad=$(printf '%*s' $w '')
i=0
while IFS='|' read -r k lb v; do
	[ -n "$k" ] || continue
	if [ -z "$NL" ]; then
		eval "g=\${$M$((i + 1)):-}"
		if [ -n "$g" ]; then
			printf '%b  ' "$g"
		else
			printf '%s  ' "$pad"
		fi
	fi
	if [ -n "$C" ]; then
		printf '%b%s\033[0m: %s\n' "$LC" "$lb" "$v"
	else
		printf '%s: %s\n' "$lb" "$v"
	fi
	i=$((i + 1))
done <<EOF
$L
EOF
if [ -z "$NL" ]; then
	while [ $i -lt $nr ]; do
		eval "g=\$$M$((i + 1))"
		printf '%b\n' "$g"
		i=$((i + 1))
	done
fi
