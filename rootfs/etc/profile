export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
export LANG="${LANG:-C.UTF-8}"
export PAGER="${PAGER:-less}"
export EDITOR="${EDITOR:-vi}"
umask 022

if [ -n "${TERM:-}" ] && [ "$TERM" != dumb ]; then
	t1=$(printf '%.1s' "$TERM")
	if [ ! -e "/usr/share/terminfo/$t1/$TERM" ] && [ ! -e "/usr/lib/terminfo/$t1/$TERM" ] && [ ! -e "/etc/terminfo/$t1/$TERM" ] && [ ! -e "$HOME/.terminfo/$t1/$TERM" ]; then
		case "$TERM" in
			*256color*) TERM=xterm-256color ;;
			screen*) TERM=screen ;;
			tmux*) TERM=tmux ;;
			*) TERM=xterm ;;
		esac
		export TERM
	fi
	unset t1
fi

if [ -z "${BASH_VERSION:-}${ZSH_VERSION:-}" ]; then
	ENV=/etc/ashrc
	export ENV
fi
case $- in
*i*) [ -z "${ZSH_VERSION:-}" ] && [ -r /etc/ashrc ] && . /etc/ashrc ;;
esac

for f in /etc/profile.d/*.sh; do [ -r "$f" ] && . "$f"; done
unset f
KWICK_ENV=1
export KWICK_ENV
