#!/bin/sh
set -e
APPS="${*:-com.valvesoftware.Steam net.davidotek.pupgui2 com.heroicgameslauncher.hgl net.lutris.Lutris}"
flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
echo "Installing: $APPS"
flatpak install -y --noninteractive flathub $APPS
echo
echo "Done. GameMode (gamemoderun %command%) and MangoHud (mangohud %command%) are"
echo "preinstalled; in Steam enable Proton under Settings > Compatibility."
