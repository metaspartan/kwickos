#!/bin/sh
case ${1:-plasma} in
  gamescope|game) target=game ;;
  *-persistent) target=desktop-persistent ;;
  *) target=desktop ;;
esac
STATE=${XDG_STATE_HOME:-$HOME/.local/state}/kwick
sudo -n /usr/bin/kwick-gaming session-select "$target" >/dev/null 2>&1

end_session() {
  sid=${XDG_SESSION_ID:-$(loginctl show-user "$(id -un)" -p Display --value 2>/dev/null)}
  if [ -n "$sid" ]; then loginctl terminate-session "$sid"; else loginctl terminate-user "$(id -un)"; fi
}

if [ "${XDG_CURRENT_DESKTOP:-}" = gamescope ]; then
  mkdir -p "$STATE" && : > "$STATE/gamemode-switching"
  if pgrep -u "$(id -u)" -x steam >/dev/null 2>&1; then
    steam -shutdown >/dev/null 2>&1 &
    sleep 20
  fi
  [ -n "${KWICK_GAMEMODE_PID:-}" ] && pkill -TERM -P "$KWICK_GAMEMODE_PID" && exit 0
  end_session
  exit 0
fi

case ${XDG_CURRENT_DESKTOP:-} in
  *KDE*) dbus-send --session --print-reply --dest=org.kde.Shutdown /Shutdown org.kde.Shutdown.logout >/dev/null && exit 0 ;;
  *GNOME*) gnome-session-quit --logout --no-prompt && exit 0 ;;
esac
end_session
