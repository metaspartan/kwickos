#!/bin/sh
SELF=$(readlink -f "$0")
LIBDIR=/usr/lib/kwick/agents
. "$LIBDIR/lib.sh"

MODULES="cybara inference"
for m in $MODULES; do . "$LIBDIR/$m.sh"; done

fn() { echo "$1" | tr - _; }

valid() {
  case " $MODULES " in *" $1 "*) return 0 ;; esac
  return 1
}

usage() {
  cat <<EOF
usage: $PROG <command>
  list                       modules and what they provide
  status [--machine]         installed state of every module
  install [--latest] <module...>
                             install modules (--latest: newest vendor release
                             instead of the version pinned by KwickOS)
  remove <module...>         remove modules
  all                        install every module this machine supports
modules: $MODULES
EOF
}

mod_state() {
  f=$(fn "$1")
  s=$(${f}_state)
  if [ "$s" = na ] && type "${f}_why" >/dev/null 2>&1; then echo "na|$(${f}_why)"; return 0; fi
  if ! has_arch "$(${f}_arch)"; then echo "na|not available on $ARCH"; return 0; fi
  echo "$s|"
}

state_label() {
  case $1 in
    yes) echo installed ;;
    no) echo - ;;
    na) echo unavailable ;;
  esac
}

cmd_list() {
  for m in $MODULES; do
    f=$(fn "$m")
    printf '%-12s %-12s %s\n' "$m" "$(${f}_arch | tr ' ' ',' | sed 's/amd64,arm64,riscv64/all/')" "$(${f}_desc)"
  done
}

cmd_status() {
  machine=""
  [ "${1:-}" = --machine ] && machine=1
  for m in $MODULES; do
    f=$(fn "$m")
    IFS='|' read -r st note <<EOF
$(mod_state "$m")
EOF
    if [ -n "$machine" ]; then
      printf '%s|%s|%s|%s\n' "$m" "$st" "$(${f}_desc)" "$note"
    else
      printf '%-12s %-12s %s\n' "$m" "$(state_label "$st")" "${note:-$(${f}_desc)}"
    fi
  done
}

parse_flags() {
  rest=""
  for a; do
    case $a in
      --latest) AGENTS_LATEST=1; export AGENTS_LATEST ;;
      *) rest="$rest $a" ;;
    esac
  done
  REST=${rest# }
}

cmd_install() {
  parse_flags "$@"
  set -- $REST
  [ $# -gt 0 ] || { usage; exit 2; }
  for m; do valid "$m" || die "unknown module '$m' (see: $PROG list)"; done
  need_root install ${AGENTS_LATEST:+--latest} "$@"
  rc=0
  for m; do
    f=$(fn "$m")
    if ! has_arch "$(${f}_arch)"; then
      warn "$m is not available on $ARCH"
      rc=1
      continue
    fi
    say "== $m"
    if ${f}_install; then say "$m: done"; else warn "$m: failed"; rc=1; fi
  done
  exit $rc
}

cmd_remove() {
  [ $# -gt 0 ] || { usage; exit 2; }
  for m; do valid "$m" || die "unknown module '$m' (see: $PROG list)"; done
  need_root remove "$@"
  rc=0
  for m; do
    f=$(fn "$m")
    say "== $m"
    if ${f}_remove; then say "$m: removed"; else warn "$m: failed"; rc=1; fi
  done
  exit $rc
}

cmd_all() {
  parse_flags "$@"
  list=""
  for m in $MODULES; do
    IFS='|' read -r st _ <<EOF
$(mod_state "$m")
EOF
    [ "$st" = na ] && continue
    list="$list $m"
  done
  [ -n "$list" ] || die "no module is available on this machine"
  need_root all ${AGENTS_LATEST:+--latest}
  cmd_install ${AGENTS_LATEST:+--latest} $list
}

cmd=${1:-}
[ $# -gt 0 ] && shift
case $cmd in
  list) cmd_list ;;
  status) cmd_status "$@" ;;
  install) cmd_install "$@" ;;
  remove) cmd_remove "$@" ;;
  all) cmd_all "$@" ;;
  ""|help|-h|--help) usage; echo; cmd_status ;;
  *) usage; exit 2 ;;
esac
