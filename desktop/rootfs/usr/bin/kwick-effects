#!/bin/sh
set -u
cfg=${XDG_CONFIG_HOME:-$HOME/.config}/kwick; mkdir -p "$cfg"
state="$cfg/effects.state"
touch "$state"

usage() { cat <<'USAGE'
kwick-effects: window effects for KDE Plasma, GNOME and Hyprland.
  kwick-effects off|subtle|fluid|full     apply a preset (no argument: show the current one)
  kwick-effects status                    one line per effect: name on|off|na
  kwick-effects open-close [STYLE]        open/close animation (no style: print the current one)
  kwick-effects open-close list           every style as name|on|off|na|label|description
  kwick-effects param duration [MS]       length of the current open/close animation (no value: print)
  kwick-effects wobbly AMOUNT CURVE       wobble amount and sway, each 1-10 (no argument: fluid preset)
  kwick-effects param wobbly              print the wobble amount and sway
  kwick-effects flame-style [NAME]        flame look: classic|inferno|ember|blue|legacy (no name: print)
  kwick-effects flame-height [50-200]     how high the flames rise, in percent (no value: print)
  kwick-effects param depth [0-10]        how far windows lift off the cube faces (no value: print)
  kwick-effects param flip [STYLE]        3D open/close style: flip|door|tilt (no style: print)
  kwick-effects set NAME on|off           toggle one effect (preset becomes "custom")
  kwick-effects switch [slide|fade|cube|none]    desktop switch animation
  kwick-effects tabbox [windows|cover|flip|grid] Alt+Tab style (KDE)
  kwick-effects check                     compositor: gpu|software|none
  kwick-effects backend                   kde|gnome|hyprland|sway|none
  kwick-effects auto                      at login: Liquid Glass on with a GPU, off on software rendering
NAME: wobbly lamp blur transparency sheet dim overview cube liquidglass, or any open/close STYLE
STYLE: none scale fade glide flip flame dissolve fallapart, and the Burn My Windows effects
       apparition aura-glow broken-glass doom energize-a energize-b fire focus glitch hexagon
       incinerate matrix mushroom paint-brush pixelate pixel-wheel pixel-wipe portal rgbwarp
       snap team-rocket trex tv tv-glitch wisps (open-close list shows which work here)
  off      no animations
  subtle   scale open/close, fades, blur, sliding popups, magic lamp
  fluid    plus curvy wobbly windows, sheets, 3D flip open/close and Liquid Glass
  full     plus flame open/close, translucency, dimmed inactive windows, 3D cube
USAGE
}

OC_TABLE='none|-|-|None|Windows appear and disappear at once
scale|scale|=|Scale|Windows zoom in and out, like macOS and Windows
fade|fade|-|Fade|Windows fade in and out
glide|glide|glide|Glide|Windows tilt in and out in 3D
flip|kwick_flip|-|3D Flip|Windows swing in and out in perspective with lighting
flame|kwick_flame|-|Flame|Windows ignite when they open and burn away when they close
dissolve|kwick_dissolve|-|Dissolve|Closing windows crumble into glowing dust
fallapart|fallapart|-|Fall Apart|Closing windows shatter into pieces
apparition|-|apparition|Apparition|Windows twirl and fade like a ghost
aura-glow|kwin6_effect_aura_glow|aura-glow|Aura Glow|A soft glow rims the window as it fades
broken-glass|-|broken-glass|Broken Glass|Windows shatter like a pane of glass
doom|kwin6_effect_doom|doom|Doom|Windows melt down like the Doom screen wipe
energize-a|kwin6_effect_energize_a|energize-a|Energize A|Windows beam in and out in sparkles
energize-b|kwin6_effect_energize_b|energize-b|Energize B|Windows beam in and out in a shimmer
fire|kwin6_effect_fire|fire|Fire|Windows go up in a wall of fire
focus|kwin6_effect_focus|focus|Focus|Windows blur in and out of focus
glitch|kwin6_effect_glitch|glitch|Glitch|Windows break up into digital glitches
hexagon|kwin6_effect_hexagon|hexagon|Hexagon|Windows dissolve into a honeycomb
incinerate|kwin6_effect_incinerate|incinerate|Incinerate|Windows burn away from a glowing spark
matrix|-|matrix|Matrix|Windows rain down as green code
mushroom|-|mushroom|Mushroom|Windows warp like a retro power-up
paint-brush|-|paint-brush|Paint Brush|Windows are painted on and wiped off with a brush
pixelate|kwin6_effect_pixelate|pixelate|Pixelate|Windows break into fading pixels
pixel-wheel|kwin6_effect_pixel_wheel|pixel-wheel|Pixel Wheel|Pixels spin away like a wheel
pixel-wipe|kwin6_effect_pixel_wipe|pixel-wipe|Pixel Wipe|Pixels wipe across the window
portal|kwin6_effect_portal|portal|Portal|Windows swirl through a portal
rgbwarp|kwin6_effect_rgbwarp|rgbwarp|RGB Warp|Colour channels split and warp
snap|-|snap|Snap|Windows turn to dust and blow away
team-rocket|kwin6_effect_team_rocket|team-rocket|Team Rocket|Windows blast off into the sky with a twinkle
trex|-|trex|T-Rex Attack|Claw marks tear the window apart
tv|kwin6_effect_tv|tv|TV|Windows switch off like an old TV
tv-glitch|kwin6_effect_tv_glitch|tv-glitch|TV Glitch|An old TV switches off with a glitch
wisps|kwin6_effect_wisps|wisps|Wisps|Windows scatter into glowing wisps'

ocf() { printf '%s\n' "$OC_TABLE" | awk -F'|' -v n="$1" -v f="$2" '$1 == n { print $f; exit }'; }
oc_names() { printf '%s\n' "$OC_TABLE" | cut -d'|' -f1; }
oc_kde_ids() { printf '%s\n' "$OC_TABLE" | cut -d'|' -f2 | grep -v '^-$'; }
oc_gnome_nicks() { printf '%s\n' "$OC_TABLE" | cut -d'|' -f3 | grep -v '^[-=]$'; }
is_oc() { [ -n "$(ocf "$1" 1)" ]; }

backend() {
  d=$(printf '%s' "${XDG_CURRENT_DESKTOP:-}" | tr 'A-Z' 'a-z')
  if [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then echo hyprland; return; fi
  case $d in
    *kde*) echo kde ;;
    *gnome*|*unity*|*ubuntu*) echo gnome ;;
    *hyprland*) echo hyprland ;;
    *sway*) echo sway ;;
    "") if command -v kwriteconfig6 >/dev/null 2>&1 && [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]; then echo kde; else echo none; fi ;;
    *) echo none ;;
  esac
}
be=$(backend)

b() { [ "$1" = 1 ] && echo true || echo false; }
q() { qdbus6 "$@" 2>/dev/null; }
kw() { kwriteconfig6 --file "$1" --group "$2" --key "$3" "$4"; }
plug() { kwriteconfig6 --file kwinrc --group Plugins --key "$1Enabled" "$(b "$2")"; }
isplug() { [ "$(kreadconfig6 --file kwinrc --group Plugins --key "$1Enabled" --default "$2")" = true ]; }
touched=""
pl() { plug "$1" "$2"; touched="$touched $1"; }

rcfg() { q org.kde.KWin /Effects org.kde.kwin.Effects.reconfigureEffect "$1" >/dev/null; }

reload() {
  q org.kde.KWin /KWin reconfigure >/dev/null
  for id in $touched; do
    if isplug "$id" false; then
      q org.kde.KWin /Effects org.kde.kwin.Effects.loadEffect "$id" >/dev/null
    else
      q org.kde.KWin /Effects org.kde.kwin.Effects.unloadEffect "$id" >/dev/null
    fi
  done
}

gl() {
  case $be in
    kde) ;;
    *) echo gpu; return ;;
  esac
  t=$(q org.kde.KWin /Compositor org.kde.kwin.Compositing.compositingType)
  case "$t" in
    gl*|opengl*) ;;
    *) echo none; return ;;
  esac
  r=$(q org.kde.KWin /KWin org.kde.KWin.supportInformation | grep -i 'OpenGL renderer string' | head -1)
  case "$r" in *llvmpipe*|*softpipe*|*swrast*|*"Software Rasterizer"*) echo software; return ;; esac
  echo gpu
}
need_gpu() {
  case $(gl) in
    gpu) return 0 ;;
    software) echo "note: KWin renders with a software OpenGL driver (llvmpipe); KWin disables animations there." >&2 ;;
    *) echo "note: the compositor is not running with OpenGL, so effects cannot animate." >&2 ;;
  esac
  echo "      install GPU drivers: sudo apt install kwick-gpu (or run: kwick-gpu install), then log in again." >&2
  return 1
}

kde_avail=""
kde_have() {
  [ -n "$kde_avail" ] || kde_avail=" $(q org.kde.KWin /Effects org.kde.kwin.Effects.listOfEffects | tr '\n' ' ')"
  [ "$kde_avail" = " " ] || case "$kde_avail" in *" $1 "*) ;; *) return 1 ;; esac
}
oc() {
  for id in $(oc_kde_ids); do pl $id 0; done
  k=$(ocf "$1" 2)
  [ "$k" = - ] || pl "$k" 1
}
oc_now() {
  for n in $(oc_names); do
    k=$(ocf $n 2)
    [ "$k" = - ] && continue
    isplug "$k" "$([ "$k" = scale ] && echo true || echo false)" && { echo $n; return; }
  done
  echo none
}
oc_state_kde() {
  k=$(ocf "$1" 2)
  if [ "$1" != none ] && { [ "$k" = - ] || ! kde_have "$k"; }; then echo na
  elif [ "$2" = "$1" ]; then echo on
  else echo off; fi
}
kde_dur_default() {
  f=/usr/share/kwin/effects/$1/contents/config/main.xml
  if [ -f "$f" ]; then sed -n '/name="Duration"/,/<\/entry>/s/.*<default>\([0-9]*\)<.*/\1/p' "$f" | head -1
  elif [ "$1" = kwick_flip ]; then echo 700; fi
}
lamp() {
  pl magiclamp "$1"; pl squash "$([ "$1" = 1 ] && echo 0 || echo 1)"
  [ "$1" = 1 ] && kw kwinrc Effect-magiclamp AnimationDuration 650
  return 0
}
blurfx() { pl blur "$1"; pl contrast "$1"; }
glass_ok() { ls /usr/lib/*/qt6/plugins/kwin/effects/plugins/kwick_liquidglass.so >/dev/null 2>&1; }
glass_theme() { [ -x /usr/lib/kwick/liquidglass-theme ] && /usr/lib/kwick/liquidglass-theme "$1" >/dev/null 2>&1; return 0; }
glass() {
  if [ "$1" = 1 ] && glass_ok && [ "$(gl)" = gpu ]; then
    pl blur 1; pl kwick_liquidglass 1; pl kwin4_effect_shapecorners 0; glass_theme on
    for k in Menus DropdownMenus PopupMenus; do kw kwinrc Effect-translucency $k 100; done
  else
    pl kwick_liquidglass 0; [ -n "$(ls /usr/lib/*/qt6/plugins/kwin/effects/plugins/kwin4_effect_shapecorners.so 2>/dev/null)" ] && pl kwin4_effect_shapecorners 1; glass_theme off
  fi
  return 0
}
popups() { pl slidingpopups "$1"; pl fadingpopups "$1"; }
helpers() { for id in maximize login logout sessionquit dialogparent; do pl $id "$1"; done; }
wob_amount() { v=$(get_fx wobble_amount); case $v in [1-9]|10) echo "$v" ;; *) echo 6 ;; esac; }
wob_curve() { v=$(get_fx wobble_curve); case $v in [1-9]|10) echo "$v" ;; *) echo 7 ;; esac; }
clampn() { case $1 in ''|*[!0-9]*) echo "$2" ;; *) if [ "$1" -lt 1 ]; then echo 1; elif [ "$1" -gt 10 ]; then echo 10; else echo "$1"; fi ;; esac; }
kde_wobbly_apply() {
  a=$(wob_amount); c=$(wob_curve)
  kw kwinrc Effect-wobblywindows Settings Custom
  kw kwinrc Effect-wobblywindows Stiffness $((17 - c * 3 / 2))
  kw kwinrc Effect-wobblywindows Drag $((78 + c * 19 / 10))
  kw kwinrc Effect-wobblywindows MoveFactor $((8 + a * 3))
  kw kwinrc Effect-wobblywindows XTesselation $((14 + c * 3))
  kw kwinrc Effect-wobblywindows YTesselation $((14 + c * 3))
  kw kwinrc Effect-wobblywindows StopVelocity 0.3
  kw kwinrc Effect-wobblywindows StopAcceleration 3
  kw kwinrc Effect-wobblywindows MoveWobble true
  kw kwinrc Effect-wobblywindows ResizeWobble true
}
gnome_wobbly_apply() {
  d=$(gx_dir "$GX_WOBBLY")/schemas || return 0
  [ -d "$d" ] || return 0
  a=$(wob_amount); c=$(wob_curve)
  sc=$(ls "$d"/*.gschema.xml 2>/dev/null | head -1 | sed 's|.*/||; s|\.gschema\.xml$||')
  [ -n "$sc" ] || return 0
  gsettings --schemadir "$d" set $sc friction "$(awk "BEGIN{print 11 - $c}")" 2>/dev/null || true
  gsettings --schemadir "$d" set $sc spring-k "$(awk "BEGIN{print 1 + $a * 0.8}")" 2>/dev/null || true
  gsettings --schemadir "$d" set $sc x-tiles "$((8 + c * 2))" 2>/dev/null || true
  gsettings --schemadir "$d" set $sc y-tiles "$((8 + c * 2))" 2>/dev/null || true
}
flame_style_get() { case $(kreadconfig6 --file kwinrc --group Effect-kwick_flame --key Style --default 0) in 1) echo inferno ;; 2) echo ember ;; 3) echo blue ;; 4) echo legacy ;; *) echo classic ;; esac; }
flame_style_set() {
  case "$1" in classic) n=0 ;; inferno) n=1 ;; ember) n=2 ;; blue) n=3 ;; legacy) n=4 ;; *) echo "style: classic|inferno|ember|blue|legacy" >&2; return 1 ;; esac
  kw kwinrc Effect-kwick_flame Style $n
}
depth_get() {
  v=$(kreadconfig6 --file kwinrc --group Effect-kwick_cubeslide --key WindowLift --default 100)
  v=${v%.*}
  echo $(( (v + 10) / 20 ))
}
depth_set() {
  case "$1" in ''|*[!0-9]*) echo "depth: 0-10" >&2; return 1 ;; esac
  v=$1; [ "$v" -gt 10 ] && v=10
  kw kwinrc Effect-kwick_cubeslide WindowLift $((v * 20))
}
flame_height_get() { kreadconfig6 --file kwinrc --group Effect-kwick_flame --key Height --default 100; }
flame_height_set() {
  case "$1" in ''|*[!0-9]*) echo "height: 50-200" >&2; return 1 ;; esac
  v=$1; [ "$v" -lt 50 ] && v=50; [ "$v" -gt 200 ] && v=200
  kw kwinrc Effect-kwick_flame Height $v
}
flip_style_get() { case $(kreadconfig6 --file kwinrc --group Effect-kwick_flip --key Style --default 0) in 1) echo door ;; 2) echo tilt ;; *) echo flip ;; esac; }
flip_style_set() {
  case "$1" in flip) n=0 ;; door|fold) n=1 ;; tilt) n=2 ;; *) echo "style: flip|door|tilt" >&2; return 1 ;; esac
  kw kwinrc Effect-kwick_flip Style $n
}
cube_ok() { [ -e /usr/share/kwin/effects/cube/metadata.json ]; }
desktops() {
  n=$(kreadconfig6 --file kwinrc --group Desktops --key Number --default 1)
  if [ "$n" -lt "$1" ]; then kw kwinrc Desktops Number "$1"; kw kwinrc Desktops Rows 1; fi
}

kde_switch_set() {
  case "$1" in
    slide) pl slide 1; pl fadedesktop 0; pl kwick_cubeslide 0 ;;
    fade) pl slide 0; pl fadedesktop 1; pl kwick_cubeslide 0 ;;
    none) pl slide 0; pl fadedesktop 0; pl kwick_cubeslide 0 ;;
    cube) [ -e /usr/share/kwin/effects/kwick_cubeslide/metadata.json ] || { echo "cube transition not installed" >&2; return 1; }
          desktops 4; pl slide 0; pl fadedesktop 0; pl kwick_cubeslide 1 ;;
    *) return 1 ;;
  esac
  return 0
}
kde_switch_get() {
  if isplug kwick_cubeslide false; then echo cube
  elif isplug fadedesktop false; then echo fade
  elif isplug slide true; then echo slide
  else echo none; fi
}

kde_tabbox_set() {
  case "$1" in
    windows) l=thumbnail_grid ;;
    cover) l=coverswitch ;;
    flip) l=flipswitch ;;
    grid) l=big_icons ;;
    *) return 1 ;;
  esac
  [ -d "/usr/share/kwin/tabbox/$l" ] || { echo "tabbox layout $l not installed (apt install kwin-addons)" >&2; return 1; }
  kw kwinrc TabBox LayoutName "$l"
}
kde_tabbox_get() {
  case $(kreadconfig6 --file kwinrc --group TabBox --key LayoutName --default thumbnail_grid) in
    coverswitch) echo cover ;;
    flipswitch) echo flip ;;
    big_icons) echo grid ;;
    *) echo windows ;;
  esac
}

preset_kde() {
  set_fx liquidglass_user ""
  case $1 in
    off)    oc none; lamp 0; pl cube 0; pl wobblywindows 0; blurfx 0; glass 0; pl translucency 0; pl sheet 0; pl diminactive 0; popups 0; helpers 0; kde_switch_set none; factor=0 ;;
    subtle) oc scale; lamp 1; pl cube 0; pl wobblywindows 0; blurfx 1; glass 0; pl translucency 0; pl sheet 0; pl diminactive 0; popups 1; helpers 1; kde_switch_set slide; kde_tabbox_set windows; factor=0.7 ;;
    fluid)  oc flip; lamp 1; pl cube 0; pl wobblywindows 1; kde_wobbly_apply; blurfx 1; glass 1; pl translucency 0; pl sheet 1; pl diminactive 0; popups 1; helpers 1; kde_switch_set slide; kde_tabbox_set windows; factor=0.8 ;;
    full)   oc flame; lamp 1; pl wobblywindows 1; kde_wobbly_apply; blurfx 1; glass 1; pl translucency 1; pl sheet 1; pl diminactive 1; popups 1; helpers 1; factor=1
            kde_switch_set cube || kde_switch_set slide
            cube_ok && { desktops 4; pl cube 1; kw kwinrc Effect-cube CubeFaceDisplacement 120; }
            kde_tabbox_set cover || kde_tabbox_set windows
            kw kwinrc Effect-blur BlurStrength 12
            kw kwinrc Effect-blur NoiseStrength 4
            kw kwinrc Effect-translucency Dialogs 92
            kw kwinrc Effect-translucency Inactive 88
            isplug kwick_liquidglass false || kw kwinrc Effect-translucency Menus 95
            kw kwinrc Effect-diminactive Strength 22 ;;
  esac
  [ "$1" != full ] && { kw kwinrc Effect-blur BlurStrength 7; kw kwinrc Effect-blur NoiseStrength 2; }
  kw kdeglobals KDE AnimationDurationFactor "$factor"
  return 0
}

kde_status() {
  s() { if isplug "$2" "$3"; then echo "$1 on"; else echo "$1 off"; fi; }
  s wobbly wobblywindows false
  s lamp magiclamp false
  s blur blur true
  s transparency translucency false
  s sheet sheet false
  s dim diminactive false
  s overview overview true
  if cube_ok; then s cube cube false; else echo "cube na"; fi
  if glass_ok; then s liquidglass kwick_liquidglass false; else echo "liquidglass na"; fi
}

kde_set() {
  name=$1 v=$([ "$2" = on ] && echo 1 || echo 0)
  case $name in
    wobbly) [ $v = 1 ] && kde_wobbly_apply; pl wobblywindows $v ;;
    lamp) lamp $v ;;
    blur) blurfx $v; [ $v = 0 ] && glass 0 ;;
    liquidglass) glass_ok || { echo "Liquid Glass is not installed" >&2; return 1; }
          [ $v = 1 ] && [ "$(gl)" != gpu ] && { echo "Liquid Glass needs GPU rendering; it stays off with software OpenGL" >&2; glass 0; return 1; }
          set_fx liquidglass_user "$2"; glass $v ;;
    transparency) pl translucency $v ;;
    sheet) pl sheet $v ;;
    dim) pl diminactive $v ;;
    overview) pl overview $v; pl windowview $v ;;
    cube) cube_ok || { echo "cube effect not installed (apt install kwin-addons)" >&2; return 1; }
          [ $v = 1 ] && { desktops 4; kw kwinrc Effect-cube CubeFaceDisplacement 120; }
          pl cube $v ;;
    *) echo "unknown effect: $name" >&2; return 1 ;;
  esac
}

CZ=com''piz
GX_WOBBLY=${CZ}-windows-effect@hermes83.github.com
GX_LAMP=${CZ}-alike-magic-lamp-effect@hermes83.github.com
GX_BURN=burn-my-windows@schneegans.github.com
GX_CUBE=desktop-cube@schneegans.github.com
GX_BLUR=blur-my-shell@aunetx
BURN_SCHEMA=org.gnome.shell.extensions.burn-my-windows

gx_uuid() {
  case $1 in
    wobbly) echo $GX_WOBBLY ;; lamp) echo $GX_LAMP ;; burn) echo $GX_BURN ;;
    cube) echo $GX_CUBE ;; blur) echo $GX_BLUR ;; *) return 1 ;;
  esac
}
gx_dir() {
  for d in "/usr/share/gnome-shell/extensions/$1" "$HOME/.local/share/gnome-shell/extensions/$1"; do
    [ -d "$d" ] && { echo "$d"; return 0; }
  done
  return 1
}
gx_have() { gx_dir "$1" >/dev/null; }
gx_set() {
  u=$(gx_uuid "$1") || return 1
  gx_have "$u" || { echo "$1: extension is not installed (run: sudo /usr/lib/kwick/fetch-effects / gnome)" >&2; return 1; }
  if [ "$2" = on ]; then gnome-extensions enable "$u" 2>/dev/null; else gnome-extensions disable "$u" 2>/dev/null; fi
  return 0
}
gx_on() { gnome-extensions list --enabled 2>/dev/null | grep -qx "$1"; }
gnome_status() {
  for n in wobbly lamp cube blur; do
    u=$(gx_uuid $n)
    if ! gx_have "$u"; then echo "$n na"; elif gx_on "$u"; then echo "$n on"; else echo "$n off"; fi
  done
  for n in transparency sheet dim liquidglass; do echo "$n na"; done
  echo "overview on"
}
gnome_oc_now() {
  gx_on $GX_BURN || { echo scale; return; }
  v=$(get_fx open_close)
  case $(ocf "$v" 3) in ''|-|=) echo fire ;; *) echo "$v" ;; esac
}
oc_state_gnome() {
  case $(ocf "$1" 3) in
    -) echo na; return ;;
    =) ;;
    *) gx_have $GX_BURN || { echo na; return; } ;;
  esac
  [ "$2" = "$1" ] && echo on || echo off
}
gnome_dur_default() {
  d=$(gx_dir $GX_BURN) || return 0
  sed -n "/name=\"$1-animation-time\"/,/<\/key>/s/.*<default>\([0-9]*\)<.*/\1/p" "$d"/schemas/*profile*.gschema.xml 2>/dev/null | head -1
}
gnome_burn_profile() {
  d=$(gx_dir $GX_BURN) || return 0
  n=$(gnome_oc_now); g=$(ocf "$n" 3)
  p=${XDG_CONFIG_HOME:-$HOME/.config}/burn-my-windows/profiles
  f=$p/kwickos.conf
  mkdir -p "$p"
  {
    echo "[burn-my-windows-profile]"
    echo "profile-high-priority=true"
    for x in $(oc_gnome_nicks); do echo "$x-enable-effect=$([ "$x" = "$g" ] && echo true || echo false)"; done
    ms=$(get_fx "duration_$n")
    [ -n "$ms" ] && echo "$g-animation-time=$ms"
  } > "$f"
  gsettings --schemadir "$d/schemas" set $BURN_SCHEMA active-profile "" 2>/dev/null || true
  gsettings --schemadir "$d/schemas" set $BURN_SCHEMA active-profile "$f" 2>/dev/null || true
}
gnome_oc() {
  case $(ocf "$1" 3) in
    ''|-) echo "$1 is not available on GNOME" >&2; return 1 ;;
    =) set_fx open_close "$1"; gx_set burn off ;;
    *) gx_have $GX_BURN || { echo "Burn My Windows is not installed (run: sudo /usr/lib/kwick/fetch-effects / burn)" >&2; return 1; }
       set_fx open_close "$1"; gx_set burn on; gnome_burn_profile ;;
  esac
}
preset_gnome() {
  case $1 in
    off)    anim=false; w=off l=off c=off bl=off o=scale ;;
    subtle) anim=true;  w=off l=on  c=off bl=on  o=scale ;;
    fluid)  anim=true;  w=on  l=on  c=off bl=on  o=scale ;;
    full)   anim=true;  w=on  l=on  c=on  bl=on  o=fire ;;
  esac
  gsettings set org.gnome.desktop.interface enable-animations $anim 2>/dev/null || true
  [ $w = on ] && gnome_wobbly_apply
  gx_set wobbly $w; gx_set lamp $l; gx_set cube $c; gx_set blur $bl
  gnome_oc $o
  return 0
}
gnome_switch_set() {
  case "$1" in
    cube) gx_set cube on ;;
    slide|fade|none) gx_set cube off ;;
    *) return 1 ;;
  esac
}
gnome_switch_get() { if gx_on $GX_CUBE; then echo cube; else echo slide; fi; }

get_fx() { sed -n "s/^$1 //p" "$state" | head -1; }
set_fx() { grep -v "^$1 " "$state" > "$state.n"; echo "$1 $2" >> "$state.n"; mv "$state.n" "$state"; }
fxv() { v=$(get_fx "$1"); if [ -n "$v" ]; then echo "$v"; else echo "${2:-off}"; fi; }

hypr_status() {
  for n in wobbly flip blur transparency dim; do echo "$n $(fxv $n off)"; done
  for n in sheet lamp overview cube liquidglass; do echo "$n na"; done
}
hypr_write() {
  wob=$(fxv wobbly off); flp=$(fxv flip off); wa=$(wob_amount); wc=$(wob_curve); blr=$(fxv blur off); trn=$(fxv transparency off); dim=$(fxv dim off); sw=$(fxv switch slide)
  anim=$(fxv anim on); sp=$(fxv speed 1)
  ds() { awk "BEGIN{printf \"%.1f\", $1 * $sp}"; }
  out=$HOME/.config/hypr/kwick-effects.conf
  mkdir -p "$HOME/.config/hypr"
  case $sw in
    slide) ws="1, $(ds 5), ease, $([ "$flp" = on ] && echo "slidefade 20%" || echo slide)" ;;
    fade) ws="1, $(ds 4), ease, fade" ;;
    cube) ws="1, $(ds 8), cube, slidefade 15%" ;;
    *) ws="0" ;;
  esac
  {
    echo "animations {"
    echo "  enabled = $([ "$anim" = on ] && echo true || echo false)"
    echo "  bezier = ease, 0.22, 1, 0.36, 1"
    echo "  bezier = sink, 0.55, 0, 0.8, 0.45"
    echo "  bezier = spring, 0.32, 1.28, 0.62, 1"
    echo "  bezier = cube, 0.3, 1.38, 0.6, 1"
    echo "  bezier = wobble, 0.2, $(awk "BEGIN{print 1 + $wa * 0.1 + $wc * 0.08}"), 0.5, 1"
    if [ "$flp" = on ]; then
      echo "  animation = windowsIn, 1, $(ds 7), spring, popin 60%"
      echo "  animation = windowsOut, 1, $(ds 7), sink, popin 70%"
      echo "  animation = fadeIn, 1, $(ds 2.2), ease"
      echo "  animation = fadeOut, 1, $(ds 7), sink"
      echo "  animation = windowsMove, 1, $(ds 6), $([ "$wob" = on ] && echo wobble || echo spring)"
    elif [ "$wob" = on ]; then
      echo "  animation = windowsIn, 1, $(ds 6), wobble, popin 70%"
      echo "  animation = windowsOut, 1, $(ds 3), sink, popin 85%"
      echo "  animation = fadeIn, 1, $(ds 2.5), ease"
      echo "  animation = fadeOut, 1, $(ds 3), sink"
      echo "  animation = windowsMove, 1, $(ds $((6 + wc / 2))), wobble"
    else
      echo "  animation = windowsIn, 1, $(ds 3), ease, popin 85%"
      echo "  animation = windowsOut, 1, $(ds 2.5), sink, popin 85%"
      echo "  animation = fadeIn, 1, $(ds 2.5), ease"
      echo "  animation = fadeOut, 1, $(ds 2.5), sink"
      echo "  animation = windowsMove, 1, $(ds 4), ease"
    fi
    echo "  animation = border, 1, $(ds 6), ease"
    echo "  animation = workspaces, $ws"
    echo "}"
    echo "decoration {"
    if [ "$trn" = on ]; then echo "  active_opacity = 0.97"; echo "  inactive_opacity = 0.88"; else echo "  active_opacity = 1.0"; echo "  inactive_opacity = 1.0"; fi
    if [ "$dim" = on ]; then echo "  dim_inactive = true"; echo "  dim_strength = 0.12"; else echo "  dim_inactive = false"; fi
    echo "  blur {"
    echo "    enabled = $([ "$blr" = on ] && echo true || echo false)"
    if [ "$wob" = on ] && [ "$blr" = on ]; then echo "    size = 10"; echo "    passes = 4"; else echo "    size = 6"; echo "    passes = 2"; fi
    echo "    noise = 0.03"
    echo "  }"
    echo "  shadow {"
    echo "    enabled = $([ "$anim" = on ] && echo true || echo false)"
    echo "  }"
    echo "}"
  } > "$out"
  hyprctl reload >/dev/null 2>&1 || true
}
sway_write() {
  [ -d "$HOME/.config/sway" ] || return 0
  blr=$(fxv blur off); dim=$(fxv dim off)
  {
    echo "blur $([ "$blr" = on ] && echo enable || echo disable)"
    echo "blur_radius 6"
    echo "corner_radius 12"
    echo "shadows $([ "$(fxv anim on)" = on ] && echo enable || echo disable)"
    echo "default_dim_inactive $([ "$dim" = on ] && echo 0.12 || echo 0.0)"
  } > "$HOME/.config/sway/kwick-effects.conf"
  swaymsg reload >/dev/null 2>&1 || true
}
tiling_write() { if [ "$be" = sway ]; then sway_write; else hypr_write; fi; }
preset_tiling() {
  case $1 in
    off)    set_fx anim off; set_fx speed 1; set_fx wobbly off; set_fx flip off; set_fx blur off; set_fx transparency off; set_fx dim off; set_fx switch none ;;
    subtle) set_fx anim on; set_fx speed 0.7; set_fx wobbly off; set_fx flip off; set_fx blur on; set_fx transparency off; set_fx dim off; set_fx switch slide ;;
    fluid)  set_fx anim on; set_fx speed 0.8; set_fx wobbly on; set_fx flip on; set_fx blur on; set_fx transparency off; set_fx dim off; set_fx switch slide ;;
    full)   set_fx anim on; set_fx speed 1; set_fx wobbly on; set_fx flip on; set_fx blur on; set_fx transparency on; set_fx dim on; set_fx switch cube ;;
  esac
  tiling_write
}

oc_cur() { case $be in kde) oc_now ;; gnome) gnome_oc_now ;; *) echo na ;; esac; }
oc_state() { case $be in kde) oc_state_kde "$1" "$2" ;; gnome) oc_state_gnome "$1" "$2" ;; *) echo na ;; esac; }
oc_list() {
  cur=$(oc_cur)
  printf '%s\n' "$OC_TABLE" | while IFS='|' read -r n k g l d; do echo "$n|$(oc_state "$n" "$cur")|$l|$d"; done
}
oc_apply() {
  case $be in
    kde) [ "$(oc_state_kde "$1" -)" = na ] && { echo "$1 is not available in KDE Plasma" >&2; return 1; }
         oc "$1"; reload; need_gpu || true ;;
    gnome) gnome_oc "$1" ;;
    *) echo "open/close styles need KDE Plasma or GNOME; this session keeps its own animations" >&2; return 1 ;;
  esac
}
dur_get() {
  n=$(oc_cur)
  case $be in
    kde) k=$(ocf "$n" 2); d=$(kde_dur_default "$k"); [ "${d:-0}" -gt 0 ] || return 1
         kreadconfig6 --file kwinrc --group "Effect-$k" --key Duration --default "$d" ;;
    gnome) g=$(ocf "$n" 3); case $g in -|=) return 1 ;; esac
           d=$(gnome_dur_default "$g"); [ "${d:-0}" -gt 0 ] || return 1
           fxv "duration_$n" "$d" ;;
    *) return 1 ;;
  esac
}
dur_set() {
  case $1 in ''|*[!0-9]*) echo "duration: 100-5000 ms" >&2; return 1 ;; esac
  dms=$1; [ "$dms" -lt 100 ] && dms=100; [ "$dms" -gt 5000 ] && dms=5000
  dstyle=$(oc_cur)
  (dur_get >/dev/null) || { echo "$dstyle has no adjustable duration" >&2; return 1; }
  case $be in
    kde) k=$(ocf "$dstyle" 2); kw kwinrc "Effect-$k" Duration "$dms"; rcfg "$k" ;;
    gnome) set_fx "duration_$dstyle" "$dms"; gnome_burn_profile ;;
  esac
  echo "$dstyle duration: $dms ms"
}

core_status() {
  case $be in
    kde) kde_status ;;
    gnome) gnome_status ;;
    hyprland) hypr_status ;;
    sway) for n in blur dim; do echo "$n $(fxv $n off)"; done
          for n in wobbly lamp transparency sheet overview cube liquidglass; do echo "$n na"; done ;;
    *) for n in wobbly lamp blur transparency sheet dim overview cube liquidglass; do echo "$n na"; done ;;
  esac
}
status() {
  s=$(core_status)
  printf '%s\n' "$s"
  oc_list | while IFS='|' read -r n st l d; do
    case "$n
$s" in none*|*"
$n "*) continue ;; esac
    echo "$n $st"
  done
}

p=${1:-}
case "$p" in
  wobbly) [ $# -eq 1 ] && p=fluid ;;
esac

if [ -z "$p" ]; then
  cur=$(cat "$cfg/effects" 2>/dev/null || echo subtle)
  case $cur in wobbly) cur=fluid ;; esac
  echo "$cur"
  exit 0
fi

case "$p" in
  check) gl; exit 0 ;;
  auto)
    [ "$be" = kde ] && glass_ok || exit 0
    on=0; isplug kwick_liquidglass false && on=1
    if [ "$(gl)" != gpu ]; then
      [ $on = 1 ] && glass 0
      isplug blur true && { blurfx 0; touch "$cfg/blur.auto-off"; }
    else
      [ -e "$cfg/blur.auto-off" ] && { rm -f "$cfg/blur.auto-off"; blurfx 1; }
      case $(get_fx liquidglass_user) in
        on) want=1 ;;
        off) want=0 ;;
        *) case $(cat "$cfg/effects" 2>/dev/null || echo default) in
             default|fluid|full) want=1 ;;
             custom) want=$on ;;
             *) want=0 ;;
           esac ;;
      esac
      if [ $want = 1 ]; then
        if [ $on = 0 ]; then glass 1
        elif [ "$(/usr/lib/kwick/liquidglass-theme status 2>/dev/null)" != on ]; then glass_theme on; fi
      elif [ $on = 1 ]; then glass 0; fi
    fi
    [ -n "$touched" ] && reload
    exit 0 ;;
  backend) echo "$be"; exit 0 ;;
  list) q org.kde.KWin /Effects org.kde.kwin.Effects.listOfEffects | sort; exit 0 ;;
  status) status; exit 0 ;;
  set)
    [ $# -eq 3 ] || { usage; exit 1; }
    case $be in
      hyprland|sway) case $2 in wobbly|flip|blur|transparency|dim) set_fx "$2" "$3"; tiling_write ;; *) echo "$2 is not available in this session" >&2; exit 1 ;; esac ;;
      kde|gnome) if is_oc "$2"; then oc_apply "$([ "$3" = on ] && echo "$2" || echo scale)" || exit 1
                 elif [ "$be" = kde ]; then kde_set "$2" "$3" || exit 1; reload; need_gpu || true
                 else gx_set "$2" "$3" || exit 1; fi ;;
      *) echo "no supported session detected" >&2; exit 1 ;;
    esac
    echo custom > "$cfg/effects"
    echo "effect $2: $3"
    exit 0 ;;
  open-close)
    if [ $# -lt 2 ]; then oc_cur; exit 0; fi
    [ "$2" = list ] && { oc_list; exit 0; }
    is_oc "$2" || { echo "unknown style: $2 (kwick-effects open-close list shows them)" >&2; exit 1; }
    oc_apply "$2" || exit 1
    echo custom > "$cfg/effects"
    echo "open/close: $2"
    exit 0 ;;
  wobbly)
    [ $# -eq 3 ] || { usage; exit 1; }
    a=$(clampn "$2" 6); c=$(clampn "$3" 7)
    set_fx wobble_amount "$a"; set_fx wobble_curve "$c"
    case $be in
      kde) kde_wobbly_apply; rcfg wobblywindows ;;
      gnome) gnome_wobbly_apply ;;
      hyprland|sway) tiling_write ;;
    esac
    echo "wobble: amount $a, sway $c"
    exit 0 ;;
  flame-style)
    [ "$be" = kde ] || { echo "flame styles are KDE only" >&2; exit 1; }
    if [ $# -ge 2 ]; then flame_style_set "$2" || exit 1; rcfg kwick_flame; echo "flame style: $2"; else flame_style_get; fi
    exit 0 ;;
  flame-height)
    [ "$be" = kde ] || { echo "flame height is KDE only" >&2; exit 1; }
    if [ $# -ge 2 ]; then flame_height_set "$2" || exit 1; rcfg kwick_flame; echo "flame height: $2"; else flame_height_get; fi
    exit 0 ;;
  param)
    case "${2:-}" in
      wobbly) echo "$(wob_amount) $(wob_curve)"; exit 0 ;;
      duration) if [ $# -ge 3 ]; then dur_set "$3" || exit 1; else dur_get || echo na; fi; exit 0 ;;
      depth) if [ $# -ge 3 ]; then [ "$be" = kde ] || { echo "window depth is KDE only" >&2; exit 1; }; depth_set "$3" || exit 1; rcfg kwick_cubeslide; echo "window depth: $3"; else depth_get; fi; exit 0 ;;
      flip) if [ $# -ge 3 ]; then [ "$be" = kde ] || { echo "flip styles are KDE only" >&2; exit 1; }; flip_style_set "$3" || exit 1; rcfg kwick_flip; echo "flip style: $3"; else flip_style_get; fi; exit 0 ;;
      *) usage; exit 1 ;;
    esac ;;
  switch)
    if [ $# -lt 2 ]; then
      case $be in kde) kde_switch_get ;; gnome) gnome_switch_get ;; hyprland|sway) fxv switch slide ;; *) echo none ;; esac
      exit 0
    fi
    case $be in
      kde) kde_switch_set "$2" || exit 1; reload ;;
      gnome) gnome_switch_set "$2" || exit 1 ;;
      hyprland|sway) set_fx switch "$2"; tiling_write ;;
      *) exit 1 ;;
    esac
    echo custom > "$cfg/effects"
    echo "desktop switch: $2"
    exit 0 ;;
  tabbox)
    if [ $# -lt 2 ]; then
      if [ "$be" = kde ]; then kde_tabbox_get; else echo windows; fi
      exit 0
    fi
    [ "$be" = kde ] || { echo "Alt+Tab styles are only available on KDE Plasma" >&2; exit 1; }
    kde_tabbox_set "$2" || exit 1
    q org.kde.KWin /KWin reconfigure >/dev/null
    echo "alt+tab: $2"
    exit 0 ;;
  off|subtle|fluid|full) ;;
  *) usage; exit 1 ;;
esac

echo "$p" > "$cfg/effects"
case $be in
  kde) preset_kde "$p"; reload; need_gpu || true ;;
  gnome) preset_gnome "$p" ;;
  hyprland|sway) preset_tiling "$p" ;;
  *) echo "saved; applied at next login" ;;
esac
echo "effects: $p"
