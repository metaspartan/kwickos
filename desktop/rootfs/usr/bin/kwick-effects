#!/bin/sh
# kwick-effects: window-effect presets (Compiz-style) for KDE, GNOME and Hyprland.
#   kwick-effects off | subtle | wobbly | compiz        (no argument: show current)
#   off     no animations           subtle  fades, blur, sliding popups, magic lamp (default)
#   wobbly  + wobbly windows
#   compiz  + wobbly, glide, burn-away open/close (Burn-My-Windows), strong blur
set -u
cfg=${XDG_CONFIG_HOME:-$HOME/.config}/kwick; mkdir -p "$cfg"
p=${1:-}; if [ -z "$p" ]; then cat "$cfg/effects" 2>/dev/null || echo subtle; exit 0; fi
case "$p" in off|subtle|wobbly|compiz) ;; *) echo "usage: kwick-effects off|subtle|wobbly|compiz"; exit 1;; esac
echo "$p" > "$cfg/effects"
de=$(printf '%s' "${XDG_CURRENT_DESKTOP:-}" | tr 'A-Z' 'a-z')
b() { [ "$1" = 1 ] && echo true || echo false; }
case $p in
  off)    blur=0 slide=0 wob=0 lamp=0 glide=0 fire=0 anim=0 factor=0 ;;
  subtle) blur=1 slide=1 wob=0 lamp=1 glide=0 fire=0 anim=1 factor=0.7 ;;
  wobbly) blur=1 slide=1 wob=1 lamp=1 glide=0 fire=0 anim=1 factor=0.8 ;;
  compiz) blur=1 slide=1 wob=1 lamp=1 glide=1 fire=1 anim=1 factor=1 ;;
esac
# Effects need a GPU compositor. qpainter (software) silently refuses them.
compositor() {
  t=$(qdbus6 org.kde.KWin /Compositor compositingType 2>/dev/null || true)
  case "$t" in *gl*|*OpenGL*|*vulkan*) return 0 ;; esac
  echo "note: KWin compositor is '${t:-not running}', which cannot animate effects." >&2
  echo "      install GPU drivers first: sudo apt install kwick-gpu, then log in again." >&2
  return 1
}
kde() {
  compositor || true
  k() { kwriteconfig6 --file kwinrc --group Plugins --key "$1" "$2"; }
  for e in blur contrast translucency; do k ${e}Enabled $(b $blur); done
  k slidingpopupsEnabled $(b $slide); k fadingpopupsEnabled $(b $anim); k wobblywindowsEnabled $(b $wob)
  k magiclampEnabled $(b $lamp); k glideEnabled $(b $glide); k fadeEnabled $(b $([ $fire = 1 ] && echo 0 || echo $anim))
  k kwin4_effect_fadeEnabled $(b $anim)
  for e in maximize login logout sessionquit dialogparent; do k ${e}Enabled $(b $anim); done
  k kwin6_effect_fireEnabled $(b $fire)
  if [ $p = compiz ]; then
    kwriteconfig6 --file kwinrc --group Effect-wobblywindows --key Stiffness 8
    kwriteconfig6 --file kwinrc --group Effect-wobblywindows --key Drag 85
    kwriteconfig6 --file kwinrc --group Effect-wobblywindows --key WobblynessLevel 3
    kwriteconfig6 --file kwinrc --group Effect-blur --key BlurStrength 12
  fi
  kwriteconfig6 --file kdeglobals --group KDE --key AnimationDurationFactor "$factor"
  qdbus6 org.kde.KWin /KWin reconfigure >/dev/null 2>&1 || true
}
gnome() {
  gsettings set org.gnome.desktop.interface enable-animations $(b $anim)
  for e in compiz-windows-effect@hermes83.github.com compiz-alike-magic-lamp-effect@hermes83.github.com; do
    if [ $wob = 1 ]; then gnome-extensions enable $e 2>/dev/null; else gnome-extensions disable $e 2>/dev/null; fi; done
  for e in burn-my-windows@schneegans.github.com; do
    if [ $p = compiz ]; then gnome-extensions enable $e 2>/dev/null; else gnome-extensions disable $e 2>/dev/null; fi; done
  for e in blur-my-shell@aunetx; do
    if [ $blur = 1 ]; then gnome-extensions enable $e 2>/dev/null; else gnome-extensions disable $e 2>/dev/null; fi; done
}
hypr() {
  mkdir -p "$HOME/.config/hypr"
  cp "/usr/share/kwick/hypr/effects-$p.conf" "$HOME/.config/hypr/kwick-effects.conf"
  hyprctl reload >/dev/null 2>&1 || true
}
case $de in *kde*) kde ;; *gnome*) gnome ;; *hyprland*|*sway*) hypr ;; *) echo "saved; applied at next login" ;; esac
echo "effects: $p"