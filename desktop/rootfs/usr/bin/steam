#!/bin/sh
# steam: launcher that makes Steam work out of the box. The first launch installs the
# Flathub build (bundles the 32-bit runtime, Proton support and the Mesa/NVIDIA GL
# extensions, so no multiarch is needed on the host) and then starts it.
APP=com.valvesoftware.Steam
if ! flatpak info "$APP" >/dev/null 2>&1; then
  command -v notify-send >/dev/null && notify-send -i steam "Steam" "Installing Steam (about 1 GB, first launch only)..."
  flatpak remote-add --if-not-exists --system flathub https://dl.flathub.org/repo/flathub.flatpakrepo 2>/dev/null \
    || flatpak remote-add --if-not-exists --user flathub https://dl.flathub.org/repo/flathub.flatpakrepo
  flatpak install -y --noninteractive flathub "$APP" || { echo "Steam install failed (network?)"; exit 1; }
  # match the NVIDIA GL runtime to the host driver when one is loaded
  if [ -r /sys/module/nvidia/version ]; then
    v=$(tr . - < /sys/module/nvidia/version)
    flatpak install -y --noninteractive flathub "org.freedesktop.Platform.GL.nvidia-$v" 2>/dev/null || true
  fi
  flatpak override --user --filesystem=xdg-run/gamemode "$APP" 2>/dev/null || true
fi
exec flatpak run "$APP" "$@"