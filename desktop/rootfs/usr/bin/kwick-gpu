#!/bin/sh
# kwick-gpu: show which GPUs were detected and which kernel/Mesa drivers drive them.
for c in /sys/class/drm/card[0-9]; do
  [ -e "$c/device/vendor" ] || continue
  v=$(cat $c/device/vendor); drv=$(basename "$(readlink $c/device/driver 2>/dev/null)" 2>/dev/null)
  case $v in 0x1002) n=AMD;; 0x10de) n=NVIDIA;; 0x8086) n=Intel;; 0x1af4) n=virtio;; *) n=$v;; esac
  echo "$(basename $c): $n  kernel driver: ${drv:-none}"
done
command -v vulkaninfo >/dev/null && vulkaninfo --summary 2>/dev/null | grep -E 'deviceName|driverName' 
exit 0