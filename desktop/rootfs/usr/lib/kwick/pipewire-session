#!/bin/sh
me=$(id -u)
mine() {
  for p in $(pgrep -x "$1" 2>/dev/null); do
    [ "$(stat -c %u "/proc/$p" 2>/dev/null)" = "$me" ] && return 0
  done
  return 1
}
s=${XDG_RUNTIME_DIR:-/run/user/$me}/pipewire-0
if ! mine pipewire; then
  rm -f "$s"
  pipewire &
  i=0
  while [ ! -S "$s" ] && [ $i -lt 100 ] && kill -0 $! 2>/dev/null; do sleep 0.02; i=$((i + 1)); done
fi
if ! mine wireplumber; then
  wireplumber &
fi
if ! mine pipewire-pulse; then
  pipewire-pulse &
fi
wait
