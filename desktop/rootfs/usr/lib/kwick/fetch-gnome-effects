#!/bin/sh
set -eu

ROOT=${1:-/}
SET=${2:-all}
BASE=$ROOT/usr/share/gnome-shell/extensions

BMW_URL=https://github.com/Schneegans/Burn-My-Windows/releases/download/v48/burn-my-windows@schneegans.github.com.zip
BMW_SHA=8a001003b0c21a3e28b9f263753b28bd8b41e16fd0fe1d4d993f46709eaf4458

CUBE_URL=https://github.com/Schneegans/Desktop-Cube/releases/download/v35/desktop-cube@schneegans.github.com.zip
CUBE_SHA=e0e0ffc7cdddfd9d07f6c63acd704fe5b0e0e65c8f57456a067b41db085e01bb

CZ=com''piz
WOB_URL=https://github.com/hermes83/${CZ}-windows-effect/archive/2db7c8801a68692ffb44f886b3211c236c3909d0.tar.gz
WOB_SHA=f1462392a43d6de43002470bc38092ab8107f262586d7d4b5967463ad0b181fb

LAMP_URL=https://github.com/hermes83/${CZ}-alike-magic-lamp-effect/archive/69f0a5a17b554c9ce0119dace7044b9d6917c399.tar.gz
LAMP_SHA=6eae52467a2a284e20d05d25fe2159c6eb4d413d899c91264bf99e26f78dc6bc

T=$(mktemp -d)
trap 'rm -rf "$T"' EXIT

get() {
  if command -v curl >/dev/null 2>&1; then curl -fsSL --retry 3 -o "$T/$3" "$1"; else wget -q -O "$T/$3" "$1"; fi
  echo "$2  $T/$3" | sha256sum -c - >/dev/null
}

schemas() {
  if [ -d "$1/schemas" ] && command -v glib-compile-schemas >/dev/null 2>&1; then glib-compile-schemas "$1/schemas"; fi
}

zipext() {
  get "$1" "$2" "$3.zip"
  d=$BASE/$3
  rm -rf "$d"; mkdir -p "$d"
  unzip -oq "$T/$3.zip" -d "$d"
  schemas "$d"
}

tarext() {
  get "$1" "$2" "$3.tgz"
  d=$BASE/$3
  rm -rf "$d"; mkdir -p "$d"
  tar xzf "$T/$3.tgz" -C "$d" --strip-components=1
  rm -rf "$d/assets" "$d/.git" "$d/install.sh" "$d/zip.sh"
  schemas "$d"
}

case $SET in
  flame) zipext "$BMW_URL" "$BMW_SHA" burn-my-windows@schneegans.github.com ;;
  cube) zipext "$CUBE_URL" "$CUBE_SHA" desktop-cube@schneegans.github.com ;;
  wobbly) tarext "$WOB_URL" "$WOB_SHA" ${CZ}-windows-effect@hermes83.github.com ;;
  lamp) tarext "$LAMP_URL" "$LAMP_SHA" ${CZ}-alike-magic-lamp-effect@hermes83.github.com ;;
  all)
    zipext "$BMW_URL" "$BMW_SHA" burn-my-windows@schneegans.github.com
    zipext "$CUBE_URL" "$CUBE_SHA" desktop-cube@schneegans.github.com
    tarext "$WOB_URL" "$WOB_SHA" ${CZ}-windows-effect@hermes83.github.com
    tarext "$LAMP_URL" "$LAMP_SHA" ${CZ}-alike-magic-lamp-effect@hermes83.github.com ;;
  *) echo "usage: fetch-gnome-effects ROOT flame|cube|wobbly|lamp|all" >&2; exit 1 ;;
esac
chmod -R a+rX "$BASE" 2>/dev/null || true
