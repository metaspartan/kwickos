def parse_keyfile(text):
    res = {}
    sec = None
    for l in (text or "").splitlines():
        l = l.strip()
        if l.startswith("[") and l.endswith("]"):
            sec = l[1:-1]
            res.setdefault(sec, {})
        elif "=" in l and sec:
            k, v = l.split("=", 1)
            res[sec][k.strip()] = v.strip()
    return res


def fp_permissions(meta_text):
    kf = parse_keyfile(meta_text)
    ctx = kf.get("Context", {})
    split = lambda k: [x for x in ctx.get(k, "").split(";") if x]
    shared, sockets, devices, fs, feats = split("shared"), split("sockets"), split("devices"), split("filesystems"), split("features")
    perms = []

    def add(pid, title, detail, level):
        perms.append({"id": pid, "title": title, "detail": detail, "level": level})

    if "network" in shared:
        add("network", "Network", "Can access the internet and your local network", 0)
    else:
        add("network", "No network access", "Cannot reach the internet", -1)
    host = [f for f in fs if f.split(":")[0] in ("host", "host-os", "host-etc", "/")]
    home = [f for f in fs if f.split(":")[0] in ("home", "~")]
    other = [f for f in fs if f not in host and f not in home and not f.startswith("!")]
    if host:
        add("files", "All files", "Can read and change every file on the computer", 2)
    elif home:
        add("files", "Home folder", "Can read and change files in your home folder", 1 if not any(f.endswith(":ro") for f in home) else 1)
    elif other:
        names = ", ".join(sorted(set(f.split(":")[0].replace("xdg-", "").replace("~/", "") for f in other))[:4])
        add("files", "Some folders", "Can use: " + names, 1)
    else:
        add("files", "No file access", "Opens files only through the file chooser you control", -1)
    if "x11" in sockets and "wayland" not in sockets:
        add("display", "Legacy display (X11)", "Can see and type into other X11 windows", 2)
    elif "fallback-x11" in sockets or "wayland" in sockets:
        add("display", "Own windows", "Draws only its own windows (Wayland)", 0)
    if "all" in devices:
        add("devices", "All devices", "Can use webcams, game controllers, USB and other devices", 1)
    elif "dri" in devices:
        add("devices", "Graphics acceleration", "Uses the GPU", 0)
    if "pulseaudio" in sockets:
        add("audio", "Microphone and speakers", "Can play sound and may record audio", 1)
    if "system-bus" in sockets or "session-bus" in sockets:
        add("bus", "Full system access", "Can talk to every desktop and system service", 2)
    sess = kf.get("Session Bus Policy", {})
    if any(k.startswith("org.freedesktop.Flatpak") for k in sess):
        add("escape", "Can run outside the sandbox", "Uses org.freedesktop.Flatpak to start host commands", 2)
    if "devel" in feats:
        add("devel", "Debugging", "Can trace other processes in its sandbox", 1)
    if "bluetooth" in feats:
        add("bluetooth", "Bluetooth", "Can use Bluetooth devices", 1)
    worst = max([p["level"] for p in perms] + [0])
    rating = {0: "Sandboxed", 1: "Sandboxed with some access", 2: "Weak sandbox"}[worst]
    return perms, worst, rating


def human(n):
    try:
        n = float(n)
    except (TypeError, ValueError):
        return ""
    for u, d in (("GB", 1e9), ("MB", 1e6), ("KB", 1e3)):
        if n >= d:
            return ("%.1f %s" % (n / d, u)).replace(".0 ", " ")
    return "%d bytes" % n


def pending_updates():
    res = {}
    try:
        for l in open(os.path.join(UPDATE, "updates"), encoding="utf-8", errors="replace"):
            p = l.rstrip("\n").split("\t")
            if len(p) >= 7 and p[0] in ("system", "apps"):
                res[(p[0], p[1])] = {"kind": p[0], "name": p[1], "from": p[2], "to": p[3], "size": int(p[4] or 0) if p[4].isdigit() else 0, "summary": p[5] if p[5] != "-" else "", "security": p[6] == "1"}
    except OSError:
        pass
    return res


def apt_show(pkg):
    f = pkg_info(pkg)
    if f:
        sec = f.get("Section", "")
        comp = sec.split("/")[0] if "/" in sec else "main"
        f["Download-Size"] = human(int(f["Size"])) if f.get("Size", "").isdigit() else ""
        f["APT-Sources"] = "%s/%s " % (f.get("Origin", "debian"), comp)
        f["Section"] = sec.split("/")[-1]
        return f
    if os.path.isfile(PKG_TSV):
        return {}
    rc, so, _ = run(["apt-cache", "show", pkg], timeout=60)
    for l in so.split("\n\n")[0].splitlines():
        if l[:1] in (" ", "\t"):
            continue
        k, sep, v = l.partition(":")
        if sep and k not in f:
            f[k] = v.strip()
    return f


