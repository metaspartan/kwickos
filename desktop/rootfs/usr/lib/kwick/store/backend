def out(obj):
    sys.stdout.write(json.dumps(obj, separators=(",", ":"), ensure_ascii=False))
    sys.stdout.write("\n")


def run(cmd, timeout=60, env=None):
    try:
        p = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=timeout, env=env, stdin=subprocess.DEVNULL)
        return p.returncode, p.stdout.decode("utf-8", "replace"), p.stderr.decode("utf-8", "replace")
    except (OSError, subprocess.TimeoutExpired) as e:
        return 127, "", str(e)


def which(name):
    p = shutil.which(name, path="/usr/local/bin:/usr/bin:/bin:/usr/local/sbin:/usr/sbin:/sbin")
    return p


def deb_arch():
    m = os.uname().machine
    return {"x86_64": "amd64", "aarch64": "arm64", "riscv64": "riscv64", "armv7l": "armhf", "i686": "i386"}.get(m, m)


def fp_arch():
    return {"amd64": "x86_64", "arm64": "aarch64"}.get(deb_arch(), os.uname().machine)


def load_json(path, default=None):
    try:
        with open(path, encoding="utf-8") as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def curated():
    return load_json(os.path.join(DATA, "curated.json"), {}) or {}


def norm_id(s):
    s = (s or "").strip()
    if s.endswith(".desktop"):
        s = s[:-8]
    return s.lower()


def strip_tags(s):
    s = re.sub(r"<[^>]+>", " ", s or "")
    return re.sub(r"\s+", " ", html.unescape(s)).strip()


def loc(v):
    if isinstance(v, dict):
        for k in ("C", "en", "en_US", "en-US", "en_GB"):
            if v.get(k):
                return v[k]
        for x in v.values():
            if x:
                return x
        return ""
    return v or ""


def yaml_parse(lines):
    n = len(lines)
    st = {"pos": 0}

    def ind(s):
        return len(s) - len(s.lstrip(" "))

    def skip():
        while st["pos"] < n and (not lines[st["pos"]].strip() or lines[st["pos"]].lstrip().startswith("#")):
            st["pos"] += 1

    def flow_split(s):
        parts, depth, cur, q = [], 0, "", None
        for c in s:
            if q:
                cur += c
                if c == q:
                    q = None
            elif c in "'\"":
                q = c
                cur += c
            elif c in "[{":
                depth += 1
                cur += c
            elif c in "]}":
                depth -= 1
                cur += c
            elif c == "," and depth == 0:
                parts.append(cur)
                cur = ""
            else:
                cur += c
        if cur.strip():
            parts.append(cur)
        return parts

    def scalar(v):
        v = v.strip()
        if len(v) >= 2 and v[0] == "'" and v[-1] == "'":
            return v[1:-1].replace("''", "'")
        if len(v) >= 2 and v[0] == '"' and v[-1] == '"':
            try:
                return json.loads(v)
            except ValueError:
                return v[1:-1]
        if v.startswith("[") and v.endswith("]"):
            return [scalar(x) for x in flow_split(v[1:-1])]
        if v.startswith("{") and v.endswith("}"):
            d = {}
            for x in flow_split(v[1:-1]):
                k, _, val = x.partition(":")
                d[k.strip()] = scalar(val)
            return d
        return v

    def block(style, base):
        got = []
        while st["pos"] < n:
            l = lines[st["pos"]]
            if l.strip() and ind(l) <= base:
                break
            got.append(l)
            st["pos"] += 1
        while got and not got[-1].strip():
            got.pop()
        if not got:
            return ""
        m = min(ind(l) for l in got if l.strip())
        got = [l[m:] if l.strip() else "" for l in got]
        if style.startswith("|"):
            return "\n".join(got)
        paras, cur = [], []
        for l in got:
            if l == "":
                if cur:
                    paras.append(" ".join(cur))
                    cur = []
            else:
                cur.append(l.strip())
        if cur:
            paras.append(" ".join(cur))
        return "\n".join(paras)

    def node(level):
        skip()
        if st["pos"] >= n:
            return None
        l = lines[st["pos"]]
        s = l.strip()
        if s == "-" or s.startswith("- "):
            return seq(ind(l))
        return mapping(ind(l))

    def value(v, base):
        v = v.strip()
        if v in (">", ">-", ">+", "|", "|-", "|+"):
            return block(v, base)
        if v == "":
            skip()
            if st["pos"] < n:
                l = lines[st["pos"]]
                i = ind(l)
                s = l.strip()
                if i > base or (i == base and (s == "-" or s.startswith("- "))):
                    return node(i)
            return None
        return scalar(v)

    def mapping(level):
        d = {}
        while True:
            skip()
            if st["pos"] >= n:
                break
            l = lines[st["pos"]]
            i = ind(l)
            s = l.strip()
            if i < level or (i == level and (s == "-" or s.startswith("- "))):
                break
            if i > level:
                st["pos"] += 1
                continue
            k, sep, v = s.partition(":")
            st["pos"] += 1
            if not sep:
                continue
            k = k.strip().strip("'\"")
            d[k] = value(v, level)
        return d

    def seq(level):
        lst = []
        while True:
            skip()
            if st["pos"] >= n:
                break
            l = lines[st["pos"]]
            i = ind(l)
            s = l.strip()
            if i != level or not (s == "-" or s.startswith("- ")):
                break
            rest = s[2:] if s.startswith("- ") else ""
            if rest == "":
                st["pos"] += 1
                lst.append(node(level + 2))
            elif re.match(r"""^[^'"\[{#][^:]*:(\s|$)""", rest):
                lines[st["pos"]] = " " * (level + 2) + rest
                lst.append(mapping(level + 2))
            else:
                st["pos"] += 1
                lst.append(scalar(rest))
        return lst

    return node(0)


def pick_thumb(thumbs, want=752):
    best, bd = None, None
    for t in thumbs:
        try:
            w = int(t.get("width") or 0)
        except (TypeError, ValueError):
            w = 0
        d = abs(w - want) if w else 10000
        if best is None or d < bd:
            best, bd = t, d
    return best


def dep11_entries(path, local_icons):
    try:
        with gzip.open(path, "rt", encoding="utf-8", errors="replace") as f:
            text = f.read()
    except OSError:
        return []
    docs = text.split("\n---\n")
    media = ""
    origin = ""
    res = []
    for k, doc in enumerate(docs):
        if k == 0:
            for l in doc.splitlines():
                if l.startswith("MediaBaseUrl:"):
                    media = l.split(":", 1)[1].strip()
                elif l.startswith("Origin:"):
                    origin = l.split(":", 1)[1].strip()
            continue
        head = doc[:400]
        m = re.search(r"^Type: (\S+)", head, re.M)
        if not m or m.group(1) not in APP_TYPES:
            continue
        try:
            d = yaml_parse(doc.split("\n"))
        except Exception:
            continue
        if not isinstance(d, dict) or not d.get("Package") or not d.get("ID"):
            continue
        icon = ""
        ic = d.get("Icon") or {}
        if isinstance(ic, dict):
            for c in sorted(ic.get("cached") or [], key=lambda x: -int((x or {}).get("width") or 0)):
                for base in local_icons:
                    p = os.path.join(base, "%sx%s" % (c.get("width"), c.get("height")), c.get("name") or "")
                    if os.path.isfile(p):
                        icon = "file://" + p
                        break
                if icon:
                    break
            if not icon:
                rem = sorted(ic.get("remote") or [], key=lambda x: -int((x or {}).get("width") or 0))
                if rem and media and rem[0].get("url"):
                    u = rem[0]["url"]
                    icon = u if u.startswith("http") else media.rstrip("/") + "/" + u
            if not icon and ic.get("stock"):
                icon = "theme:" + str(ic.get("stock"))
        shots = []
        for s in d.get("Screenshots") or []:
            if not isinstance(s, dict):
                continue
            src = s.get("source-image") or {}
            th = pick_thumb(s.get("thumbnails") or []) or src
            if not src.get("url") and not th.get("url"):
                continue
            full = src.get("url") or th.get("url")
            thumb = th.get("url") or full
            fix = lambda u: u if u.startswith("http") else media.rstrip("/") + "/" + u
            shots.append({"thumb": fix(thumb), "full": fix(full), "caption": strip_tags(loc(s.get("caption"))), "default": str(s.get("default")) == "true"})
        shots.sort(key=lambda x: not x["default"])
        rel = (d.get("Releases") or [{}])[0] or {}
        dev = d.get("Developer")
        devname = loc(dev.get("name")) if isinstance(dev, dict) else loc(d.get("DeveloperName"))
        kw = d.get("Keywords")
        kw = loc(kw) if isinstance(kw, dict) else kw
        url = d.get("Url") or {}
        lau = (d.get("Launchable") or {}).get("desktop-id") or []
        res.append({
            "key": "apt:" + d["ID"],
            "src": "apt",
            "id": d["ID"],
            "pkg": d["Package"],
            "name": strip_tags(loc(d.get("Name"))) or d["Package"],
            "summary": strip_tags(loc(d.get("Summary"))),
            "desc": loc(d.get("Description")),
            "icon": icon,
            "cats": [c for c in (d.get("Categories") or []) if isinstance(c, str)],
            "dev": strip_tags(devname),
            "license": d.get("ProjectLicense") or "",
            "kw": " ".join(x for x in (kw or []) if isinstance(x, str)),
            "shots": shots[:8],
            "ver": str(rel.get("version") or ""),
            "date": int(rel.get("unix-timestamp") or 0) if str(rel.get("unix-timestamp") or "0").isdigit() else 0,
            "notes": loc(rel.get("description")),
            "home": url.get("homepage", "") if isinstance(url, dict) else "",
            "desktop": [x for x in lau if isinstance(x, str)],
            "origin": origin,
        })
    return res


def x_text(el, tag):
    for c in el.findall(tag):
        if c.get(LANG_ATTR) is None:
            return "".join(c.itertext()).strip()
    return ""


def x_desc(el):
    for d in el.findall("description"):
        if d.get(LANG_ATTR) is not None:
            continue
        parts = []
        for c in d:
            if c.tag == "p":
                parts.append("<p>" + html.escape(re.sub(r"\s+", " ", "".join(c.itertext())).strip()) + "</p>")
            elif c.tag in ("ul", "ol"):
                items = "".join("<li>" + html.escape(re.sub(r"\s+", " ", "".join(li.itertext())).strip()) + "</li>" for li in c if li.tag == "li" and li.get(LANG_ATTR) is None)
                parts.append("<%s>%s</%s>" % (c.tag, items, c.tag))
        return "".join(parts)
    return ""


def flatpak_entries(path, remote, iconbase):
    res = []
    try:
        f = gzip.open(path, "rb") if path.endswith(".gz") else open(path, "rb")
    except OSError:
        return res
    with f:
        try:
            for ev, el in ET.iterparse(f, events=("end",)):
                if el.tag != "component":
                    continue
                if el.get("type") not in APP_TYPES:
                    el.clear()
                    continue
                cid = x_text(el, "id")
                bundle = el.find("bundle")
                ref = bundle.text.strip() if bundle is not None and bundle.text else ""
                if not cid or not ref.startswith("app/"):
                    el.clear()
                    continue
                appid = ref.split("/")[1]
                icon = ""
                for ic in sorted(el.findall("icon"), key=lambda x: -int(x.get("height") or x.get("width") or 0)):
                    t = (ic.text or "").strip()
                    if ic.get("type") == "cached":
                        h = ic.get("height") or "128"
                        p = os.path.join(iconbase, "%sx%s" % (ic.get("width") or h, h), t)
                        if os.path.isfile(p):
                            icon = "file://" + p
                            break
                    elif ic.get("type") == "remote" and t.startswith("http") and not icon:
                        icon = t
                if not icon:
                    for sz in ("128x128", "64x64"):
                        p = os.path.join(iconbase, sz, appid + ".png")
                        if os.path.isfile(p):
                            icon = "file://" + p
                            break
                shots = []
                ss = el.find("screenshots")
                for s in (ss.findall("screenshot") if ss is not None else []):
                    imgs = [i for i in s.findall("image") if i.get(LANG_ATTR) is None]
                    src = next((i for i in imgs if i.get("type") == "source"), None)
                    th = pick_thumb([{"width": i.get("width"), "url": (i.text or "").strip()} for i in imgs if i.get("type") == "thumbnail"])
                    full = (src.text or "").strip() if src is not None else (th or {}).get("url", "")
                    thumb = (th or {}).get("url") or full
                    if full:
                        shots.append({"thumb": thumb, "full": full, "caption": x_text(s, "caption"), "default": s.get("type") == "default"})
                shots.sort(key=lambda x: not x["default"])
                rel = None
                rs = el.find("releases")
                if rs is not None:
                    rel = rs.find("release")
                notes = ""
                if rel is not None:
                    notes = x_desc(rel)
                dev = el.find("developer")
                devname = x_text(dev, "name") if dev is not None else x_text(el, "developer_name")
                cats = [c.text.strip() for c in el.findall("categories/category") if c.text]
                kw = " ".join(k.text.strip() for ks in el.findall("keywords") if ks.get(LANG_ATTR) is None for k in ks.findall("keyword") if k.text and k.get(LANG_ATTR) is None)
                verified = False
                for v in el.findall("custom/value"):
                    if v.get("key") == "flathub::verification::verified" and (v.text or "").strip() == "true":
                        verified = True
                brand = {}
                for c in el.findall("branding/color"):
                    if c.get("type") == "primary" and c.text:
                        brand[c.get("scheme_preference") or "light"] = c.text.strip()
                home = ""
                for u in el.findall("url"):
                    if u.get("type") == "homepage" and u.text:
                        home = u.text.strip()
                date = 0
                if rel is not None:
                    ts = rel.get("timestamp") or ""
                    if ts.isdigit():
                        date = int(ts)
                    elif rel.get("date"):
                        try:
                            date = int(time.mktime(time.strptime(rel.get("date")[:10], "%Y-%m-%d")))
                        except ValueError:
                            date = 0
                lau = [l.text.strip() for l in el.findall("launchable") if l.get("type") == "desktop-id" and l.text]
                rating = el.find("content_rating")
                oars = {}
                if rating is not None:
                    for a in rating.findall("content_attribute"):
                        if a.text and a.text.strip() not in ("none", ""):
                            oars[a.get("id")] = a.text.strip()
                res.append({
                    "key": "flathub:" + appid if remote == "flathub" else remote + ":" + appid,
                    "src": "flathub",
                    "remote": remote,
                    "id": appid,
                    "cid": cid,
                    "ref": ref,
                    "runtime": bundle.get("runtime", "") if bundle is not None else "",
                    "name": x_text(el, "name") or appid,
                    "summary": x_text(el, "summary"),
                    "desc": x_desc(el),
                    "icon": icon,
                    "cats": cats,
                    "dev": devname,
                    "license": x_text(el, "project_license"),
                    "kw": kw,
                    "shots": shots[:8],
                    "ver": rel.get("version", "") if rel is not None else "",
                    "date": date,
                    "notes": notes,
                    "home": home,
                    "verified": verified,
                    "brand": brand,
                    "desktop": lau,
                    "oars": oars,
                })
                el.clear()
        except ET.ParseError:
            pass
    return res


def flatpak_sources():
    a = fp_arch()
    found = []
    for base in ("/var/lib/flatpak/appstream", os.path.join(HOME, ".local/share/flatpak/appstream")):
        for d in sorted(glob.glob(os.path.join(base, "*", a, "active"))):
            remote = d.split(os.sep)[-3]
            for name in ("appstream.xml.gz", "appstream.xml"):
                p = os.path.join(d, name)
                if os.path.isfile(p):
                    found.append((p, remote, os.path.join(d, "icons")))
                    break
    seen = set()
    res = []
    for p, r, i in found:
        if r in seen:
            continue
        seen.add(r)
        res.append((p, r, i))
    return res


def dep11_sources():
    sys_dirs = ["/var/lib/swcatalog/yaml", "/var/lib/app-info/yaml"]
    files = []
    for d in sys_dirs:
        files += sorted(glob.glob(os.path.join(d, "*.yml.gz")))
    icons = []
    for d in ("/var/lib/swcatalog/icons", "/var/lib/app-info/icons"):
        icons += sorted(glob.glob(os.path.join(d, "*")))
    if files:
        return files, icons, "system"
    return sorted(glob.glob(os.path.join(CACHE, "dep11", "*.yml.gz"))), [], "store"


def apt_sources():
    res = []
    for p in sorted(glob.glob("/etc/apt/sources.list.d/*.sources")):
        try:
            text = open(p, encoding="utf-8", errors="replace").read()
        except OSError:
            continue
        for stanza in re.split(r"\n\s*\n", text):
            f = {}
            for l in stanza.splitlines():
                if l.startswith("#") or ":" not in l:
                    continue
                k, v = l.split(":", 1)
                f[k.strip().lower()] = v.strip()
            if "deb" not in f.get("types", "deb").split() or f.get("enabled", "yes") == "no":
                continue
            for u in f.get("uris", "").split():
                for s in f.get("suites", "").split():
                    for c in f.get("components", "").split():
                        res.append((u, s, c))
    for p in ["/etc/apt/sources.list"] + sorted(glob.glob("/etc/apt/sources.list.d/*.list")):
        try:
            lines = open(p, encoding="utf-8", errors="replace").read().splitlines()
        except OSError:
            continue
        for l in lines:
            l = re.sub(r"\[[^\]]*\]", "", l.split("#", 1)[0]).split()
            if len(l) >= 4 and l[0] == "deb":
                for c in l[3:]:
                    res.append((l[1], l[2], c))
    return res


def fetch(url, dest, timeout=90):
    tmp = dest + ".part"
    req = urllib.request.Request(url, headers={"User-Agent": "kwick-store"})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r, open(tmp, "wb") as f:
            shutil.copyfileobj(r, f)
        os.replace(tmp, dest)
        return True
    except Exception:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        return False


def src_name(uri, suite, comp, ext):
    host = re.sub(r"^https?://", "", uri).split("/")[0]
    return re.sub(r"[^A-Za-z0-9._-]", "_", "%s_%s_%s" % (re.sub(r"^https?://", "", uri).rstrip("/").replace("/", "_"), suite, comp)) + ext, host


def refresh_dep11(force=False):
    files, _, kind = dep11_sources()
    d = os.path.join(CACHE, "dep11")
    pd = os.path.join(CACHE, "pkgs")
    os.makedirs(d, exist_ok=True)
    os.makedirs(pd, exist_ok=True)
    stamp = os.path.join(d, ".stamp")
    if not force and os.path.isfile(stamp) and time.time() - os.path.getmtime(stamp) < REFRESH_AGE and (files or kind == "system"):
        build_pkgs()
        return {"dep11": "cached" if kind != "system" else "system", "files": len(files)}
    arch = deb_arch()
    got = 0
    seen = set()
    sys_lists = glob.glob("/var/lib/apt/lists/*_Packages")
    for uri, suite, comp in apt_sources():
        if not re.match(r"^https?://", uri):
            continue
        name, host = src_name(uri, suite, comp, "")
        if name in seen:
            continue
        seen.add(name)
        if not sys_lists:
            fetch("%s/dists/%s/%s/binary-%s/Packages.xz" % (uri.rstrip("/"), suite, comp, arch), os.path.join(pd, name + ".xz"))
        if kind == "system" or "security" in uri or "security" in suite or ("debian" not in uri and "debian" not in host):
            continue
        if fetch("%s/dists/%s/%s/dep11/Components-%s.yml.gz" % (uri.rstrip("/"), suite, comp, arch), os.path.join(d, name + ".yml.gz")):
            got += 1
    open(stamp, "w").close()
    build_pkgs(True)
    return {"dep11": "store" if kind != "system" else "system", "files": got}


def vkey(v):
    epoch, rest = ("0", v)
    if ":" in v:
        epoch, rest = v.split(":", 1)
    up, rev = (rest.rsplit("-", 1) if "-" in rest else (rest, "0"))

    def order(c):
        if c == "~":
            return -1
        if c.isalpha():
            return ord(c)
        return ord(c) + 256

    def part(s):
        res = []
        for a, n in re.findall(r"([^0-9]*)([0-9]*)", s):
            if not a and not n:
                continue
            res.append([order(c) for c in a] + [0])
            res.append(int(n) if n else 0)
        res.append([0])
        return res
    try:
        e = int(epoch)
    except ValueError:
        e = 0
    return (e, part(up), part(rev))


PKG_TSV = os.path.join(CACHE, "pkgs.tsv")


def pkg_inputs():
    sys_lists = sorted(glob.glob("/var/lib/apt/lists/*_Packages"))
    return sys_lists if sys_lists else sorted(glob.glob(os.path.join(CACHE, "pkgs", "*.xz")))


def build_pkgs(force=False):
    import lzma
    files = pkg_inputs()
    if not files:
        return
    newest = max(os.path.getmtime(p) for p in files)
    if not force and os.path.isfile(PKG_TSV) and os.path.getmtime(PKG_TSV) >= newest:
        return
    best = {}
    for p in files:
        suite = os.path.basename(p)
        sec = "security" in suite
        try:
            f = lzma.open(p, "rt", encoding="utf-8", errors="replace") if p.endswith(".xz") else open(p, encoding="utf-8", errors="replace")
            text = f.read()
            f.close()
        except (OSError, lzma.LZMAError):
            continue
        for st in text.split("\n\n"):
            fld = {}
            for l in st.split("\n"):
                if l[:1] in (" ", "\t") or ":" not in l:
                    continue
                k, v = l.split(":", 1)
                if k in ("Package", "Version", "Section", "Installed-Size", "Size", "Homepage", "Description"):
                    fld[k] = v.strip()
            n = fld.get("Package")
            if not n:
                continue
            row = (n, fld.get("Version", ""), fld.get("Section", ""), fld.get("Installed-Size", "0"), fld.get("Size", "0"), fld.get("Homepage", ""), "security" if sec else ("kwickos" if "kwick" in suite.lower() else "debian"), fld.get("Description", "").replace("\t", " "))
            old = best.get(n)
            if not old or vkey(row[1]) > vkey(old[1]):
                best[n] = row
    tmp = PKG_TSV + ".new"
    with open(tmp, "w", encoding="utf-8") as f:
        for n in sorted(best):
            f.write("\t".join(best[n]) + "\n")
    os.replace(tmp, PKG_TSV)


def pkg_rows(pred, limit=None):
    res = []
    try:
        with open(PKG_TSV, encoding="utf-8", errors="replace") as f:
            for l in f:
                if pred(l):
                    p = l.rstrip("\n").split("\t")
                    if len(p) >= 8:
                        res.append(p)
                        if limit and len(res) >= limit:
                            break
    except OSError:
        pass
    return res


def pkg_info(name):
