class Ctx:
    def __init__(self, live=True):
        self.apps = index()
        self.by_key = {a["key"]: a for a in self.apps}
        self.by_id = {}
        for a in self.apps:
            self.by_id.setdefault(norm_id(a.get("id")), []).append(a)
            if a.get("cid"):
                self.by_id.setdefault(norm_id(a["cid"]), []).append(a)
            for dsk in a.get("desktop") or []:
                self.by_id.setdefault(norm_id(dsk), []).append(a)
        self.by_pkg = {}
        for a in self.apps:
            if a["src"] == "apt":
                self.by_pkg.setdefault(a["pkg"], a)
        self.status = dpkg_status() if live else {}
        self.fp = flatpak_installed() if live else {}

    def installed(self, a):
        if a["src"] == "apt":
            return a.get("pkg") in self.status
        if a["src"] == "flathub":
            return a["id"] in self.fp
        return bool(a.get("installed"))

    def group(self, a):
        res = []
        seen = set()
        for k in [a.get("id"), a.get("cid")] + list(a.get("desktop") or []):
            for b in self.by_id.get(norm_id(k), []):
                if b["key"] not in seen:
                    seen.add(b["key"])
                    res.append(b)
        if a["key"] not in seen:
            res.insert(0, a)
        return res

    def best(self, group):
        def rank(b):
            return (0 if self.installed(b) else 1, 0 if b["src"] == "flathub" else 1, 0 if b.get("remote", "flathub") == "flathub" else 1)
        return sorted(group, key=rank)[0]

    def obj(self, a, merge=True):
        grp = self.group(a) if merge else [a]
        b = self.best(grp) if merge else a
        o = compact(b, {"installed": self.installed(b)})
        o["srcs"] = sorted(set(x["src"] for x in grp), key=lambda s: ["flathub", "apt", "arch", "aur", "agent"].index(s) if s in ("flathub", "apt", "arch", "aur", "agent") else 9)
        if not o.get("icon"):
            for x in grp:
                if x.get("icon"):
                    o["icon"] = x["icon"]
                    break
        if any(self.installed(x) for x in grp):
            o["installed"] = True
        return o

    def lookup(self, ident):
        for b in self.by_id.get(norm_id(ident), []):
            return b
        return self.by_key.get(ident)


