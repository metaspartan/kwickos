        return
    cat = next((c for c in curated().get("categories") or [] if c["id"] == cid), None)
    if not cat:
        out({"id": cid, "items": []})
        return
    apps = [a for a in ctx.apps if cat_match(a.get("cats"), cat.get("match") or [])]
    apps.sort(key=lambda a: sort_key(a, pr))
    apps = dedupe(ctx, apps)[:240]
    out({"id": cid, "name": cat["name"], "items": [ctx.obj(a) for a in apps]})


def score(a, q, words):
    name = (a.get("name") or "").lower()
    s = 0.0
    if name == q:
        s += 100
    elif name.startswith(q):
        s += 60
    elif q in name:
        s += 40
    hay_kw = (a.get("kw") or "").lower()
    toks = set(re.split(r"[^a-z0-9+]+", " ".join([(a.get("summary") or "").lower(), hay_kw, (a.get("id") or "").lower(), (a.get("pkg") or "").lower(), " ".join(a.get("cats") or []).lower()])))
    for w in words:
        if w in name:
            continue
        if not any(t.startswith(w) for t in toks if t):
            return 0
    for w in words:
        if w in name:
            s += 12
        if w in hay_kw:
            s += 6
        if w in (a.get("summary") or "").lower():
            s += 4
        if w in (a.get("id") or "").lower() or w == (a.get("pkg") or ""):
            s += 5
    if a.get("verified"):
        s += 6
    if a.get("shots"):
        s += 3
    if a.get("src") == "flathub":
        s += 1
    return s


NOISE = re.compile(r"^(lib|python3-|golang-|librust-|node-|ruby-|r-cran-|texlive-|fonts-|firmware-|haskell-|php-|perl-|gir1\.2-|linux-(image|headers)-)|(-dev|-dbg|-doc|-data|-common|-dbgsym|-l10n-.*|-locale-.*)$")


def apt_cache_search(q, have, status, limit=30):
    words = [w for w in q.lower().split() if w]
    if not words:
        return []
    res = []
    for p in pkg_rows(lambda l: all(w in l.lower() for w in words)):
        name = p[0]
        if name in have or (NOISE.search(name) and not name.startswith(q)):
            continue
        toks = re.split(r"[^a-z0-9+]+", p[7].lower())
        if not all(w in name or any(t.startswith(w) for t in toks) for w in words):
            continue
        res.append({"key": "apt:" + name, "src": "apt", "id": name, "pkg": name, "name": name, "summary": p[7], "icon": "theme:package-x-generic", "ver": p[1], "installed": name in status, "plain": True, "origin": p[6]})
    res.sort(key=lambda o: (0 if o["name"] == q else 1 if o["name"].startswith(q) else 2 if q in o["name"] else 3, len(o["name"])))
    return res[:limit]


def cmd_search(args):
    q = " ".join(a for a in args if not a.startswith("--")).strip().lower()
