            item = {"name": name, "from": u["from"], "to": u["to"], "size": u["size"], "security": u["security"], "summary": u["summary"]}
            if e:
                o = compact(e)
                o.update({"key": e["key"], "src": "apt", "pkg": name, "from": u["from"], "to": u["to"], "size": u["size"], "security": u["security"], "notes": e.get("notes", "")})
                apps.append(o)
            system.append(item)
    arch = []
    ar = arch_status()
    if ar and ar["enabled"]:
        d = arch_json(["upgrade", "--check", "--json"], timeout=120)
        for p in arch_list(d):
            if not isinstance(p, dict):
                continue
            name = p.get("name") or p.get("pkgname")
            if not name:
                continue
            o = arch_obj(p, str(p.get("repo", "")).lower() == "aur" or bool(p.get("aur")), ctx.by_pkg, {name: p})
            o.update({"from": str(p.get("from") or p.get("old") or p.get("current") or p.get("installed") or ""), "to": str(p.get("to") or p.get("new") or p.get("version") or ""), "security": bool(p.get("security")), "blocked": bool(p.get("blocked")), "cve": p.get("cve") or []})
            arch.append(o)
        for p in (d.get("aur_updates") or []) if isinstance(d, dict) else []:
            name = p.get("name") if isinstance(p, dict) else None
            if not name:
                continue
            o = arch_obj(p, True, ctx.by_pkg, {name: p})
            o.update({"from": str(p.get("from") or ""), "to": str(p.get("to") or ""), "needsReview": True, "installed": False})
            arch.append(o)
    apps.sort(key=lambda o: (0 if o.get("security") else 1, (o.get("name") or "").lower()))
    out({"apps": apps, "system": system, "arch": arch, "checked": st.get("checked", 0), "job": st.get("job"), "release_available": st.get("release_available"), "release_latest": st.get("release_latest"), "error": st.get("error", ""), "available": bool(st)})


def read_job(d):
    res = {"running": False}
    try:
        p = open(os.path.join(d, "job")).read().split()
        if p and os.path.isdir("/proc/" + p[0]):
            res = {"running": True, "kind": p[1] if len(p) > 1 else "", "target": p[2] if len(p) > 2 else "", "since": int(p[3]) if len(p) > 3 and p[3].isdigit() else 0}
            try:
                pct, _, msg = open(os.path.join(d, "progress")).read().strip().partition("\t")
                res["progress"] = int(pct) if pct.lstrip("-").isdigit() else -1
                res["message"] = msg
            except OSError:
                res["progress"] = -1
    except OSError:
        pass
    try:
        r = open(os.path.join(d, "result")).read().strip().split(" ", 4)
        if len(r) >= 4:
            res["result"] = {"kind": r[0], "rc": int(r[1]) if r[1].lstrip("-").isdigit() else 1, "time": int(r[2]) if r[2].isdigit() else 0, "target": r[3], "message": r[4] if len(r) > 4 else ""}
    except OSError:
        pass
    return res


def cmd_job(args):
    a = read_job(STATE)
    b = read_job(os.path.join(CACHE, "job"))
    res = b if b["running"] else a if a["running"] else dict(a)
    ra, rb = a.get("result"), b.get("result")
    if ra or rb:
        res["result"] = max([r for r in (ra, rb) if r], key=lambda r: r["time"])
    u = read_job(UPDATE)
    if u["running"]:
        res["update"] = {"running": True, "progress": u.get("progress", -1), "message": u.get("message", ""), "kind": u.get("kind", "")}
    out(res)


ARCH_RC = {3: "Needs confirmation", 4: "Refused because of known vulnerabilities", 6: "Arch packages are turned off", 7: "Arch packages are not supported on this computer", 8: "Package not found"}
NAME_RE = re.compile(r"^[A-Za-z0-9@._+-]{1,128}$")


def cmd_userjob(args):
    if len(args) < 2:
        out({"ok": False, "error": "usage: userjob arch|flatpak ACTION [NAME] [flags]"})
        return
    tool, act, rest = args[0], args[1], args[2:]
    names = [a for a in rest if not a.startswith("--")]
    flags = [a for a in rest if a.startswith("--")]
    if any(not NAME_RE.match(n) for n in names):
        out({"ok": False, "error": "invalid name"})
        return
    if tool == "arch":
        exe = arch_exe()
        if not exe:
            out({"ok": False, "error": "kwick-arch is not installed"})
            return
        if act == "install" and len(names) == 1:
            commit = next((f.split("=", 1)[1] for f in flags if f.startswith("--commit=")), "")
            if commit and not re.match(r"^[0-9a-f]{7,64}$", commit):
                out({"ok": False, "error": "invalid commit"})
                return
            cmd = [exe, "install", names[0]] + (["--aur"] if "--aur" in flags else []) + ["--yes"] + (["--allow-vulnerable"] if "--allow-vulnerable" in flags else []) + (["--commit", commit] if commit else []) + ["--json"]
            target = ("aur:" if "--aur" in flags else "arch:") + names[0]
        elif act == "remove" and len(names) == 1:
            cmd, target = [exe, "remove", names[0], "--json"], "arch:" + names[0]
        elif act == "upgrade" and not names:
            cmd, target = [exe, "upgrade", "--yes", "--json"], "arch:*"
        elif act in ("enable", "disable") and not names:
            cmd, target = [exe, act, "--json"], "arch:*"
        else:
            out({"ok": False, "error": "unsupported"})
            return
    elif tool == "flatpak" and act in ("remove", "update") and len(names) == 1:
        cmd = ["flatpak", "uninstall" if act == "remove" else "update", "-y", "--noninteractive", "--user", names[0]]
        target = "flathub:" + names[0]
    else:
        out({"ok": False, "error": "unsupported"})
        return
    d = os.path.join(CACHE, "job")
    os.makedirs(d, exist_ok=True)
    cur = read_job(d)
    if cur["running"]:
        out({"ok": False, "error": "another task is running"})
        return
    with open(os.path.join(d, "job"), "w") as f:
        f.write("%d %s %s %d\n" % (os.getpid(), act, target, int(time.time())))
    prog = os.path.join(d, "progress")
    with open(prog, "w") as f:
        f.write("2\tStarting…\n")
    last, rc, res_json = "", 1, None
    with open(os.path.join(d, "log"), "w") as log:
        try:
            p = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL)
            pct = 2
            buf = b""
            while True:
                ch = p.stdout.read1(4096) if hasattr(p.stdout, "read1") else p.stdout.read(4096)
                if not ch:
                    break
                buf += ch
                parts = re.split(rb"[\r\n]", buf)
                buf = parts.pop()
                for raw in parts:
                    line = raw.decode("utf-8", "replace").strip()
                    if not line:
                        continue
                    if line.startswith("{"):
                        try:
                            res_json = json.loads(line)
                            continue
                        except ValueError:
                            pass
                    log.write(line + "\n")
                    log.flush()
                    last = line
                    m = re.search(r"(\d{1,3})(?:\.\d+)?%", line)
                    if m:
                        pct = max(pct, min(99, int(m.group(1))))
                    with open(prog, "w") as f:
                        f.write("%d\t%s\n" % (pct, line[:120]))
            tail = buf.decode("utf-8", "replace").strip()
            if tail.startswith("{"):
                try:
                    res_json = json.loads(tail)
                except ValueError:
                    last = tail
            elif tail:
                last = tail
            rc = p.wait()
        except OSError as e:
            last, rc = str(e), 127
    msg = last if rc else "Done"
    if rc and isinstance(res_json, dict):
        msg = res_json.get("message") or res_json.get("error") or msg
        blocked = [b.get("name", "") if isinstance(b, dict) else str(b) for b in (res_json.get("blocked") or [])]
        if rc == 4 and blocked:
            msg = "held back by the CVE gate: " + ", ".join(x for x in blocked if x)
    if rc in ARCH_RC and tool == "arch":
        msg = ARCH_RC[rc] + (": " + msg if msg and msg.lower() not in ARCH_RC[rc].lower() else "")
    with open(os.path.join(d, "result"), "w") as f:
        f.write("%s %d %d %s %s\n" % (act, rc, int(time.time()), target, re.sub(r"^kwick-arch:\s*", "", msg)))
    for n in ("job", "progress"):
        try:
            os.unlink(os.path.join(d, n))
        except OSError:
            pass
    out({"ok": rc == 0, "rc": rc, "message": msg})


def desktop_exec(path):
    d = read_desktop(path)
    if not d or not d.get("Exec"):
        return None
    cmd = re.sub(r"%[fFuUdDnNickvm]", "", d["Exec"]).replace("%%", "%")
    cmd = re.sub(r"\s@@u?\s*@@|\s@@u?(?=\s|$)", "", cmd).strip()
    return cmd


APP_DIRS = (os.path.join(HOME, ".local/share/applications"), os.path.join(HOME, ".local/share/flatpak/exports/share/applications"), "/var/lib/flatpak/exports/share/applications", "/usr/local/share/applications", "/usr/share/applications")


def spawn(cmd):
    subprocess.Popen(cmd, start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, stdin=subprocess.DEVNULL, env=dict(os.environ), cwd=HOME)


def cmd_launch(args):
    key = args[0] if args else ""
    src, _, ident = key.partition(":")
    cands = []
    if len(args) > 1 and args[1]:
        cands.append(args[1])
    pkg = ident
    if src == "flathub":
        cands.append(ident + ".desktop")
    else:
        ctx = Ctx(live=False)
        e = ctx.by_key.get(key) or (ctx.by_pkg.get(ident) if src in ("apt", "arch", "aur") else None)
        cands += list((e or {}).get("desktop") or [])
        pkg = (e or {}).get("pkg") or ident
        cands += [os.path.basename(p) for p in desktop_files_by_pkg().get(pkg, [])]
        if src in ("arch", "aur"):
            for dp in glob.glob("/usr/local/share/applications/*.desktop"):
                dd = read_desktop(dp) or {}
                if dd.get("X-KwickOS-Arch-Package") == pkg:
                    cands.insert(0, os.path.basename(dp))
            cands.append(pkg + ".desktop")
            cands.append("kwick-arch-" + pkg + ".desktop")
    for c in cands:
        for base in APP_DIRS:
            p = os.path.join(base, c if c.endswith(".desktop") else c + ".desktop")
            if not os.path.isfile(p):
                continue
            d = read_desktop(p)
            if d and d.get("NoDisplay") == "true" and len(cands) > 1:
                continue
            cmd = desktop_exec(p)
            if not cmd:
                continue
            if d and d.get("Terminal") == "true":
                term = which("kwick-terminal") or which("konsole") or which("foot") or which("gnome-terminal")
                if term:
                    cmd = "%s -e sh -c %s" % (term, "'" + cmd.replace("'", "'\\''") + "'")
            spawn(["sh", "-c", "exec " + cmd])
            out({"ok": True, "desktop": p})
            return
    if src == "flathub":
        spawn(["flatpak", "run", ident])
        out({"ok": True})
        return
    out({"ok": False, "error": "no launcher found"})


