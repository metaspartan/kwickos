    verdict = str(fit.get("verdict") or "")
    need = int(fit.get("need_mb") or 0)
    budget = int(fit.get("budget_mb") or 0)
    if verdict in ("gpu", "cpu") and budget > 0 and need > budget:
        verdict = "no"
    size = int(m.get("size") or 0)
    note = FIT_TITLES.get(verdict, "")
    if note and need:
        note += ": needs %.1f GB, %.1f GB available" % (need / 1024.0, budget / 1024.0)
    lic = LICENSE_NAMES.get((m.get("license") or "").lower(), m.get("license") or "") + (", no commercial use" if m.get("commercial_ok") is False else "")
    parts = [x for x in (m.get("quant") or "", gib(size) if size else "", lic) if x]
    return {
        "key": "model:" + mid,
        "src": "model",
        "id": mid,
        "name": m.get("title") or mid,
        "summary": "  ·  ".join(parts),
        "desc": "<p>" + html.escape(m.get("description") or "  ·  ".join(parts + ([note] if note else []))) + "</p>",
