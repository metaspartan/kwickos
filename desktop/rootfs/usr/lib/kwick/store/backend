def dedupe(ctx, apps):
    res, seen = [], set()
    for a in apps:
        g = ctx.group(a)
        k = min(x["key"] for x in g)
        if k in seen:
            continue
        seen.add(k)
        res.append(a)
    return res


def cmd_home(args):
    ctx = Ctx()
    cur = curated()
    pr = popular_rank()
    feat = []
    for f in cur.get("featured") or []:
        a = ctx.lookup(f["id"])
        if not a:
            continue
        o = ctx.obj(a)
        full = ctx.by_key.get(o["key"]) or a
        shots = full.get("shots") or a.get("shots") or []
        o.update({"eyebrow": f.get("eyebrow", ""), "title": f.get("title") or o["name"], "tagline": f.get("tagline") or o.get("summary", ""), "tint": f.get("tint") or [], "hero": shots[0]["full"] if shots else "", "brand": full.get("brand") or {}})
        feat.append(o)
    sections = []
    for s in cur.get("sections") or []:
        items = []
        for ident in s.get("items") or []:
            a = ctx.lookup(ident)
            if a:
                items.append(ctx.obj(a))
        if items:
            sections.append({"id": s["id"], "title": s["title"], "subtitle": s.get("subtitle", ""), "items": items})
    now = time.time()
    used = set(norm_id(f["id"]) for f in cur.get("featured") or [])
    for s in cur.get("sections") or []:
        used.update(norm_id(x) for x in s.get("items") or [])
    fresh = [a for a in ctx.apps if a["src"] == "flathub" and a.get("verified") and a.get("date", 0) > now - 45 * 86400 and a.get("shots") and norm_id(a["id"]) not in used]
    fresh.sort(key=lambda a: (pr.get(norm_id(a["id"]), 999), -a.get("date", 0)))
    fresh = dedupe(ctx, fresh)[:12]
    if fresh:
        sections.insert(1, {"id": "fresh", "title": "New & Updated", "subtitle": "Verified apps with a release in the last weeks", "items": [ctx.obj(a) for a in fresh]})
    cats = []
    for c in cur.get("categories") or []:
        n = sum(1 for a in ctx.apps if cat_match(a.get("cats"), c.get("match") or []))
        cats.append({"id": c["id"], "name": c["name"], "glyph": c.get("glyph", ""), "tint": c.get("tint", ""), "count": n})
    ag = agents_list()
    if ag:
        sections.append({"id": "agents", "title": "AI Agents", "subtitle": "Assistants and coding agents, set up by KwickOS", "items": [compact(a) for a in ag if a.get("kind") != "local-models"]})
        loc = local_ai_items(ag)
        if loc:
            sections.append({"id": "local-ai", "title": "Local AI", "subtitle": "Run open models on this computer, with no account", "items": loc})
    out({"featured": feat, "sections": sections, "categories": cats, "count": len(ctx.apps), "sources": sources_obj(ctx)})


