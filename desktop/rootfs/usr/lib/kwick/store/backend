def index_fresh(want):
    meta = load_json(INDEX + ".meta")
    return bool(meta) and meta.get("inputs") == want and os.path.isfile(INDEX) and os.path.isfile(INDEX + ".full")


def index(rebuild=False, check_only=False, stale_ok=True):
    os.makedirs(CACHE, exist_ok=True)
    want = input_state()
    if not rebuild and index_fresh(want):
        return None if check_only else load_json(INDEX, [])
    if not rebuild and stale_ok and not check_only and os.path.isfile(INDEX) and os.path.isfile(INDEX + ".full"):
        return load_json(INDEX, [])
    lock = open(os.path.join(CACHE, ".lock"), "w")
    fcntl.flock(lock, fcntl.LOCK_EX)
    try:
        if not rebuild and index_fresh(want):
            return None if check_only else load_json(INDEX, [])
        apps = build_index()
        slim, full = [], {}
        for e in apps:
            s = {k: e[k] for k in SLIM if e.get(k) not in (None, "", [], {})}
            s["shots"] = (e.get("shots") or [])[:1]
            slim.append(s)
            full[e["key"]] = {k: v for k, v in e.items() if k not in SLIM}
        write_json(INDEX, slim)
        write_json(INDEX + ".full", full)
        write_json(INDEX + ".meta", {"inputs": want, "built": int(time.time()), "count": len(slim)})
        for old in glob.glob(os.path.join(CACHE, "index-*")):
            if not old.startswith(INDEX):
                try:
                    os.unlink(old)
                except OSError:
                    pass
        return slim
    finally:
        fcntl.flock(lock, fcntl.LOCK_UN)
        lock.close()


