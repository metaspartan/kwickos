            if s > 0:
                scored.append((s, a))
    scored.sort(key=lambda x: (-x[0], x[1].get("name", "").lower()))
    items = [ctx.obj(a) for a in dedupe(ctx, [a for _, a in scored])[:80]]
    pkgs = []
    have = set(a.get("pkg") for a in ctx.apps if a["src"] == "apt")
    if words and len(q) >= 2:
        pkgs = apt_cache_search(q, have, ctx.status)
    ag = []
