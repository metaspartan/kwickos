#!/bin/sh
command -v gsettings >/dev/null 2>&1 || exit 0
gsettings monitor org.gnome.desktop.interface color-scheme | while read -r _ _; do
  case $(gsettings get org.gnome.desktop.interface color-scheme 2>/dev/null) in *prefer-dark*) m=dark ;; *) m=light ;; esac
  [ "$m" = "$(kwick-layout appearance)" ] || kwick-layout appearance "$m" >/dev/null 2>&1
done
