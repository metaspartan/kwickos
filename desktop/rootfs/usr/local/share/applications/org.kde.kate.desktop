[Desktop Entry]
Type=Application
Name=Text Editor
Comment=Plain text and code editor
Icon=kwick-editor
Exec=kate -b %U
Categories=System;Utility;TextEditor;
Keywords=kate;text;txt;editor;textedit;notepad;code;programming;development;markdown;
StartupNotify=true
Terminal=false
OnlyShowIn=KDE;
MimeType=text/plain;text/markdown;text/x-shellscript;application/json;
