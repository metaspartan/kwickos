[Desktop Entry]
Type=Application
Name=Files
GenericName=File Manager
Icon=kwick-files
Exec=nautilus --new-window %U
Categories=GNOME;GTK;Utility;Core;FileManager;
Keywords=nautilus;files;file manager;folders;finder;explorer;browse;
MimeType=inode/directory;
StartupNotify=true
Terminal=false
OnlyShowIn=GNOME;
