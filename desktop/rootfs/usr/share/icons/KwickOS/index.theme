[Icon Theme]
Name=KwickOS
Comment=KwickOS squircle and monochrome icon set
Inherits=Papirus-Dark,breeze-dark,hicolor
Example=folder
DesktopDefault=48
DesktopSizes=16,22,32,48,64,128,256
ToolbarDefault=22
ToolbarSizes=16,22,24,32
MainToolbarDefault=22
MainToolbarSizes=16,22,24,32
SmallDefault=16
SmallSizes=16,22
PanelDefault=48
PanelSizes=16,22,32,48,64
DialogDefault=32
DialogSizes=32,48,64,128
Directories=scalable/apps,scalable/preferences,scalable/categories,scalable/places,scalable/devices,scalable/actions,scalable/status,scalable/mimetypes

[scalable/apps]
Size=64
MinSize=8
MaxSize=1024
Type=Scalable
Context=Applications

[scalable/preferences]
Size=64
MinSize=8
MaxSize=1024
Type=Scalable
Context=Applications

[scalable/categories]
Size=64
MinSize=8
MaxSize=1024
Type=Scalable
Context=Categories

[scalable/places]
Size=64
MinSize=8
MaxSize=1024
Type=Scalable
Context=Places

[scalable/devices]
Size=64
MinSize=8
MaxSize=1024
Type=Scalable
Context=Devices

[scalable/actions]
Size=64
MinSize=8
MaxSize=1024
Type=Scalable
Context=Actions

[scalable/status]
Size=64
MinSize=8
MaxSize=1024
Type=Scalable
Context=Status

[scalable/mimetypes]
Size=64
MinSize=8
MaxSize=1024
Type=Scalable
Context=MimeTypes
