{
  "layer": "top",
  "position": "bottom",
  "height": 48,
  "spacing": 2,
  "modules-left": [],
  "modules-center": ["custom/start", "custom/search", "custom/files", "custom/web", "custom/term", "wlr/taskbar"],
  "modules-right": ["tray", "custom/vpn", "network", "pulseaudio", "battery", "clock"],
  "custom/start": { "format": " ", "tooltip-format": "Start", "on-click": "fuzzel" },
  "custom/search": { "format": " ", "tooltip-format": "Search", "on-click": "fuzzel" },
  "custom/files": { "format": "\u00a0", "tooltip-format": "Files", "on-click": "xdg-open ~" },
  "custom/web": { "format": "\u00a0", "tooltip-format": "Firefox", "on-click": "firefox-esr" },
  "custom/term": { "format": "\u00a0", "tooltip-format": "Terminal", "on-click": "kwick-terminal" },
  "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 24,
    "icon-theme": "KwickOS-Fluent",
    "tooltip-format": "{title}",
    "on-click": "activate",
    "on-click-middle": "close"
  },
  "clock": {
    "format": "{:%I:%M %p\n%m/%d/%Y}",
    "tooltip-format": "<tt>{calendar}</tt>"
  },
  "custom/vpn": {
    "exec": "kwick-vpn waybar",
    "return-type": "json",
    "interval": 5,
    "format": "{}",
    "on-click": "foot nmtui"
  },
  "network": {
    "format": " ",
    "format-wifi": " ",
    "format-ethernet": " ",
    "format-disconnected": " ",
    "tooltip-format": "{ifname} {ipaddr} {essid}",
    "on-click": "foot nmtui"
  },
  "pulseaudio": {
    "format": " ",
    "format-muted": " ",
    "on-click": "pavucontrol",
    "scroll-step": 5
  },
  "battery": {
    "format": " ",
    "format-charging": " ",
    "tooltip-format": "{capacity}%",
    "states": { "warning": 25, "critical": 12 }
  },
  "tray": { "icon-size": 18, "spacing": 10 }
}
