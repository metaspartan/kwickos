{
  "layer": "top",
  "position": "bottom",
  "height": 48,
  "spacing": 0,
  "modules-left": [],
  "modules-center": ["custom/start", "custom/search", "custom/files", "custom/web", "custom/term", "custom/editor", "custom/store", "custom/steam", "custom/settings", "wlr/taskbar"],
  "modules-right": ["privacy", "tray", "custom/osk", "custom/vpn", "network", "pulseaudio", "battery", "custom/clock"],
  "custom/start": { "format": " ", "tooltip-format": "Start", "on-click": "fuzzel" },
  "custom/search": { "format": " ", "tooltip-format": "Search", "on-click": "kwick-search" },
  "custom/files": {
    "exec": "/usr/lib/kwick/dock-state 'org.gnome.Nautilus|org.kde.dolphin|thunar|pcmanfm'",
    "return-type": "json", "interval": 5, "signal": 9, "tooltip-format": "Files",
    "on-click": "/usr/lib/kwick/dock-state open 'org.gnome.Nautilus|org.kde.dolphin|thunar|pcmanfm' kwick-app files"
  },
  "custom/web": {
    "exec": "/usr/lib/kwick/dock-state 'firefox-esr|firefox'",
    "return-type": "json", "interval": 5, "signal": 9, "tooltip-format": "Firefox",
    "on-click": "/usr/lib/kwick/dock-state open 'firefox-esr|firefox' firefox-esr"
  },
  "custom/term": {
    "exec": "/usr/lib/kwick/dock-state 'foot|kitty|Alacritty|org.kde.konsole'",
    "return-type": "json", "interval": 5, "signal": 9, "tooltip-format": "Terminal",
    "on-click": "/usr/lib/kwick/dock-state open 'foot|kitty|Alacritty|org.kde.konsole' kwick-terminal"
  },
  "custom/editor": {
    "exec": "/usr/lib/kwick/dock-state 'org.kde.kate|org.gnome.TextEditor|mousepad'",
    "return-type": "json", "interval": 5, "signal": 9, "tooltip-format": "Text Editor",
    "on-click": "/usr/lib/kwick/dock-state open 'org.kde.kate|org.gnome.TextEditor|mousepad' kwick-app editor"
  },
  "custom/store": {
    "exec": "/usr/lib/kwick/dock-state 'org.kwickos.store.qml|org.kde.discover|org.gnome.Software'",
    "return-type": "json", "interval": 5, "signal": 9, "tooltip-format": "App Store",
    "on-click": "/usr/lib/kwick/dock-state open 'org.kwickos.store.qml|org.kde.discover|org.gnome.Software' kwick-app software"
  },
  "custom/steam": {
    "exec": "/usr/lib/kwick/dock-state 'steam'",
    "return-type": "json", "interval": 5, "signal": 9, "tooltip-format": "Steam",
    "on-click": "/usr/lib/kwick/dock-state open 'steam' steam"
  },
  "custom/settings": {
    "exec": "/usr/lib/kwick/dock-state 'org.kwickos.settings.qml|kwick-settings'",
    "return-type": "json", "interval": 5, "signal": 9, "tooltip-format": "KwickOS Settings",
    "on-click": "/usr/lib/kwick/dock-state open 'org.kwickos.settings.qml|kwick-settings' kwick-settings"
  },
  "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 32,
    "icon-theme": "KwickOS-Fluent",
    "tooltip-format": "{title}",
    "on-click": "activate",
    "on-click-middle": "close",
    "ignore-list": ["org.gnome.Nautilus", "org.kde.dolphin", "thunar", "pcmanfm", "firefox-esr", "firefox", "foot", "kitty", "Alacritty", "org.kde.konsole", "org.kde.kate", "org.gnome.TextEditor", "mousepad", "org.kwickos.store.qml", "org.kde.discover", "org.gnome.Software", "steam", "org.kwickos.settings.qml", "kwick-settings"]
  },
  "privacy": {
    "icon-spacing": 6,
    "icon-size": 13,
    "transition-duration": 200,
    "modules": [
      { "type": "screenshare", "tooltip": true, "tooltip-icon-size": 18 },
      { "type": "audio-in", "tooltip": true, "tooltip-icon-size": 18 }
    ]
  },
  "custom/clock": {
    "exec": "/usr/lib/kwick/bar-clock",
    "return-type": "json",
    "interval": 10,
    "justify": "center"
  },
  "custom/osk": {
    "exec": "kwick-touch bar",
    "return-type": "json",
    "interval": "once",
    "signal": 8,
    "format": "{}",
    "on-click": "kwick-touch keyboard toggle"
  },
  "custom/vpn": {
    "exec": "kwick-vpn waybar",
    "return-type": "json",
    "interval": 5,
    "signal": 10,
    "format": "{icon}",
    "format-icons": { "connected": " ", "connecting": " ", "disconnected": " " },
    "on-click": "kwick-vpn menu",
    "on-click-right": "kwick-settings vpn"
  },
  "network": {
    "format": " ",
    "format-wifi": " ",
    "format-ethernet": " ",
    "format-disconnected": " ",
    "tooltip-format": "{ifname} {ipaddr} {essid}",
    "on-click": "foot nmtui"
  },
  "pulseaudio": {
    "format": " ",
    "format-muted": " ",
    "on-click": "pavucontrol",
    "scroll-step": 5
  },
  "battery": {
    "format": " ",
    "format-charging": " ",
    "tooltip-format": "{capacity}%",
    "states": { "warning": 25, "critical": 12 }
  },
  "tray": { "icon-size": 18, "spacing": 10 }
}
