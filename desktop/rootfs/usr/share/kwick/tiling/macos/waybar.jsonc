{
  "layer": "top",
  "position": "top",
  "height": 32,
  "spacing": 0,
  "modules-left": ["custom/logo", "@WM@/window", "@WM@/workspaces"],
  "modules-center": [],
  "modules-right": ["privacy", "tray", "bluetooth", "custom/osk", "custom/vpn", "network", "pulseaudio", "battery", "custom/clock"],
  "custom/logo": {
    "format": " ",
    "tooltip": false,
    "on-click": "fuzzel",
    "on-click-right": "kwick-keys"
  },
  "@WM@/window": {
    "format": "{@APPID@}",
    "max-length": 40,
    "separate-outputs": true,
    "rewrite": { "": "Files", "foot": "Terminal", "org.gnome.Nautilus": "Files", "org.gnome.TextEditor": "Text Editor", "firefox-esr": "Firefox", "org.kwickos.settings.qml": "KwickOS Settings", "kwick-settings": "KwickOS Settings", "org.gnome.Ptyxis": "Terminal", "org.kde.konsole": "Terminal", "org.kde.dolphin": "Files", "org.kde.kate": "Text Editor", "org.kde.discover": "Software", "org.kwickos.store.qml": "Software", "kwick-store": "Software", "org.kwickos.softwareupdate.qml": "Updates", "kwick-software-update": "Updates", "steam": "Steam", "kwick-quicklook": "Glance", "kwick-capture": "Capture" }
  },
  "privacy": {
    "icon-spacing": 6,
    "icon-size": 13,
    "transition-duration": 200,
    "modules": [
      { "type": "screenshare", "tooltip": true, "tooltip-icon-size": 18 },
      { "type": "audio-in", "tooltip": true, "tooltip-icon-size": 18 }
    ]
  },
  "@WM@/workspaces": {
    "format": "{name}",
    "disable-scroll": true,
    "all-outputs": false
  },
  "custom/clock": {
    "exec": "/usr/lib/kwick/bar-clock mac",
    "return-type": "json",
    "interval": 10
  },
  "bluetooth": {
    "format": " ",
    "format-disabled": " ",
    "format-off": " ",
    "format-connected": " ",
    "tooltip-format": "{status}",
    "on-click": "kwick-bluetooth menu",
    "on-click-right": "kwick-bluetooth settings"
  },
  "custom/osk": {
    "exec": "kwick-touch bar",
    "return-type": "json",
    "interval": "once",
    "signal": 8,
    "format": "{}",
    "on-click": "kwick-touch keyboard toggle"
  },
  "custom/vpn": {
    "exec": "kwick-vpn waybar",
    "return-type": "json",
    "interval": 5,
    "signal": 10,
    "format": "{icon}",
    "format-icons": { "connected": " ", "connecting": " ", "disconnected": " " },
    "on-click": "kwick-vpn menu",
    "on-click-right": "kwick-settings vpn"
  },
  "network": {
    "format": " ",
    "format-wifi": " ",
    "format-ethernet": " ",
    "format-linked": " ",
    "format-disconnected": " ",
    "format-disabled": " ",
    "tooltip-format": "{ifname} {ipaddr} {essid}",
    "tooltip-format-disconnected": "Disconnected",
    "states": { "s100": 80, "s80": 60, "s60": 40, "s40": 20, "s20": 1 },
    "on-click": "foot nmtui"
  },
  "pulseaudio": {
    "format": " ",
    "format-muted": " ",
    "format-bluetooth": " ",
    "format-bluetooth-muted": " ",
    "tooltip-format": "Volume {volume}%",
    "states": { "high": 67, "medium": 34, "low": 1, "zero": 0 },
    "on-click": "pavucontrol",
    "scroll-step": 5
  },
  "battery": {
    "format": " ",
    "format-charging": " ",
    "format-plugged": " ",
    "format-full": " ",
    "tooltip-format": "{capacity}% {timeTo}",
    "states": { "b000": 5, "b010": 15, "b020": 25, "b030": 35, "b040": 45, "b050": 55, "b060": 65, "b070": 75, "b080": 85, "b090": 95, "b100": 100 }
  },
  "tray": { "icon-size": 22, "spacing": 16 }
}
