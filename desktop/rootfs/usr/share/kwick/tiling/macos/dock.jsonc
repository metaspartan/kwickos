{
  "name": "dock",
  "layer": "top",
  "position": "bottom",
  "height": 72,
  "margin-bottom": 8,
  "exclusive": true,
  "modules-left": [],
  "modules-center": ["group/dock"],
  "modules-right": [],
  "group/dock": {
    "orientation": "horizontal",
    "modules": ["custom/files", "custom/web", "custom/term", "custom/editor", "custom/store", "custom/settings", "wlr/taskbar", "custom/sep", "custom/trash"]
  },
  "custom/files": {
    "exec": "/usr/lib/kwick/dock-state 'org.gnome.Nautilus|org.kde.dolphin|thunar|pcmanfm'",
    "return-type": "json", "interval": 5, "signal": 9, "tooltip-format": "Files",
    "on-click": "/usr/lib/kwick/dock-state open 'org.gnome.Nautilus|org.kde.dolphin|thunar|pcmanfm' kwick-app files"
  },
  "custom/web": {
    "exec": "/usr/lib/kwick/dock-state 'firefox-esr|firefox'",
    "return-type": "json", "interval": 5, "signal": 9, "tooltip-format": "Firefox",
    "on-click": "/usr/lib/kwick/dock-state open 'firefox-esr|firefox' firefox-esr"
  },
  "custom/term": {
    "exec": "/usr/lib/kwick/dock-state 'foot|kitty|Alacritty|org.kde.konsole'",
    "return-type": "json", "interval": 5, "signal": 9, "tooltip-format": "Terminal",
    "on-click": "/usr/lib/kwick/dock-state open 'foot|kitty|Alacritty|org.kde.konsole' kwick-terminal"
  },
  "custom/editor": {
    "exec": "/usr/lib/kwick/dock-state 'org.kde.kate|org.gnome.TextEditor|mousepad'",
    "return-type": "json", "interval": 5, "signal": 9, "tooltip-format": "Text Editor",
    "on-click": "/usr/lib/kwick/dock-state open 'org.kde.kate|org.gnome.TextEditor|mousepad' kwick-app editor"
  },
  "custom/store": {
    "exec": "/usr/lib/kwick/dock-state 'org.kde.discover|org.gnome.Software'",
    "return-type": "json", "interval": 5, "signal": 9, "tooltip-format": "Software",
    "on-click": "/usr/lib/kwick/dock-state open 'org.kde.discover|org.gnome.Software' kwick-app software"
  },
  "custom/settings": {
    "exec": "/usr/lib/kwick/dock-state 'org.kwickos.settings.qml|kwick-settings'",
    "return-type": "json", "interval": 5, "signal": 9, "tooltip-format": "KwickOS Settings",
    "on-click": "/usr/lib/kwick/dock-state open 'org.kwickos.settings.qml|kwick-settings' kwick-settings"
  },
  "custom/sep": { "format": " ", "tooltip": false },
  "custom/trash": { "format": " ", "tooltip-format": "Trash", "on-click": "kwick-app files trash:///" },
  "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 48,
    "icon-theme": "KwickOS",
    "tooltip-format": "{title}",
    "on-click": "activate",
    "on-click-middle": "close",
    "ignore-list": ["org.gnome.Nautilus", "org.kde.dolphin", "thunar", "pcmanfm", "firefox-esr", "firefox", "foot", "kitty", "Alacritty", "org.kde.konsole", "org.kde.kate", "org.gnome.TextEditor", "mousepad", "org.kde.discover", "org.gnome.Software", "org.kwickos.settings.qml", "kwick-settings"]
  }
}
