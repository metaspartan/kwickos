org.gnome.desktop.interface accent-color 'blue'
org.gnome.desktop.wm.preferences button-layout 'close,minimize,maximize:'
org.gnome.desktop.background picture-uri 'file:///usr/share/wallpapers/KwickGlass/contents/images/2560x1440.png'
org.gnome.desktop.background picture-uri-dark 'file:///usr/share/wallpapers/KwickGlass/contents/images/2560x1440.png'
org.gnome.desktop.screensaver picture-uri 'file:///usr/share/wallpapers/KwickGlass/contents/images/2560x1440.png'
org.gnome.shell enabled-extensions ['dash-to-dock@micxgx.gmail.com','blur-my-shell@aunetx','ubuntu-appindicators@ubuntu.com','kwick-menubar@kwickos.org']
org.gnome.shell favorite-apps ['org.gnome.Nautilus.desktop','firefox-esr.desktop','kwick-terminal.desktop','org.gnome.TextEditor.desktop','kwick-software.desktop','kwick-settings.desktop']
org.gnome.shell.extensions.dash-to-dock dock-position 'BOTTOM'
org.gnome.shell.extensions.dash-to-dock extend-height false
org.gnome.shell.extensions.dash-to-dock dock-fixed true
org.gnome.shell.extensions.dash-to-dock intellihide false
org.gnome.shell.extensions.dash-to-dock autohide false
org.gnome.shell.extensions.dash-to-dock dash-max-icon-size 48
org.gnome.shell.extensions.dash-to-dock icon-size-fixed true
org.gnome.shell.extensions.dash-to-dock show-trash true
org.gnome.shell.extensions.dash-to-dock show-show-apps-button false
org.gnome.shell.extensions.dash-to-dock show-favorites true
org.gnome.shell.extensions.dash-to-dock show-running true
org.gnome.shell.extensions.dash-to-dock transparency-mode 'FIXED'
org.gnome.shell.extensions.dash-to-dock custom-background-color true
org.gnome.shell.extensions.dash-to-dock background-color '#323232'
org.gnome.shell.extensions.dash-to-dock background-opacity 0.55
org.gnome.shell.extensions.dash-to-dock apply-custom-theme false
org.gnome.shell.extensions.dash-to-dock custom-theme-shrink true
org.gnome.shell.extensions.dash-to-dock running-indicator-style 'DOTS'
org.gnome.shell.extensions.dash-to-dock custom-theme-customize-running-dots true
org.gnome.shell.extensions.dash-to-dock custom-theme-running-dots-color '#ffffff'
org.gnome.shell.extensions.dash-to-dock custom-theme-running-dots-border-color '#ffffff'
org.gnome.shell.extensions.dash-to-dock custom-theme-running-dots-border-width 0
org.gnome.shell.extensions.dash-to-dock show-apps-at-top false
org.gnome.shell.extensions.dash-to-dock click-action 'minimize-or-previews'
org.gnome.shell.extensions.dash-to-dock disable-overview-on-startup true
org.gnome.shell.extensions.blur-my-shell.panel blur false
org.gnome.shell.extensions.blur-my-shell pipelines {'pipeline_default': {'name': <'Default'>, 'effects': <[<{'type': <'native_static_gaussian_blur'>, 'id': <'effect_000000000000'>, 'params': <{'radius': <30>, 'brightness': <0.6>}>}>]>}, 'pipeline_default_rounded': {'name': <'Default rounded'>, 'effects': <[<{'type': <'native_static_gaussian_blur'>, 'id': <'effect_000000000001'>, 'params': <{'radius': <30>, 'brightness': <0.6>}>}>, <{'type': <'corner'>, 'id': <'effect_000000000002'>, 'params': <{'radius': <24>}>}>]>}, 'pipeline_kwick_dock': {'name': <'KwickOS dock'>, 'effects': <[<{'type': <'native_static_gaussian_blur'>, 'id': <'effect_kwick_dock_blur'>, 'params': <{'unscaled_radius': <30.0>, 'brightness': <0.85>}>}>, <{'type': <'color'>, 'id': <'effect_kwick_dock_tint'>, 'params': <{'color': <[1.0, 1.0, 1.0, 0.08]>}>}>, <{'type': <'corner'>, 'id': <'effect_kwick_dock_corner'>, 'params': <{'radius': <18>}>}>]>}}
org.gnome.shell.extensions.blur-my-shell.dash-to-dock blur true
org.gnome.shell.extensions.blur-my-shell.dash-to-dock pipeline 'pipeline_kwick_dock'
org.gnome.shell.extensions.blur-my-shell.dash-to-dock static-blur true
org.gnome.shell.extensions.blur-my-shell.dash-to-dock override-background true
org.gnome.shell.extensions.blur-my-shell.dash-to-dock style-dash-to-dock 0
org.gnome.shell.extensions.blur-my-shell.dash-to-dock unblur-in-overview false
org.gnome.desktop.interface icon-theme 'KwickOS'
org.gnome.desktop.interface clock-format '12h'
org.gnome.desktop.interface clock-show-date true
org.gnome.desktop.interface clock-show-weekday true
org.gnome.desktop.interface clock-show-seconds false
org.gnome.TextEditor style-scheme 'kwick-macos'
