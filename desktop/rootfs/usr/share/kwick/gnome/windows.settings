org.gnome.desktop.interface accent-color 'blue'
org.gnome.desktop.wm.preferences button-layout ':minimize,maximize,close'
org.gnome.desktop.background picture-uri 'file:///usr/share/wallpapers/KwickFluent/contents/images/2560x1440.png'
org.gnome.desktop.background picture-uri-dark 'file:///usr/share/wallpapers/KwickFluent/contents/images/2560x1440.png'
org.gnome.desktop.screensaver picture-uri 'file:///usr/share/wallpapers/KwickFluent/contents/images/2560x1440.png'
org.gnome.shell enabled-extensions ['dash-to-panel@jderose9.github.com','ubuntu-appindicators@ubuntu.com','kwick-taskbar@kwickos.org']
org.gnome.shell favorite-apps ['org.gnome.Nautilus.desktop','firefox-esr.desktop','kwick-terminal.desktop','org.gnome.TextEditor.desktop','kwick-store.desktop','steam.desktop','kwick-settings.desktop']
org.gnome.shell.extensions.dash-to-panel panel-positions '{"0":"BOTTOM"}'
org.gnome.shell.extensions.dash-to-panel panel-sizes '{"0":48}'
org.gnome.shell.extensions.dash-to-panel panel-element-positions '{"0":[{"element":"showAppsButton","visible":true,"position":"centered"},{"element":"activitiesButton","visible":false,"position":"stackedTL"},{"element":"leftBox","visible":true,"position":"centered"},{"element":"taskbar","visible":true,"position":"centered"},{"element":"centerBox","visible":false,"position":"stackedBR"},{"element":"rightBox","visible":true,"position":"stackedBR"},{"element":"systemMenu","visible":true,"position":"stackedBR"},{"element":"dateMenu","visible":true,"position":"stackedBR"},{"element":"desktopButton","visible":false,"position":"stackedBR"}]}'
org.gnome.shell.extensions.dash-to-panel appicon-margin 2
org.gnome.shell.extensions.dash-to-panel appicon-padding 10
org.gnome.shell.extensions.dash-to-panel dot-position 'BOTTOM'
org.gnome.shell.extensions.dash-to-panel dot-style-focused 'METRO'
org.gnome.shell.extensions.dash-to-panel dot-style-unfocused 'DOTS'
org.gnome.shell.extensions.dash-to-panel trans-use-custom-bg true
org.gnome.shell.extensions.dash-to-panel trans-use-custom-opacity true
org.gnome.shell.extensions.dash-to-panel show-favorites true
org.gnome.shell.extensions.dash-to-panel group-apps true
org.gnome.shell.extensions.dash-to-panel isolate-workspaces false
org.gnome.shell.extensions.dash-to-panel intellihide false
org.gnome.desktop.interface icon-theme 'KwickOS-Fluent'
org.gnome.shell.extensions.dash-to-panel show-apps-icon-file '/usr/share/icons/KwickOS-Fluent/scalable/apps/kwick-start-fluent.svg'
org.gnome.shell.extensions.dash-to-panel dot-color-dominant false
org.gnome.shell.extensions.dash-to-panel dot-color-override true
org.gnome.shell.extensions.dash-to-panel dot-color-unfocused-different true
org.gnome.TextEditor style-scheme 'kwick-windows'
org.gnome.shell.extensions.dash-to-panel highlight-appicon-hover true
org.gnome.shell.extensions.dash-to-panel highlight-appicon-hover-border-radius 4
org.gnome.shell.extensions.dash-to-panel hide-overview-on-startup true
