org.gnome.desktop.interface icon-theme 'KwickOS'
org.gnome.desktop.interface cursor-theme 'breeze_cursors'
org.gnome.desktop.interface cursor-size 24
org.gnome.desktop.interface enable-hot-corners false
org.gnome.desktop.interface clock-show-weekday true
org.gnome.desktop.interface show-battery-percentage true
org.gnome.desktop.background picture-options 'zoom'
org.gnome.desktop.screensaver picture-options 'zoom'
org.gnome.desktop.wm.preferences focus-mode 'click'
org.gnome.mutter edge-tiling true
org.gnome.mutter dynamic-workspaces true
org.gnome.mutter auto-maximize false
org.gnome.mutter center-new-windows true
org.gnome.settings-daemon.plugins.color night-light-enabled false
org.gnome.shell.extensions.dash-to-dock show-trash false
org.gnome.shell.extensions.dash-to-dock show-mounts false
org.gnome.shell.extensions.dash-to-dock multi-monitor false
org.gnome.shell.extensions.dash-to-dock hot-keys false
org.gnome.shell.extensions.dash-to-dock isolate-workspaces false
org.gnome.desktop.interface clock-format '24h'
org.gnome.desktop.wm.keybindings switch-input-source ['XF86Keyboard']
org.gnome.desktop.wm.keybindings switch-input-source-backward ['<Shift>XF86Keyboard']
org.gnome.shell.keybindings toggle-overview ['<Super>w']
