org.gnome.desktop.interface accent-color 'purple'
org.gnome.desktop.wm.preferences button-layout 'appmenu:minimize,maximize,close'
org.gnome.desktop.background picture-uri 'file:///usr/share/wallpapers/KwickOS/contents/images/2560x1440.png'
org.gnome.desktop.background picture-uri-dark 'file:///usr/share/wallpapers/KwickOS/contents/images/2560x1440.png'
org.gnome.desktop.screensaver picture-uri 'file:///usr/share/wallpapers/KwickOS/contents/images/2560x1440.png'
org.gnome.shell enabled-extensions ['dash-to-dock@micxgx.gmail.com','ubuntu-appindicators@ubuntu.com']
org.gnome.shell favorite-apps ['org.gnome.Nautilus.desktop','firefox-esr.desktop','kwick-terminal.desktop','kwick-editor.desktop','org.gnome.Settings.desktop']
org.gnome.shell.extensions.dash-to-dock dock-position 'LEFT'
org.gnome.shell.extensions.dash-to-dock extend-height true
org.gnome.shell.extensions.dash-to-dock dock-fixed true
org.gnome.shell.extensions.dash-to-dock intellihide false
org.gnome.shell.extensions.dash-to-dock autohide false
org.gnome.shell.extensions.dash-to-dock dash-max-icon-size 40
org.gnome.shell.extensions.dash-to-dock transparency-mode 'FIXED'
org.gnome.shell.extensions.dash-to-dock custom-background-color true
org.gnome.shell.extensions.dash-to-dock background-color '#1d1d28'
org.gnome.shell.extensions.dash-to-dock background-opacity 0.9
org.gnome.shell.extensions.dash-to-dock apply-custom-theme false
org.gnome.shell.extensions.dash-to-dock custom-theme-shrink false
org.gnome.shell.extensions.dash-to-dock running-indicator-style 'DOTS'
org.gnome.shell.extensions.dash-to-dock show-apps-at-top true
org.gnome.shell.extensions.dash-to-dock click-action 'focus-or-previews'
