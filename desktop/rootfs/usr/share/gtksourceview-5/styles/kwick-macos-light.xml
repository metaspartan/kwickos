<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="kwick-macos-light" name="KwickOS macOS Light" version="1.0" parent-scheme="Adwaita">
  <author>KwickOS</author>
  <description>Adwaita on the macOS light text background</description>
  <metadata>
    <property name="variant">light</property>
    <property name="dark-variant">kwick-macos</property>
  </metadata>
  <style name="text" foreground="#000000" background="#ffffff"/>
  <style name="current-line" background="#f5f5f5"/>
  <style name="current-line-number" background="#f5f5f5"/>
  <style name="line-numbers" foreground="#a6a6a6" background="#ffffff"/>
  <style name="selection" background="#b3d7ff"/>
  <style name="cursor" foreground="#000000"/>
</style-scheme>
