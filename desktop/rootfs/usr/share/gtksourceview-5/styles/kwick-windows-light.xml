<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="kwick-windows-light" name="KwickOS Windows Light" version="1.0" parent-scheme="Adwaita">
  <author>KwickOS</author>
  <description>Adwaita on the Windows 11 light background</description>
  <metadata>
    <property name="variant">light</property>
    <property name="dark-variant">kwick-windows</property>
  </metadata>
  <style name="text" foreground="#1a1a1a" background="#fbfbfb"/>
  <style name="current-line" background="#f3f3f3"/>
  <style name="current-line-number" background="#f3f3f3"/>
  <style name="line-numbers" foreground="#868686" background="#fbfbfb"/>
  <style name="selection" foreground="#ffffff" background="#0078d4"/>
  <style name="cursor" foreground="#1a1a1a"/>
</style-scheme>
