[Desktop Entry]
Type=Application
Name=Files
GenericName=File Manager
Comment=Browse and organize files and folders
Icon=kwick-files
Exec=kwick-app files %U
Categories=System;FileTools;FileManager;
Keywords=files;folders;browse;explorer;finder;manager;
MimeType=inode/directory;
StartupNotify=true
Terminal=false
NotShowIn=KDE;GNOME;
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Icon=window-new
Exec=kwick-app files --new-window %U
