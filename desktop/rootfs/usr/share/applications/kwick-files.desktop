[Desktop Entry]
Type=Application
Name=Files
GenericName=File Manager
Comment=Browse and organize files and folders
Icon=kwick-files
Exec=dolphin %u
Categories=Qt;KDE;System;FileTools;FileManager;
Keywords=files;folders;browse;explorer;finder;manager;
MimeType=inode/directory;
StartupNotify=true
StartupWMClass=org.kde.dolphin
Terminal=false
NotShowIn=KDE;
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Icon=window-new
Exec=dolphin --new-window %u
