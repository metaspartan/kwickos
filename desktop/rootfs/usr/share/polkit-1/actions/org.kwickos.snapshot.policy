<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>KwickOS</vendor>
  <vendor_url>https://github.com/metaspartan/kwickos</vendor_url>
  <action id="org.kwickos.snapshot">
    <description>Manage system snapshots</description>
    <message>Snapshots wants to make changes. Authentication is required to restore files or the system, or to change snapshot settings.</message>
    <icon_name>kwick-snapshots</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/sbin/kwick-snapshot</annotate>
  </action>
</policyconfig>
