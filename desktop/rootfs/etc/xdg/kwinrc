# KwickOS defaults - change them in System Settings > Desktop Effects
[Plugins]
wobblywindowsEnabled=true
magiclampEnabled=true
squashEnabled=false
kwin6_effect_fireEnabled=true
scaleEnabled=false
blurEnabled=true
contrastEnabled=true
translucencyEnabled=true
dimscreenEnabled=true
shakecursorEnabled=true

[Effect-wobblywindows]
Drag=85
Stiffness=10
WobblynessLevel=1

[Effect-overview]
BorderActivate=9

[Windows]
BorderlessMaximizedWindows=false

[org.kde.kdecoration2]
ButtonsOnLeft=XIA
ButtonsOnRight=
library=org.kde.breeze
theme=Breeze

[Compositing]
LatencyPolicy=Low

[Wayland]
InputMethod[$e]=
