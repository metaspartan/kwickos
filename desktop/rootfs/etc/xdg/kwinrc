# KwickOS defaults (dark, glassy, smooth). Change them with kwick-effects or System Settings > Desktop Effects.
[Plugins]
blurEnabled=true
contrastEnabled=true
translucencyEnabled=true
fadeEnabled=true
fadingpopupsEnabled=true
slidingpopupsEnabled=true
maximizeEnabled=true
loginEnabled=true
logoutEnabled=true
sessionquitEnabled=true
dialogparentEnabled=true
magiclampEnabled=true
wobblywindowsEnabled=false
scaleEnabled=false
squashEnabled=false
dimscreenEnabled=true
shakecursorEnabled=true

[Effect-blur]
BlurStrength=8
NoiseStrength=3

[Effect-wobblywindows]
Drag=85
Stiffness=8
WobblynessLevel=1

[Effect-overview]
BorderActivate=9

[Windows]
BorderlessMaximizedWindows=false

[org.kde.kdecoration2]
library=org.kde.kwin.aurorae
theme=__aurorae__svg__KwickGlass
ButtonsOnLeft=XIA
ButtonsOnRight=

[Compositing]
LatencyPolicy=Medium

[Wayland]
InputMethod[$e]=