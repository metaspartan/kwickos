[Plugins]
blurEnabled=true
contrastEnabled=true
translucencyEnabled=true
fadeEnabled=false
fadingpopupsEnabled=true
slidingpopupsEnabled=true
maximizeEnabled=true
loginEnabled=true
logoutEnabled=true
sessionquitEnabled=true
dialogparentEnabled=true
magiclampEnabled=true
wobblywindowsEnabled=false
scaleEnabled=true
squashEnabled=false
dimscreenEnabled=true
shakecursorEnabled=true

[Effect-blur]
BlurStrength=8
NoiseStrength=3

[Effect-wobblywindows]
Drag=85
Stiffness=8
WobblynessLevel=1

[Effect-overview]
BorderActivate=9

[Round-Corners]
UseSquircleShape=false
Squircleness=0
AnimationDuration=250
MarkWindowsTranslucent=true
UseNativeDecorationShadows=true
ShadowSize=0
InactiveShadowSize=0
ActiveShadowAlpha=0
InactiveShadowAlpha=0
OutlineIsGradient=false
InactiveOutlineIsGradient=false
SecondOutlineIsGradient=false
InactiveSecondOutlineIsGradient=false
OuterOutlineThickness=0
InactiveOuterOutlineThickness=0
OuterOutlineIsGradient=false
InactiveOuterOutlineIsGradient=false
DisableRoundFullScreen=true
DisableOutlineFullScreen=true

[Windows]
BorderlessMaximizedWindows=false

[org.kde.kdecoration2]
BorderSize=None
BorderSizeAuto=false
library=org.kde.kwin.aurorae
theme=__aurorae__svg__KwickGlass
ButtonsOnLeft=XIA
ButtonsOnRight=

[Compositing]
LatencyPolicy=Medium

[Wayland]
InputMethod[$e]=/usr/share/applications/org.kde.plasma.keyboard.desktop
VirtualKeyboardEnabled=true

[Input]
TabletMode=auto
